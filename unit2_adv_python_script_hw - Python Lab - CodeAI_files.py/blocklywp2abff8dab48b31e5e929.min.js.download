ARITHMETIC_TOOLTIP_MULTIPLY="இரு எண்களின் பெருக்கலை பின்கொடு",e.Msg.MATH_ARITHMETIC_TOOLTIP_POWER="முதல் உள்ளீடு இரண்டாவது எண் அளவான அடுக்கு பெருக்கை கணித்து பின்கொடு.",e.Msg.MATH_ATAN2_HELPURL="https://en.wikipedia.org/wiki/Atan2",e.Msg.MATH_ATAN2_TITLE="atan2 of X:%1 Y:%2",e.Msg.MATH_ATAN2_TOOLTIP="Return the arctangent of point (X, Y) in degrees from -180 to 180.",e.Msg.MATH_CHANGE_HELPURL="https://en.wikipedia.org/wiki/Programming_idiom#Incrementing_a_counter",e.Msg.MATH_CHANGE_TITLE="மாற்று %1 மூலம் %2",e.Msg.MATH_CHANGE_TOOLTIP="எண்னை '%1' மதிப்பால் கூட்டு,",e.Msg.MATH_CONSTANT_E_ARIA="e",e.Msg.MATH_CONSTANT_GOLDEN_RATIO_ARIA="golden ratio",e.Msg.MATH_CONSTANT_HELPURL="https://ta.wikipedia.org/wiki/%E0%AE%95%E0%AE%A3%E0%AE%BF%E0%AE%A4_%E0%AE%AE%E0%AE%BE%E0%AE%B1%E0%AE%BF%E0%AE%B2%E0%AE%BF",e.Msg.MATH_CONSTANT_INFINITY_ARIA="infinity",e.Msg.MATH_CONSTANT_PI_ARIA="pi",e.Msg.MATH_CONSTANT_SQRT1_2_ARIA="square root of 1 over 2",e.Msg.MATH_CONSTANT_SQRT2_ARIA="square root of 2",e.Msg.MATH_CONSTANT_TOOLTIP="ஒரு மாறிலியை பின்கொடு π (3.141…), e (2.718…), φ (1.618…), sqrt(2) (1.414…), sqrt(½) (0.707…), or ∞ (முடிவிலி).",e.Msg.MATH_CONSTRAIN_HELPURL="https://en.wikipedia.org/wiki/Clamping_(graphics)",e.Msg.MATH_CONSTRAIN_TITLE="%1 மாறியை %2 மேலும் %3 கீழும் வற்புறுத்து",e.Msg.MATH_CONSTRAIN_TOOLTIP="எண் மாறி வீசுகளம் உள்ளடங்கிய வாறு வற்புறுத்து",e.Msg.MATH_DIVISION_SYMBOL="÷",e.Msg.MATH_DIVISION_SYMBOL_ARIA="divided by",e.Msg.MATH_IS_DIVISIBLE_BY="ஆல் வகுபடக் கூடியது",e.Msg.MATH_IS_EVEN="2-ஆல் பகும்",e.Msg.MATH_IS_NEGATIVE="எண் குறைவானதா ?",e.Msg.MATH_IS_ODD="2-ஆல் பகாத",e.Msg.MATH_IS_POSITIVE="எண் நேர்ம முழுதானதா ?",e.Msg.MATH_IS_PRIME="எண் பகாத்தனிதானதா?",e.Msg.MATH_IS_TOOLTIP="ஒரு எண் இரட்டைப்படை, ஒற்றைப்படை, பகா எண், முழு எண், நேர்மறை எண், எதிர்மறை எண் அல்லது குறிப்பிட்ட எண்ணால் வகுபடும் எண் என்பதைச் சரிபார்க்கவும். உண்மையா அல்லது பொய்யா என்பதைத் திருப்பி அனுப்பும்.",e.Msg.MATH_IS_WHOLE="எண் முழுதானதா?",e.Msg.MATH_MODULO_HELPURL="https://en.wikipedia.org/wiki/Modulo