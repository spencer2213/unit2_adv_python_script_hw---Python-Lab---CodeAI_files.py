ity",e.Msg.MATH_CONSTANT_PI_ARIA="pi",e.Msg.MATH_CONSTANT_SQRT1_2_ARIA="square root of 1 over 2",e.Msg.MATH_CONSTANT_SQRT2_ARIA="square root of 2",e.Msg.MATH_CONSTANT_TOOLTIP="Restituisce una delle costanti comuniː π (3.141…), e (2.718…), φ (1.618…), radq(2) (1.414…), radq(½) (0.707…) o ∞ (infinito).",e.Msg.MATH_CONSTRAIN_HELPURL="https://en.wikipedia.org/wiki/Clamping_(graphics)",e.Msg.MATH_CONSTRAIN_TITLE="costringi %1 da %2 a %3",e.Msg.MATH_CONSTRAIN_TOOLTIP="Costringe un numero all'interno dei limiti indicati (compresi).",e.Msg.MATH_DIVISION_SYMBOL="÷",e.Msg.MATH_DIVISION_SYMBOL_ARIA="divided by",e.Msg.MATH_IS_DIVISIBLE_BY="è divisibile per",e.Msg.MATH_IS_EVEN="è pari",e.Msg.MATH_IS_NEGATIVE="è negativo",e.Msg.MATH_IS_ODD="è dispari",e.Msg.MATH_IS_POSITIVE="è positivo",e.Msg.MATH_IS_PRIME="è primo",e.Msg.MATH_IS_TOOLTIP="Verifica se un numero è pari, dispari, primo, intero, positivo, negativo o se è divisibile per un certo numero. Restituisce vero o falso.",e.Msg.MATH_IS_WHOLE="è intero",e.Msg.MATH_MODULO_HELPURL="https://it.wikipedia.org/wiki/Resto",e.Msg.MATH_MODULO_TITLE="resto di %1 ÷ %2",e.Msg.MATH_MODULO_TOOLTIP="Restituisce il resto della divisione di due numeri.",e.Msg.MATH_MULTIPLICATION_SYMBOL="×",e.Msg.MATH_MULTIPLICATION_SYMBOL_ARIA="times",e.Msg.MATH_NUMBER_HELPURL="https://it.wikipedia.org/wiki/Numero",e.Msg.MATH_NUMBER_TOOLTIP="Un numero.",e.Msg.MATH_ONLIST_HELPURL="",e.Msg.MATH_ONLIST_OPERATOR_AVERAGE="media della lista",e.Msg.MATH_ONLIST_OPERATOR_MAX="massimo della lista",e.Msg.MATH_ONLIST_OPERATOR_MAX_ARIA="maximum",e.Msg.MATH_ONLIST_OPERATOR_MEDIAN="mediana della lista",e.Msg.MATH_ONLIST_OPERATOR_MIN="minimo della lista",e.Msg.MATH_ONLIST_OPERATOR_MIN_ARIA="minimum",e.Msg.MATH_ONLIST_OPERATOR_MODE="mode della lista",e.Msg.MATH_ONLIST_OPERATOR_RANDOM="elemento casuale della lista",e.Msg.MATH_ONLIST_OPERATOR_STD_DEV="deviazione standard della lista",e.Msg.MATH_ONLIST_OPERATOR_SUM="somma la lista",e.Msg.MATH_ONLIST_TOOLTIP_AVERAGE="Restituisce la