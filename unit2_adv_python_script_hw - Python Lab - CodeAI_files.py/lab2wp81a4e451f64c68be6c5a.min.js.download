AiT5H7fHCnGnwW{display:flex;align-items:center;justify-content:center;width:100%;height:100%;position:fixed;top:50px;left:0;right:0;bottom:0;pointer-events:none;opacity:0;z-index:72;background-color:var(--background-neutral-lab)}.dlao6CAiT5H7fHCnGnwW.SfUBqviL1Rz6g6gL8cvb{position:absolute;top:0}.dlao6CAiT5H7fHCnGnwW.c8Uovtg95KorB1llzfgg{opacity:0;pointer-events:initial}.dlao6CAiT5H7fHCnGnwW.C6pnMU8SpjbpZJrHG_l1{opacity:0}.dlao6CAiT5H7fHCnGnwW.e70JpxHhRhUvtVX5C1n8{opacity:1;pointer-events:initial}.dlao6CAiT5H7fHCnGnwW.lp0hHnsVPSP9YpnsnFrK{animation:I8DDcTE3anJ2DdF9CzWC .5s}.dlao6CAiT5H7fHCnGnwW .vyNNlWCqQS0qhNtS6KRd{display:flex;flex-direction:column;align-items:center;gap:20px}.dlao6CAiT5H7fHCnGnwW .vyNNlWCqQS0qhNtS6KRd .U1Ahe7bpTsRUReDgfd3A{color:#abb0b6;animation:smCqNoAchtuZdzZmWIFB 3s}.dlao6CAiT5H7fHCnGnwW .vyNNlWCqQS0qhNtS6KRd .xv71QOJq3FbUcNAfN_tD{color:#858c94;animation:ZdfoJ0d0wJ9taP1hey5a 11s}.gy9JyutjCjC_eHVFAGAD{top:0}","",{version:3,sources:["webpack://./src/lab2/views/loading.module.scss","webpack://./src/lab2/views/common.scss","webpack://./src/lab2/views/components/layout/variables.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAMA,gCACE,GACE,SAAA,CAEF,KACE,SAAA,CAAA,CAKJ,gCACE,GACE,SAAA,CAEF,IACE,SAAA,CAEF,KACE,SAAA,CAAA,CAKJ,gCACE,GACE,SAAA,CAEF,IACE,SAAA,CAEF,KACE,SAAA,CAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,WAAA,CACA,cAAA,CACA,QC/BY,CDgCZ,MAAA,CACA,OAAA,CACA,QAAA,CACA,mBAAA,CACA,SAAA,CACA,UEtCgB,CFuChB,8CAAA,CAIA,2CACE,iBAAA,CACA,KAAA,CAGF,2CACE,SAAA,CACA,sBAAA,CAGF,2CACE,SAAA,CAGF,2CACE,SAAA,CACA,sBAAA,CAGF,2CACE,kCAAA,CAGF,4CACE,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,QAAA,CAEA,kEACE,aGsFW,CHrFX,iCAAA,CAGF,kEACE,aGmFW,CHlFX,kCAAA,CAMN,sBACE,KAAA",sourcesContent:["@use './components/layout/variables.scss' as variables;\n@import 'color.scss';\n@import './common.scss';\n\n// We actually fade out the block to reveal the lab underneath.\n// We will do it over 1s, and then leave it invisible.\n@keyframes fade-out-block {\n  0% {\n    opacity: 1;\n  }\n  100% {\n    opacity: 0;\n  }\n}\n\n// We will fade in the spinner container for 1s after a 2s delay, then leave it showing.\n@keyframes fade-in-spinner-container {\n  0% {\n    opacity: 0;\n  }\n  66% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n// We will fade in the spinner text for 1s after a 10s delay, then leave it showing.\n@keyframes fade-in-spinner-text {\n  0% {\n    opacity: 0;\n  }\n  91% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n.solidBlock {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  position: fixed;\n  top: $top-spacing;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  opacity: 0;\n  z-index: variables.$z-index-overlay;\n  background-color: var(--background-neutral-lab);\n\n  // Bounded to the lab's own box instead of the viewport; the box already\n  // starts below the header, so the top offset above does not apply.\n  &.boundedBlock {\n    position: absolute;\n    top: 0;\n  }\n\n  &.noFadeLoading {\n    opacity: 0;\n    pointer-events: initial;\n  }\n\n  &.noFadeLoaded {\n    opacity: 0;\n  }\n\n  &.fadeLoading {\n    opacity: 1;\n    pointer-events: initial;\n  }\n\n  &.fadeLoaded {\n    animation: fade-out-block 0.5s;\n  }\n\n  .slowLoadContainer {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 20px;\n\n    .spinnerContainer {\n      color: $neutral_dark40;\n      animation: fade-in-spinner-container 3s;\n    }\n\n    .spinnerText {\n      color: $neutral_dark60;\n      animation: fade-in-spinner-text 11s;\n    }\n  }\n}\n\n// In share view, there is no header so we want the overlay to be at the top of the screen.\n.shareViewOverlay {\n  top: 0;\n}\n","@import 'color.scss';\n\n// A translucent overlay that covers the entire container.\n%full-container-overlay {\n  background-color: rgba(0 0 0 / 0.5);\n  color: $neutral_dark;\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  top: 0;\n  left: 0;\n  z-index: 80;\n}\n\n$top-spacing: 50px;\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),i.locals={solidBlock:"dlao6CAiT5H7fHCnGnwW",boundedBlock:"SfUBqviL1Rz6g6gL8cvb",noFadeLoading:"c8Uovtg95KorB1llzfgg",noFadeLoaded:"C6pnMU8SpjbpZJrHG_l1",fadeLoading:"e70JpxHhRhUvtVX5C1n8",fadeLoaded:"lp0hHnsVPSP9YpnsnFrK","fade-out-block":"I8DDcTE3anJ2DdF9CzWC",slowLoadContainer:"vyNNlWCqQS0qhNtS6KRd",spinnerContainer:"U1Ahe7bpTsRUReDgfd3A","fade-in-spinner-container":"smCqNoAchtuZdzZmWIFB",spinnerText:"xv71QOJq3FbUcNAfN_tD","fade-in-spinner-text":"ZdfoJ0d0wJ9taP1hey5a",shareViewOverlay:"gy9JyutjCjC_eHVFAGAD"};const l=i},5805:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".introjs-helperLayer{box-shadow:var(--neutral-black-alpha-50) 0 0 0 5000px !important}.introjs-arrow{border-width:10px}.introjs-arrow.top,.introjs-arrow.top-right,.introjs-arrow.top-middle{top:-18px}.introjs-arrow.right{right:-18px}.introjs-arrow.right-bottom{bottom:18px}.introjs-arrow.bottom,.introjs-arrow.bottom-right,.introjs-arrow.bottom-middle{bottom:-18px}.introjs-arrow.left,.introjs-arrow.left-bottom{left:-18px}.introjs-tooltip{width:400px;max-width:400px;border:1px solid var(--background-neutral-primary);box-shadow:0 3px 30px var(--background-neutral-black-fixed)}.introjs-tooltiptext{padding:0 24px}.introjs-tooltiptext p{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;font-size:.75rem}.introjs-tooltip-title{font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);color:var(--text-neutral-primary);font-size:1rem}.introjs-tooltip-header{padding:24px 24px 0}.introjs-tooltipbuttons{padding:10px 24px}.introjs-button{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;padding:8px 16px 6px;font-size:.75rem;text-shadow:none;border-radius:4px}.introjs-button:focus{box-shadow:0 0 0 .2rem var(--text-neutral-tertiary)}.introjs-prevbutton{color:var(--text-brand-purple-primary);border:1px solid var(--borders-brand-purple-primary);background-color:var(--background-neutral-primary)}.introjs-prevbutton:hover,.introjs-prevbutton:active,.introjs-prevbutton:focus,.introjs-prevbutton:visited{color:var(--text-neutral-white-fixed);background-color:var(--background-brand-purple-light);text-decoration:none;box-shadow:none}.introjs-nextbutton{color:var(--text-neutral-white-fixed);border:none;background-color:var(--background-brand-purple-primary)}.introjs-nextbutton:hover,.introjs-nextbutton:active,.introjs-nextbutton:focus,.introjs-nextbutton:visited{color:var(--text-neutral-white-fixed);background-color:var(--background-brand-purple-strong);text-decoration:none;border:none;box-shadow:none}","",{version:3,sources:["webpack://./src/templates/rubrics/introjsOverrides.scss","webpack://./../frontend/packages/component-library-styles/font.scss"],names:[],mappings:"AASA,qBACE,gEAAA,CAIF,eACE,iBAAA,CAEF,sEAGE,SAAA,CAEF,qBACE,WAAA,CAEF,4BACE,WAAA,CAEF,+EAGE,YAAA,CAEF,+CAEE,UAAA,CAIF,iBACE,WAAA,CACA,eAAA,CACA,kDAAA,CACA,2DAAA,CAEF,qBACE,cAAA,CAEA,uBCLA,mCAAA,CACA,sCAAA,CACA,iBAAA,CDKE,gBAAA,CAGJ,uBACE,mCAAA,CACA,wCAAA,CACA,iCAAA,CACA,cAAA,CAEF,wBACE,mBAAA,CAEF,wBACE,iBAAA,CAIF,gBCxBE,mCAAA,CACA,sCAAA,CACA,iBAAA,CDwBA,oBAAA,CACA,gBAAA,CACA,gBAAA,CACA,iBAAA,CAEF,sBACE,mDAAA,CAIF,oBACE,sCAAA,CACA,oDAAA,CACA,kDAAA,CAEA,2GAIE,qCAAA,CACA,qDAAA,CACA,oBAAA,CACA,eAAA,CAKJ,oBACE,qCAAA,CACA,WAAA,CACA,uDAAA,CAEA,2GAIE,qCAAA,CACA,sDAAA,CACA,oBAAA,CACA,WAAA,CACA,eAAA",sourcesContent:["// code.org theme overrides for intro.js product tours.\n// Base styles ship with the library and are imported separately\n// ('intro.js/introjs.css' in RubricContainer.jsx). Only the deltas from those\n// defaults live here. Selectors mirror the library's, so this file must load\n// after the base stylesheet to win on equal specificity.\n\n@import '@code-dot-org/component-library-styles/font';\n\n// Spotlight: dim the page around the highlighted element.\n.introjs-helperLayer {\n  box-shadow: var(--neutral-black-alpha-50) 0 0 0 5000px !important;\n}\n\n// Larger tooltip arrows, repositioned to sit clear of the wider border.\n.introjs-arrow {\n  border-width: 10px;\n}\n.introjs-arrow.top,\n.introjs-arrow.top-right,\n.introjs-arrow.top-middle {\n  top: -18px;\n}\n.introjs-arrow.right {\n  right: -18px;\n}\n.introjs-arrow.right-bottom {\n  bottom: 18px;\n}\n.introjs-arrow.bottom,\n.introjs-arrow.bottom-right,\n.introjs-arrow.bottom-middle {\n  bottom: -18px;\n}\n.introjs-arrow.left,\n.introjs-arrow.left-bottom {\n  left: -18px;\n}\n\n// Wider tooltip with a code.org surface and shadow.\n.introjs-tooltip {\n  width: 400px;\n  max-width: 400px;\n  border: 1px solid var(--background-neutral-primary);\n  box-shadow: 0 3px 30px var(--background-neutral-black-fixed);\n}\n.introjs-tooltiptext {\n  padding: 0 24px;\n\n  p {\n    @include main-font-regular;\n    font-size: 0.75rem;\n  }\n}\n.introjs-tooltip-title {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-primary);\n  font-size: 1rem;\n}\n.introjs-tooltip-header {\n  padding: 24px 24px 0;\n}\n.introjs-tooltipbuttons {\n  padding: 10px 24px;\n}\n\n// Buttons: code.org typography and shape.\n.introjs-button {\n  @include main-font-regular;\n  padding: 8px 16px 6px;\n  font-size: 0.75rem;\n  text-shadow: none;\n  border-radius: 4px;\n}\n.introjs-button:focus {\n  box-shadow: 0 0 0 0.2rem var(--text-neutral-tertiary);\n}\n\n// Previous: outlined purple.\n.introjs-prevbutton {\n  color: var(--text-brand-purple-primary);\n  border: 1px solid var(--borders-brand-purple-primary);\n  background-color: var(--background-neutral-primary);\n\n  &:hover,\n  &:active,\n  &:focus,\n  &:visited {\n    color: var(--text-neutral-white-fixed);\n    background-color: var(--background-brand-purple-light);\n    text-decoration: none;\n    box-shadow: none;\n  }\n}\n\n// Next: filled purple.\n.introjs-nextbutton {\n  color: var(--text-neutral-white-fixed);\n  border: none;\n  background-color: var(--background-brand-purple-primary);\n\n  &:hover,\n  &:active,\n  &:focus,\n  &:visited {\n    color: var(--text-neutral-white-fixed);\n    background-color: var(--background-brand-purple-strong);\n    text-decoration: none;\n    border: none;\n    box-shadow: none;\n  }\n}\n","// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n"],sourceRoot:""}]);const l=i},5159:(e,t,n)=>{"use strict";
