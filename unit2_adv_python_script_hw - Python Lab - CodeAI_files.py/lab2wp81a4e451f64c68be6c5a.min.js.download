ottom: 16px;\n  // Keep each category table whole rather than splitting across columns.\n  break-inside: avoid;\n}\n\n.categoryHeading {\n  text-align: start;\n}\n\n.shortcutKeys {\n  // Shrink the key column to its content so the description gets the rest.\n  width: 1%;\n  white-space: nowrap;\n  text-align: start;\n  vertical-align: top;\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font-weight: normal;\n  border: 1px solid var(--borders-neutral-primary);\n  padding: 6px 8px;\n\n  kbd {\n    display: inline-block;\n    padding: 2px 4px;\n    background: var(--background-neutral-tertiary);\n    color: var(--text-neutral-secondary);\n    border-radius: 4px;\n    font-family: monospace;\n    font-size: 12px;\n    white-space: nowrap;\n  }\n}\n\n.shortcutExplanation {\n  vertical-align: top;\n  color: var(--text-neutral-primary);\n  border: 1px solid var(--borders-neutral-primary);\n  padding: 6px 8px;\n}\n"],sourceRoot:""}]),i.locals={multiColumn:"tq9uQzw9DnRCX0_0dtpT",shortcutTable:"HnR1BMLMBatdwVX1WWkF",categoryHeading:"JzSGRTELau3gG3CqCe8V",shortcutKeys:"VR6XciAqqs_tuuRgO63k",shortcutExplanation:"HauCgFmqn7PLUA5zQJCc"};const l=i},7692:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".ZVy_dEEPhf5iBBE5xXgv{position:fixed;top:8px;right:8px;z-index:9999;display:flex;flex-direction:column;gap:4px;width:140px;padding:8px 10px;background-color:var(--background-neutral-primary);color:var(--text-neutral-primary);border:1px solid var(--background-neutral-quaternary);border-radius:4px;pointer-events:none;user-select:none;white-space:nowrap}.bDRFzF4Wvz2kDRlnNDW5{pointer-events:auto;margin-bottom:2px}","",{version:3,sources:["webpack://./src/lab2/views/ScreenAnalyticsOverlay.module.scss"],names:[],mappings:"AAAA,sBACE,cAAA,CACA,OAAA,CACA,SAAA,CACA,YAAA,CACA,YAAA,CACA,qBAAA,CACA,OAAA,CACA,WAAA,CACA,gBAAA,CACA,kDAAA,CACA,iCAAA,CACA,qDAAA,CACA,iBAAA,CACA,mBAAA,CACA,gBAAA,CACA,kBAAA,CAGF,sBACE,mBAAA,CACA,iBA