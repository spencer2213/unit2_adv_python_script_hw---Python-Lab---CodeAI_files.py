:.75rem}.DUF1Ss2XJiS3pEQlXqt4{height:2.5rem}.h0xQ37XKADxt4hQjL7bN select{width:160px}.iIWoBh7WIk7j1KM15IYZ{text-align:center}","",{version:3,sources:["webpack://./src/templates/sign-in-or-age-dialog.module.scss"],names:[],mappings:"AAIA,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CAEA,eAAA,CACA,eAAA,CACA,mBAAA,CAEA,mBAAA,CACA,sCAAA,CACA,aAAA,CAEA,yBACE,UAAA,CACA,eAAA,CACA,QAAA,CACA,QAAA,CACA,aAAA,CACA,yCAAA,CAGF,iDAEE,QAAA,CACA,iCAAA,CAIJ,sBACE,YAAA,CACA,kCAAA,CACA,kBAAA,CACA,WAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,UAAA,CAGF,sBACE,cAAA,CACA,MAAA,CACA,yCAAA,CAGF,sBACE,YAAA,CACA,oBAAA,CACA,UAAA,CAMF,sBACE,aAAA,CAIF,6BACE,WAAA,CAIF,sBACE,iBAAA",sourcesContent:["/* Built on CustomDialog rather than Modal because Modal fixes its content into\n   a single column, and this dialog's two columns are the design. The box rules\n   below mirror the design system's modal.module.scss so it still looks like one\n   of the family. */\n.dialog {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n\n  min-width: 600px;\n  max-width: 800px;\n  padding: 1.5rem 2rem;\n\n  border-radius: 0.5rem;\n  box-shadow: 0 6px 18px 0 rgb(0 0 0 / 0.3);\n  overflow: auto;\n\n  hr {\n    width: 100%;\n    height: 0.0625rem;\n    margin: 0;\n    border: 0;\n    flex-shrink: 0;\n    background: var(--borders-neutral-primary);\n  }\n\n  h3,\n  p {\n    margin: 0;\n    color: var(--text-neutral-primary);\n  }\n}\n\n.columns {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-self: stretch;\n  gap: 1.25rem;\n}\n\n.column {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n}\n\n.orDivider {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.orLine {\n  width: 0.0625rem;\n  flex: 1;\n  background: var(--borders-neutral-primary);\n}\n\n.ageRow {\n  display: flex;\n  align-items: flex-end;\n  gap: 0.75rem;\n}\n\n/* SimpleDropdown is a fixed 2.5rem; a medium button lands ~2px taller. */\n\n/* A class, not a `button` selector: MUI renders the sign-in href as an anchor. */\n.action {\n  height: 2.5rem;\n}\n\n/* On the select, so SimpleDropdown's arrow stays at its right edge. */\n.ageDropdown select {\n  width: 160px;\n}\n\n/* Dialog leaves its text start-aligned but centres its button. */\n.tooYoungDialog {\n  text-align: center;\n}\n"],sourceRoot:""}]),i.locals={dialog:"UqoZlxFZBC6Dcu0aCBqf",columns:"ZPNWeV5rwEjXG7gQmZo3",column:"y9fdJ4JYedzDvehBiFvO",orDivider:"JmAouqg9obfN0TEQUhBw",orLine:"puCt_OHQi10lYbDxm7YQ",ageRow:"l5j6vFybhFxeMANI6TWb",action:"DUF1Ss2XJiS3pEQlXqt4",ageDropdown:"h0xQ37XKADxt4hQjL7bN",tooYoungDialog:"iIWoBh7WIk7j1KM15IYZ"};const l=i},5810:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".VL0kO7hsa9VqMvL6M4Lu{width:100%;position:relative;box-sizing:border-box}.if_5lorUd6x1xkqUMNOC{background:#f7f8fa;border:1px solid #d1d4d8;border-radius:4px;overflow:hidden;display:flex}@media screen and (max-width: 993px){.if_5lorUd6x1xkqUMNOC{flex-wrap:wrap}}.if_5lorUd6x1xkqUMNOC .tDmeTCgunZRymLuomvyj{margin:1.25rem;width:calc(50% - 1.25rem)}@media(max-width: 993px){.if_5lorUd6x1xkqUMNOC .tDmeTCgunZRymLuomvyj{display:none}}.if_5lorUd6x1xkqUMNOC .D5WVNzNrwdqlhd5rmZB5{width:calc(50% + 1.5rem);padding-block:1.25rem 1.5rem;padding-inline:0 1.5rem}@media screen and (max-width: 993px){.if_5lorUd6x1xkqUMNOC .D5WVNzNrwdqlhd5rmZB5{width:100%;padding:1.25rem 1.5rem}}.if_5lorUd6x1xkqUMNOC .iXiaVriR4iqyFdX1v35w{display:flex;flex-wrap:wrap;gap:1.25rem}.if_5lorUd6x1xkqUMNOC .eLvCFIs16ovGQDaVGR2M{flex-direction:column}","",{version:3,sources:["webpack://./src/templates/studioHomepages/twoColumnActionBlock.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAIA,sBACE,UAAA,CACA,iBAAA,CACA,qBAAA,CAGF,sBACE,kBC6Lc,CD5Ld,wBAAA,CACA,iBAAA,CACA,eAAA,CACA,YAAA,CAEA,qCAPF,sBAQI,cAAA,CAAA,CAGF,4CACE,cAAA,CACA,yBAAA,CAEA,yBAJF,4CAKI,YAAA,CAAA,CAIJ,4CACE,wBAAA,CACA,4BAAA,CACA,uBAAA,CAEA,qCALF,4CAMI,UAAA,CACA,sBAAA,CAAA,CAIJ,4CACE,YAAA,CACA,cAAA,CACA,WAAA,CAEA,4CACE,qBAAA",sourcesContent:["@import 'color';\n\n$breakpoint: 993px;\n\n.container {\n  width: 100%;\n  position: relative;\n  box-sizing: border-box;\n}\n\n.actionBlockWrapper {\n  background: $light_gray_50;\n  border: 1px solid $light_gray_200;\n  border-radius: 4px;\n  overflow: hidden;\n  display: flex;\n\n  @media screen and (max-width: $breakpoint) {\n    flex-wrap: wrap;\n  }\n\n  .image {\n    margin: 1.25rem;\n    width: calc(50% - 1.25rem);\n\n    @media (max-width: $breakpoint) {\n      display: none;\n    }\n  }\n\n  .contentWrapper {\n    width: calc(50% + 1.5rem);\n    padding-block: 1.25rem 1.5rem;\n    padding-inline: 0 1.5rem;\n\n    @media screen and (max-width: $breakpoint) {\n      width: 100%;\n      padding: 1.25rem 1.5rem;\n    }\n  }\n\n  .buttonsContainer {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1.25rem;\n\n    &VerticalButtons {\n      flex-direction: column;\n    }\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),i.locals={container:"VL0kO7hsa9VqMvL6M4Lu",actionBlockWrapper:"if_5lorUd6x1xkqUMNOC",image:"tDmeTCgunZRymLuomvyj",contentWrapper:"D5WVNzNrwdqlhd5rmZB5",buttonsContainer:"iXiaVriR4iqyFdX1v35w",buttonsContainerVerticalButtons:"eLvCFIs16ovGQDaVGR2M"};const l=i},2857:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".t1HqLV86KcOw3PnGtMs7{padding-right:16px;height:52px}.EE4v3EROCVULJFhTauFQ{padding-left:var(--spacing-p-xs)}.Xv0Me6q72q1TzMiSx88m{width:100%}.YxkIUVY_T61bhtCFysUy{width:100%;max-height:330px;overflow-y:auto;margin:1em 0;scrollbar-color:var(--background-neutral-quinary) var(--background-neutral-primary)}.YxkIUVY_T61bhtCFysUy::-webkit-scrollbar{width:10px}.YxkIUVY_T61bhtCFysUy::-webkit-scrollbar-track{background:var(--background-neutral-primary)}.YxkIUVY_T61bhtCFysUy::-webkit-scrollbar-thumb{background-color:var(--background-neutral-quinary);border-radius:5px;border:2px solid var(--background-neutral-primary)}.NLDlUAFTv6KVfu9Z5tq8{background-color:var(--background-neutral-primary) !important;border-color:var(--borders-neutral-solid) !important;color:var(--text-neutral-primary) !important}.NLDlUAFTv6KVfu9Z5tq8:hover,.NLDlUAFTv6KVfu9Z5tq8:focus,.NLDlUAFTv6KVfu9Z5tq8:active{background-color:var(--background-neutral-tertiary) !important;border-color:var(--borders-neutral-solid) !important;color:var(--text-neutral-primary) !important}.kIZiJUhDlqq8B0RZQHD9:hover,.kIZiJUhDlqq8B0RZQHD9:focus,.kIZiJUhDlqq8B0RZQHD9:active{background-color:var(--background-brand-purple-strong) !important;color:var(--text-neutral-white-fixed) !important;text-decoration:none !important}","",{version:3,sources:["webpack://./src/templates/versionHistory.module.scss"],names:[],mappings:"AACA,sBACE,kBAAA,CACA,WAAA,CAIF,sBACE,gCAAA,CAMF,sBACE,UAAA,CAGF,sBACE,UAAA,CACA,gBAAA,CACA,eAAA,CACA,YAAA,CACA,mFAAA,CAGA,yCACE,UAAA,CAGF,+CACE,4CAAA,CAGF,+CACE,kDAAA,CACA,iBAAA,CACA,kDAAA,CAKJ,sBACE,6DAAA,CACA,oDAAA,CACA,4CAAA,CAEA,qFAGE,8DAAA,CACA,oDAAA,CACA,4CAAA,CAKF,qFAGE,iEAAA,CACA,gDAAA,CACA,+BAAA",sourcesContent:["// Button cell. Fixed height spaces every row the same.\n.actionCell {\n  padding-right: 16px;\n  height: 52px;\n}\n\n// Label cell. Keeps text off the left edge.\n.labelCell {\n  padding-left: var(--spacing-p-xs);\n}\n\n// The DSCO Modal content section is a flex child with align-items: flex-start,\n// so children take content width by default. Stretch the wrapper so the\n// version list fills the full modal width.\n.modalBody {\n  width: 100%;\n}\n\n.versionList {\n  width: 100%;\n  max-height: 330px;\n  overflow-y: auto;\n  margin: 1em 0;\n  scrollbar-color: var(--background-neutral-quinary)\n    var(--background-neutral-primary);\n\n  &::-webkit-scrollbar {\n    width: 10px;\n  }\n\n  &::-webkit-scrollbar-track {\n    background: var(--background-neutral-primary);\n  }\n\n  &::-webkit-scrollbar-thumb {\n    background-color: var(--background-neutral-quinary);\n    border-radius: 5px;\n    border: 2px solid var(--background-neutral-primary);\n  }\n}\n\n// Override MUI secondary palette so Cancel keeps its neutral outline treatment.\n.cancelButton {\n  background-color: var(--background-neutral-primary) !important;\n  border-color: var(--borders-neutral-solid) !important;\n  color: var(--text-neutral-primary) !important;\n\n  &:hover,\n  &:focus,\n  &:active {\n    background-color: var(--background-neutral-tertiary) !important;\n    border-color: var(--borders-neutral-solid) !important;\n    color: var(--text-neutral-primary) !important;\n  }\n}\n\n.viewVersionButton {\n  &:hover,\n  &:focus,\n  &:active {\n    background-color: var(--background-brand-purple-strong) !important;\n    color: var(--text-neutral-white-fixed) !important;\n    text-decoration: none !important;\n  }\n}\n"],sourceRoot:""}]),i.locals={actionCell:"t1HqLV86KcOw3PnGtMs7",labelCell:"EE4v3EROCVULJFhTauFQ",modalBody:"Xv0Me6q72q1TzMiSx88m",versionList:"YxkIUVY_T61bhtCFysUy",cancelButton:"NLDlUAFTv6KVfu9Z5tq8",viewVersionButton:"kIZiJUhDlqq8B0RZQHD9"};const l=i},7700:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".M48KX41BCR4qgyhOUvKe{width:100%;height:100%;background-color:#fff;position:absolute;top:0;left:0;border:none;box-sizing:border-box}.x_X89Lc8QZUNdRj8o5rb{height:100vh;background-color:#fff}","",{version:3,sources:["webpack://./src/weblab2/htmlPreview/styles/inner-html-preview.module.scss"],names:[],mappings:"AAAA,sBACE,UAAA,CACA,WAAA,CACA,qBAAA,CACA,iBAAA,CACA,KAAA,CACA,MAAA,CACA,WAAA,CACA,qBAAA,CAIF,sBACE,YAAA,CACA,qBAAA",sourcesContent:[".fileIframe {\n  width: 100%;\n  height: 100%;\n  background-color: white;\n  position: absolute;\n  top: 0;\n  left: 0;\n  border: none;\n  box-sizing: border-box;\n}\n\n// Styles for the PageNotFound component\n.placeholderContainer {\n  height: 100vh;\n  background-color: white;\n}\n"],sourceRoot:""}]),i.locals={fileIframe:"M48KX41BCR4qgyhOUvKe",placeholderContainer:"x_X89Lc8QZUNdRj8o5rb"};const l=i},7740:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,"span.vocab{text-decoration:underline}code.visual-block{border:none;box-shadow:inset -1px -1px 1px rgba(0,0,0,.5),inset 1px 1px 1px 0 rgba(255,255,255,.8);color:#000}.docs-pages th{font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;background-color:#5b6770;color:#fff;border:1px solid #fff;text-align:left;font-size:120%;padding:5px}.docs-pages td{padding:5px;border:1px solid #5b6770}","",{version:3,sources:["webpack://./style/curriculum/markdown.scss","webpack://./style/curriculum/documentation_tables.scss","webpack://./../frontend/packages/component-library-styles/font.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AACA,WACE,yBAAA,CAIF,kBACE,WAAA,CACA,sFACE,CAEF,UAAA,CCNA,eC4DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD5DE,wBEMO,CFLP,UEWI,CFVJ,qBAAA,CACA,eAAA,CACA,cAAA,CACA,WAAA,CAGF,eACE,WAAA,CACA,wBAAA",sourcesContent:["/* Style the vocab definitions generated by the Markdown Preprocessor */\nspan.vocab {\n  text-decoration: underline;\n}\n\n/* Style the visual code blocks generated by Remark */\ncode.visual-block {\n  border: none;\n  box-shadow:\n    inset -1px -1px 1px rgb(0 0 0 / 0.5),\n    inset 1px 1px 1px 0 rgb(255 255 255 / 0.8);\n  color: #000;\n}\n",'@import "color.scss";\n@import \'@code-dot-org/component-library-styles/font\';\n@import "markdown";\n\n.docs-pages {\n  th {\n    @include main-font-semi-bold;\n    background-color: $charcoal;\n    color: $white;\n    border: 1px solid $white;\n    text-align: left;\n    font-size: 120%;\n    padding: 5px;\n  }\n\n  td {\n    padding: 5px;\n    border: 1px solid $charcoal;\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: