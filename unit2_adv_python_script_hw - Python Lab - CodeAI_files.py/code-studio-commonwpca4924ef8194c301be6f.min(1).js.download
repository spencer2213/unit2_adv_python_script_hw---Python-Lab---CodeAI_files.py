: 400;\n    line-height: 40px;\n    color: var(--text-brand-teal-primary);\n  }\n}\n\n.lessonEntry {\n  width: 100%;\n}\n\n.lessonHeader {\n  padding: 0 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  background-color: var(--background-brand-purple-primary);\n  color: var(--text-neutral-white-fixed);\n\n  .lessonTitle {\n    margin: 10px 0;\n    font-size: 18px;\n    font-style: normal;\n    font-weight: 400;\n    color: var(--text-neutral-white-fixed);\n    text-decoration: underline;\n    line-height: 40px;\n  }\n}\n\n.lessonLink {\n  color: var(--text-neutral-white-fixed);\n}\n\n.lessonEntries {\n  display: flex;\n  flex-direction: row;\n  align-items: stretch;\n  align-content: stretch;\n}\n\n.section {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n}\n\n.sectionObject {\n  padding: 0 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  background-color: var(--background-neutral-secondary);\n  color: var(--text-neutral-tertiary);\n\n  .sectionHeading {\n    margin: 10px 0;\n    font-size: 17.5px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 20px;\n    color: inherit;\n  }\n}\n\n.sectionEntries {\n  height: 100%;\n  padding: 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  color: var(--text-neutral-tertiary);\n\n  // Vocab items are bare <li> children (no <ul>); nudge them right so the\n  // bullet sits inside the container rather than spilling past the left edge.\n  > li {\n    margin-left: 15px;\n  }\n\n  .resourceHeading {\n    margin: 10px 0;\n    font-size: 14px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 20px;\n    color: inherit;\n  }\n\n  .emptyMessage {\n    margin: 0 0 10px;\n    color: inherit;\n  }\n}\n'],sourceRoot:""}]),i.locals={rollupPage:"X62qLFGjE6ys2WyAydq1",navLink:"ECmPMlacBglgG2uHyOo7",pageTitle:"tvi3hP6J4gNBpiS76wgm",unitTitle:"RdB9WvN6ovDGj_HcV06k",lessonEntry:"batmC7bHCqfKHV8WYXNg",lessonHeader:"jqGIZSjurKo8x48NL6_U",lessonTitle:"LO0pOVAYvt5TDvLBiG