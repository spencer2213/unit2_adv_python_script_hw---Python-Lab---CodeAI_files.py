8px;\n  margin-top: 3px;\n  margin-bottom: 3px;\n  position: relative;\n}\n\n.text {\n  @include main-font-semi-bold;\n  display: inline-block;\n  letter-spacing: -0.12px;\n}\n\n.textProgressStyle {\n  @include main-font-semi-bold;\n  display: inline-block;\n  font-size: 12px;\n  letter-spacing: -0.12px;\n  width: 120px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.iconMargin {\n  margin-left: 10px;\n}\n\n.iconMarginRTL {\n  margin-right: 10px;\n}\n","// Common site-wide fonts, put here for easy access from all scss files\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n// Please note (!): use only single quotes (' ') for strings (!) to allow our custom converter to work properly.\n// This file is being transpiled to js object.\n// (So it can be used in jsx/tsx files for inline styles. This is made mostly for legacy.\n// Try to avoid use of inline styles if you're creating new component).\n// Keeping that in mind -\n\n$geist-font: 'Geist';\n$space-grotesk-font: 'Space Grotesk';\n$noto-sans-fonts: 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Armenian', 'Noto Sans Bengali',\n'Noto Sans SC', 'Noto Sans TC', 'Noto Sans Devanagari', 'Noto Sans Georgian', 'Noto Sans Hebrew', 'Noto Sans JP',\n'Noto Sans Kannada', 'Noto Sans Khmer', 'Noto Sans KR', 'Noto Sans Myanmar', 'Noto Sans Sinhala',\n'Noto Sans Tamil', 'Noto Sans Telugu', 'Noto Sans Thai', 'Noto Sans Thaana', 'Noto Sans Math';\n\n$main-font: $geist-font, $noto-sans-fonts, sans-serif;\n$heading-font: $space-grotesk-font, $main-font;\n\n$thin-font-weight: 100;\n$extra-light-font-weight: 200;\n$light-font-weight: 300;\n$regular-font-weight: 400;\n$medium-font-weight: 500;\n$semi-bold-font-weight: 600;\n$bold-font-weight: 700;\n$extra-bold-font-weight: 800;\n$black-font-weight: 900;\n\n@mixin main-font-thin {\n  font-family: $main-font;\n  font-weight: $thin-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: $main-font;\n  font-weight: $extra-light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: $main-font;\n  font-weight: $light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: $main-font;\n  font-weight: $regular-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: $main-font;\n  font-weight: $medium-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: $main-font;\n  font-weight: $semi-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: $main-font;\n  font-weight: $bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: $main-font;\n  font-weight: $extra-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: $main-font;\n  font-weight: $black-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n$barlowSemiCondensed-semibold: 'Barlow Semi Condensed Semibold', $noto-sans-fonts, sans-serif;\n$barlowSemiCondensed-medium: 'Barlow Semi Condensed Medium', $noto-sans-fonts, sans-serif;\n\n$code-font: 'Source Code Pro', Monaco, 'Bitstream Vera Sans Mono', 'Lucida Console', Terminal, monospace;\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n"],sourceRoot:""}]),i.locals={levelPill:"XK8yTqmUt_UZw8YwyozC",text:"Npbu6iQzwjVHdgZQvBTH",textProgressStyle:"d_Yg15hoUWsodj9GE6gA",iconMargin:"LYCw3fAgwNAlkwBdSKc9",iconMarginRTL:"hZ6YmTTJ18q_hPFPeEdx"};const l=i},2828:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".progress-bubble.enabled{transition:background-color .2s ease-out,border-color .2s ease-out,color .2s ease-out}.progress-bubble.enabled:hover{text-decoration:none}.progress-bubble.enabled.hover-not-started:hover{border-color:var(--border-neutral-secondary) !important;background-color:var(--background-neutral-tertiary) !important}.progress-bubble.enabled.hover-in-progress:hover{border-color:var(--border-success-strong) !important;background-color:var(--background-success-light) !important}.progress-bubble.enabled.hover-completed:hover{color:var(--text-neutral-inverse) !important;border-color:var(--background-success-strong) !important;background-color:var(--background-success-strong) !important}.progress-bubble.enabled.hover-rejected:hover{color:var(--text-neutral-inverse) !important;border-color:var(--background-error-strong) !important;background-color:var(--background-error-strong) !important}.uitest-ProgressPill:focus-visible{outline-offset:1px}a.progress-bubble-link{display:inline-block;cursor:pointer;text-decoration:none !important}a.progress-bubble-link:hover{text-decoration:none}a.progress-bubble-link:focus{outline:none}a.progress-bubble-link:focus-visible{outline:revert}table.progress-legend{margin-top:60px;margin-bottom:20px}table.progress-legend:nth-of-type(2){margin-top:0}table.progress-legend:only-of-type{width:100%}.progress-legend{text-align:center;color:var(--text-neutral-primary);font-weight:400}.progress-legend td{padding:10px}.progress-legend tr{border:2px solid var(--borders-neutral-primary);background-color:var(--background-neutral-primary)}.progress-legend thead tr{background-color:var(--background-neutral-secondary)}.progress-legend thead tr:first-of-type{background-color:var(--background-neutral-primary);border:none}.progress-legend thead tr:first-of-type td{font-weight:600;font-size:18px}.progress-legend thead tr div:nth-of-type(2){font-size:10px}.progress-legend tbody td:first-of-type{border-inline-end:2px solid var(--borders-neutral-primary)}.progress-legend div{display:flex;align-items:center;justify-content:center}.progress-legend .level-details{padding:10px 0;white-space:nowrap}.progress-legend .level-details div:nth-of-type(2){padding-top:16px}.progress-legend .level-details i{margin-inline-end:5px}.progress-legend .end-border{border-inline-end:2px solid var(--borders-neutral-primary)}","",{version:3,sources:["webpack://./src/templates/progress/styles.scss"],names:[],mappings:"AACE,yBACE,qFAAA,CAEA,+BACE,oBAAA,CAMF,iDACE,uDAAA,CACA,8DAAA,CAGF,iDACE,oDAAA,CACA,2DAAA,CAKF,+CACE,4CAAA,CACA,wDAAA,CACA,4DAAA,CAIF,8CACE,4CAAA,CACA,sDAAA,CACA,0DAAA,CAKN,mCACE,kBAAA,CAGF,uBACE,oBAAA,CACA,cAAA,CAGA,+BAAA,CAEA,6BACE,oBAAA,CAGF,6BAEE,YAAA,CAGF,qCAEE,cAAA,CAIJ,sBACE,eAAA,CACA,kBAAA,CACA,qCACE,YAAA,CAEF,mCACE,UAAA,CAGJ,iBACE,iBAAA,CACA,iCAAA,CACA,eAAA,CACA,oBACE,YAAA,CAEF,oBACE,+CAAA,CACA,kDAAA,CAGA,0BACE,oDAAA,CACA,wCACE,kDAAA,CACA,WAAA,CACA,2CACE,eAAA,CACA,cAAA,CAGJ,6CACE,cAAA,CAKJ,wCACE,0DAAA,CAGJ,qBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CAEF,gCACE,cAAA,CACA,kBAAA,CACA,mDACE,gBAAA,CAEF,kCACE,qBAAA,CAGJ,6BACE,0DAAA",sourcesContent:[".progress-bubble {\n  &.enabled {\n    transition: background-color 0.2s ease-out, border-color 0.2s ease-out,\n      color 0.2s ease-out;\n    &:hover {\n      text-decoration: none;\n    }\n\n    // Per-state hover, per the CADS bubble spec. levelHoverClass picks the\n    // class; !important because the base fill and border arrive as inline\n    // styles from levelProgressStyle.\n    &.hover-not-started:hover {\n      border-color: var(--border-neutral-secondary) !important;\n      background-color: var(--background-neutral-tertiary) !important;\n    }\n\n    &.hover-in-progress:hover {\n      border-color: var(--border-success-strong) !important;\n      background-color: var(--background-success-light) !important;\n    }\n\n    // The two filled hovers draw their border in the fill color; the -strong\n    // border tokens sit lighter and would show as a ring.\n    &.hover-completed:hover {\n      color: var(--text-neutral-inverse) !important;\n      border-color: var(--background-success-strong) !important;\n      background-color: var(--background-success-strong) !important;\n    }\n\n    // Not in the spec; peer review rejection is the one red base state.\n    &.hover-rejected:hover {\n      color: var(--text-neutral-inverse) !important;\n      border-color: var(--background-error-strong) !important;\n      background-color: var(--background-error-strong) !important;\n    }\n  }\n}\n\n.uitest-ProgressPill:focus-visible {\n  outline-offset: 1px;\n}\n\na.progress-bubble-link {\n  display: inline-block;\n  cursor: pointer;\n\n  // Use important to overwrite default projects link underline.\n  text-decoration: none !important;\n\n  &:hover {\n    text-decoration: none;\n  }\n\n  &:focus {\n    // Override the default focus style to prevent outline\n    outline: none;\n  }\n\n  &:focus-visible {\n    // Use revert to allow browser default focus styles\n    outline: revert;\n  }\n}\n\ntable.progress-legend {\n  margin-top: 60px;\n  margin-bottom: 20px;\n  &:nth-of-type(2) {\n    margin-top: 0;\n  }\n  &:only-of-type {\n    width: 100%;\n  }\n}\n.progress-legend {\n  text-align: center;\n  color: var(--text-neutral-primary);\n  font-weight: 400;\n  td {\n    padding: 10px;\n  }\n  tr {\n    border: 2px solid var(--borders-neutral-primary);\n    background-color: var(--background-neutral-primary);\n  }\n  thead {\n    tr {\n      background-color: var(--background-neutral-secondary);\n      &:first-of-type {\n        background-color: var(--background-neutral-primary);\n        border: none;\n        td {\n          font-weight: 600;\n          font-size: 18px;\n        }\n      }\n      div:nth-of-type(2) {\n        font-size: 10px;\n      }\n    }\n  }\n  tbody {\n    td:first-of-type {\n      border-inline-end: 2px solid var(--borders-neutral-primary);\n    }\n  }\n  div {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .level-details {\n    padding: 10px 0;\n    white-space: nowrap;\n    div:nth-of-type(2) {\n      padding-top: 16px;\n    }\n    i {\n      margin-inline-end: 5px;\n    }\n  }\n  .end-border {\n    border-inline-end: 2px solid var(--borders-neutral-primary);\n  }\n}\n"],sourceRoot:""}]);const l=i},2836:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".UTUMSuTF9bDQpzs03EdD{display:table-cell;vertical-align:top;width:200px;height:100%;border-radius:2px}.iLdc8imJStRNxUlvSIju{height:100%;border:1px solid var(--borders-info-primary);background-color:var(--background-info-extra-light);text-align:center}","",{version:3,sources:["webpack://./src/templates/progress/teacherInfoBox.module.scss"],names:[],mappings:"AAAA,sBACE,kBAAA,CACA,kBAAA,CACA,WAAA,CACA,WAAA,CACA,iBAAA,CAGF,sBACE,WAAA,CACA,4CAAA,CACA,mDAAA,CACA,iBAAA",sourcesContent:[".outer {\n  display: table-cell;\n  vertical-align: top;\n  width: 200px;\n  height: 100%;\n  border-radius: 2px;\n}\n\n.inner {\n  height: 100%;\n  border: 1px solid var(--borders-info-primary);\n  background-color: var(--background-info-extra-light);\n  text-align: center;\n}\n"],sourceRoot:""}]),i.locals={outer:"UTUMSuTF9bDQpzs03EdD",inner:"iLdc8imJStRNxUlvSIju"};const l=i},7765:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,'.nR55wKbFIX9B2Q8SoEmH{border:1px solid var(--borders-neutral-strong);border-radius:2px;width:214px;background-color:var(--background-neutral-secondary)}.nR55wKbFIX9B2Q8SoEmH a.yyiE3bgXGKFEKA9nNJZL{text-decoration:none}.XkY0F8zw1rKQLMmGMlGk{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:400;font-style:normal;padding-left:15px;padding-right:10px;padding-bottom:10px;font-size:.6875rem;color:var(--text-neutral-primary)}.p2AdyyD0R6bL6v6fd8LA{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC",