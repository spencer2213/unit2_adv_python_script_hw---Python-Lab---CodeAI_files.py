lors may be used for components that are truly theme-agnostic and have no semantic meaning. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* stylelint-disable color-hex-length */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'],\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Light'],\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Dark'] {\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-40: #6f67d9;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-60: #4238c4;\n  --brand-purple-70: #3228b7;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-purple-95: #1f1976;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-10: #ffd2b3;\n  --brand-orange-20: #ffbd8a;\n  --brand-orange-30: #ffa868;\n  --brand-orange-40: #ff8b38;\n  --brand-orange-50: #f46800;\n  --brand-orange-60: #d15900;\n  --brand-orange-70: #b34800;\n  --brand-orange-80: #942f00;\n  --brand-orange-90: #701c00;\n  --brand-orange-95: #611d00;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-10: #f3c3d8;\n  --brand-pink-20: #eea1c3;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-40: #eb5895;\n  --brand-pink-50: #e11970;\n  --brand-pink-60: #ce035b;\n  --brand-pink-70: #b5004f;\n  --brand-pink-80: #a10448;\n  --brand-pink-90: #8d003d;\n  --brand-pink-95: #7d0c3d;\n  --neutral-base-black: #121212;\n  --neutral-base-true-black: #000000;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-5: #1212120d;\n  --neutral-black-alpha-10: #1212121a;\n  --neutral-black-alpha-20: #12121233;\n  --neutral-black-alpha-30: #1212124d;\n  --neutral-black-alpha-40: #12121266;\n  --neutral-black-alpha-50: #12121280;\n  --neutral-black-alpha-60: #12121299;\n  --neutral-black-alpha-70: #121212b2;\n  --neutral-black-alpha-80: #121212cc;\n  --neutral-black-alpha-90: #121212e5;\n  --neutral-black-alpha-95: #121212f2;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-60: #6e7782;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --neutral-gray-90: #363b40;\n  --neutral-gray-95: #282b2f;\n  --neutral-white-alpha-5: #ffffff0d;\n  --neutral-white-alpha-10: #ffffff1a;\n  --neutral-white-alpha-20: #ffffff33;\n  --neutral-white-alpha-30: #ffffff4d;\n  --neutral-white-alpha-40: #ffffff66;\n  --neutral-white-alpha-50: #ffffff80;\n  --neutral-white-alpha-60: #ffffff99;\n  --neutral-white-alpha-70: #ffffffb2;\n  --neutral-white-alpha-80: #ffffffcc;\n  --neutral-white-alpha-90: #ffffffe5;\n  --neutral-white-alpha-95: #fffffff2;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-10: #fac2c2;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-30: #f37272;\n  --sentiment-error-40: #ef4848;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-60: #d31212;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-error-80: #8d0c0c;\n  --sentiment-error-90: #6c0909;\n  --sentiment-error-95: #620202;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-10: #b8e5ff;\n  --sentiment-information-20: #94d7ff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-40: #38b3ff;\n  --sentiment-information-50: #0099f3;\n  --sentiment-information-60: #0082e5;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-80: #0855b2;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-information-95: #06338d;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-10: #c4f1ca;\n  --sentiment-success-20: #9be3a3;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-40: #4fcf5d;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-60: #2da43a;\n  --sentiment-success-70: #258830;\n  --sentiment-success-80: #1f7028;\n  --sentiment-success-90: #17541e;\n  --sentiment-success-95: #003f25;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-10: #ffecb8;\n  --sentiment-warning-20: #ffe08a;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-40: #fdc835;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-60: #edaf02;\n  --sentiment-warning-70: #cf8e02;\n  --sentiment-warning-80: #b27a01;\n  --sentiment-warning-90: #885d02;\n  --sentiment-warning-95: #654500;\n}\n\n/* CADS Semantic Colors */\n\n/* This file consists of Semantic colors, if you need color tokens that support multiple themes, you need to import and use this file. */\n\n/* Raw values for Semantic colors are defined in Primitive Colors (primitiveColors.css), while semantic color values are specified for every theme. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* Light Theme Semantic Colors (light is the default theme, that's why :root rule is included) */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Light'] {\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-true-base: var(--neutral-base-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-strong: var(--sentiment-success-90);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-strong: var(--sentiment-information-90);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-selected-primary-inverse: var(--sentiment-success-5);\n  --background-disabled-brand: var(--brand-purple-5);\n  --background-disabled-error: var(--sentiment-error-5);\n  --background-disabled-info: var(--sentiment-information-5);\n\n  /* Matches background-neutral-quaternary by value today, but disabled intent is decoupled so the state can be restyled independently. */\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-disabled-orange: var(--brand-orange-5);\n  --background-disabled-pink: var(--brand-pink-5);\n  --background-disabled-success: var(--sentiment-success-5);\n  --background-disabled-warning: var(--sentiment-warning-5);\n\n  /* The Run button orange is an intentional a11y exception. It fails 4.5:1 contrast with white labels but we are keeping it for its deep user association with \"run\" (and Blockly's run blocks). */\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-10);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n\n  /* Border state selected strong and primary intentionally match the background state color. */\n  --border-selected-primary: var(--brand-purple-80);\n  --border-selected-strong: var(--brand-purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-disabled-orange: var(--brand-orange-5);\n  --border-disabled-pink: var(--brand-pink-5);\n  --border-disabled-success: var(--sentiment-success-5);\n  --border-disabled-warning: var(--sentiment-warning-5);\n  --border-focused-inverse: var(--sentiment-success-5);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-10);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-10);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-brand-primary-fixed: var(--brand-purple-50);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-warning-primary: var(--sentiment-warning-50);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-warning-primary-fixed: var(--sentiment-warning-50);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-success-primary-fixed: var(--sentiment-success-70);\n  --text-info-primary: var(--sentiment-information-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-info-primary-fixed: var(--sentiment-information-70);\n\n  /* Selected state text pairs with background and border-state-selected — always use the two together. */\n  --text-selected-primary: var(--sentiment-success-5);\n  --text-selected-primary-inverse: var(--brand-purple-95);\n  --text-disabled-brand: var(--brand-purple-5);\n  --text-disabled-error: var(--sentiment-error-5);\n  --text-disabled-info: var(--sentiment-information-5);\n  --text-disabled-neutral: var(--neutral-gray-20);\n\n  /* Single inverse for the whole disabled family: label color for solid-fill disabled elements of any color; pair with the matching background/disabled/<color>. Outline disabled elements use text/disabled/<color> instead. */\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-disabled-orange: var(--brand-orange-5);\n  --text-disabled-pink: var(--brand-pink-5);\n  --text-disabled-success: var(--sentiment-success-5);\n  --text-disabled-warning: var(--sentiment-warning-5);\n\n  /* Orange text intentionally keeps the true brand-guideline level-50 value instead of bumping for contrast */\n  --text-accent-orange-primary: var(--brand-orange-50);\n  --text-accent-orange-secondary: var(--brand-orange-70);\n  --text-accent-orange-primary-fixed: var(--brand-orange-50);\n  --text-accent-pink-primary: var(--brand-pink-50);\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-accent-pink-primary-fixed: var(--brand-pink-50);\n}\n\n/* Dark Theme Semantic Colors */\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Dark'] {\n  --background-neutral-primary: var(--neutral-base-black);\n  --background-neutral-secondary: var(--neutral-gray-95);\n  --background-neutral-tertiary: var(--neutral-gray-90);\n  --background-neutral-quaternary: var(--neutral-gray-80);\n  --background-neutral-quinary: var(--neutral-gray-70);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-30);\n  --background-neutral-octonary: var(--neutral-gray-20);\n  --background-neutral-primary-inverse: var(--neutral-base-white);\n  --background-neutral-true-base: var(--neutral-base-true-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-95);\n  --background-brand-mid: var(--brand-purple-80);\n\n  /* Strong variables are mostly used for hover states, in dark mode they invert and become lighter. They fail 4.5:1 contrast with labels, but we only need the default state to pass. */\n  --background-brand-strong: var(--brand-purple-40);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-95);\n  --background-error-mid: var(--sentiment-error-80);\n  --background-error-strong: var(--sentiment-error-40);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-95);\n  --background-warning-mid: var(--sentiment-warning-80);\n  --background-warning-strong: var(--sentiment-warning-40);\n\n  /* Level 70 is preserved for success even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-95);\n  --background-success-mid: var(--sentiment-success-80);\n\n  /* Bc success is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-success-strong: var(--sentiment-success-60);\n\n  /* Level 70 is preserved for info even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-95);\n  --background-info-mid: var(--sentiment-information-80);\n\n  /* Bc info is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-info-strong: var(--sentiment-information-60);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--sentiment-success-5);\n  --background-selected-strong: var(--sentiment-success-20);\n  --background-selected-primary-inverse: var(--brand-purple-80);\n  --background-disabled-brand: var(--neutral-gray-80);\n  --background-disabled-error: var(--neutral-gray-80);\n  --background-disabled-info: var(--neutral-gray-80);\n  --background-disabled-neutral: var(--neutral-gray-80);\n  --background-disabled-orange: var(--neutral-gray-80);\n  --background-disabled-pink: var(--neutral-gray-80);\n  --background-disabled-success: var(--neutral-gray-80);\n  --background-disabled-warning: var(--neutral-gray-80);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-95);\n  --background-accent-orange-mid: var(--brand-orange-80);\n  --background-accent-orange-strong: var(--brand-orange-40);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-95);\n  --background-accent-pink-mid: var(--brand-pink-80);\n  --background-accent-pink-strong: var(--brand-pink-40);\n  --border-neutral-primary: var(--neutral-gray-80);\n  --border-neutral-secondary: var(--neutral-gray-60);\n  --border-neutral-solid: var(--neutral-base-white);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n\n  /* Primary borders of all colors stay at level 50 in dark mode since contrast only needs 3:1. */\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-90);\n  --border-brand-mid: var(--brand-purple-70);\n  --border-brand-strong: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-90);\n  --border-error-mid: var(--sentiment-error-70);\n  --border-error-strong: var(--sentiment-error-30);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-90);\n  --border-warning-mid: var(--sentiment-warning-70);\n  --border-warning-strong: var(--sentiment-warning-30);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-90);\n  --border-success-mid: var(--sentiment-success-70);\n  --border-success-strong: var(--sentiment-success-30);\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-90);\n  --border-info-mid: var(--sentiment-information-70);\n  --border-info-strong: var(--sentiment-information-30);\n  --border-focused-primary: var(--brand-purple-30);\n  --border-selected-primary: var(--sentiment-success-5);\n  --border-selected-strong: var(--sentiment-success-20);\n  --border-selected-primary-inverse: var(--brand-purple-80);\n  --border-disabled-brand: var(--neutral-gray-80);\n  --border-disabled-error: var(--neutral-gray-80);\n  --border-disabled-info: var(--neutral-gray-80);\n  --border-disabled-neutral: var(--neutral-gray-80);\n  --border-disabled-orange: var(--neutral-gray-80);\n  --border-disabled-pink: var(--neutral-gray-80);\n  --border-disabled-success: var(--neutral-gray-80);\n  --border-disabled-warning: var(--neutral-gray-80);\n  --border-focused-inverse: var(--brand-purple-50);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-90);\n  --border-accent-orange-mid: var(--brand-orange-70);\n  --border-accent-orange-strong: var(--brand-orange-30);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-90);\n  --border-accent-pink-mid: var(--brand-pink-70);\n  --border-accent-pink-strong: var(--brand-pink-30);\n  --text-neutral-primary: var(--neutral-base-white);\n  --text-neutral-secondary: var(--neutral-gray-5);\n  --text-neutral-tertiary: var(--neutral-gray-10);\n  --text-neutral-quaternary: var(--neutral-gray-20);\n  --text-neutral-primary-inverse: var(--neutral-base-black);\n  --text-neutral-placeholder: var(--neutral-gray-60);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--neutral-base-white);\n  --text-brand-secondary: var(--brand-purple-5);\n  --text-brand-primary-fixed: var(--brand-purple-30);\n  --text-error-primary: var(--neutral-base-white);\n  --text-error-secondary: var(--sentiment-error-5);\n  --text-error-primary-fixed: var(--sentiment-error-30);\n  --text-warning-primary: var(--neutral-base-white);\n  --text-warning-secondary: var(--sentiment-warning-5);\n  --text-warning-primary-fixed: var(--sentiment-warning-30);\n  --text-success-primary: var(--neutral-base-white);\n  --text-success-secondary: var(--sentiment-success-5);\n  --text-success-primary-fixed: var(--sentiment-success-30);\n  --text-info-primary: var(--neutral-base-white);\n  --text-info-secondary: var(--sentiment-information-5);\n  --text-info-primary-fixed: var(--sentiment-information-30);\n\n  /* Pairs with background-state-selected — always use the two together. */\n  --text-selected-primary: var(--brand-purple-95);\n  --text-selected-primary-inverse: var(--sentiment-success-5);\n  --text-disabled-brand: var(--neutral-gray-80);\n  --text-disabled-error: var(--neutral-gray-80);\n  --text-disabled-info: var(--neutral-gray-80);\n  --text-disabled-neutral: var(--neutral-gray-80);\n  --text-disabled-neutral-inverse: var(--neutral-base-black);\n  --text-disabled-orange: var(--neutral-gray-80);\n  --text-disabled-pink: var(--neutral-gray-80);\n  --text-disabled-success: var(--neutral-gray-80);\n  --text-disabled-warning: var(--neutral-gray-80);\n  --text-accent-orange-primary: var(--neutral-base-white);\n  --text-accent-orange-secondary: var(--brand-orange-5);\n  --text-accent-orange-primary-fixed: var(--brand-orange-30);\n  --text-accent-pink-primary: var(--neutral-base-white);\n  --text-accent-pink-secondary: var(--brand-pink-5);\n  --text-accent-pink-primary-fixed: var(--brand-pink-30);\n}\n"],sourceRoot:""}]);const l=i},776:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,"/* Legacy token aliases for the CADS-schema brands.\n *\n * Under [data-brand='codeai-next'] every legacy semantic token\n * (colors.css) must resolve to a CodeAI value, so that code which has not\n * yet migrated to the CADS token schema (colors_codeAi.css) is still\n * rebranded. This file maps each legacy token name onto its CADS\n * successor. Tokens whose names are identical in both schemas are NOT\n * listed here: the brand's own token file (brandCodeAiNext.css,\n * brandCodeAiAudit.css) already redefines those in its scope.\n *\n * The same mapping is scoped to [data-brand='codeai-audit'], where the\n * CADS successors are pink (brandCodeAiAudit.css) and legacy names\n * therefore go pink too. That is the only reason the audit brand needs\n * to know legacy names exist: deleting this file after call-site\n * migration retires them from the audit brand as well, with no edit to\n * brandCodeAiAudit.css.\n *\n * Aliases point at CADS *semantic* tokens, which switch with\n * [data-theme] on their own — one brand-scoped block therefore covers\n * both Light and Dark. The few aliases that point at primitives are\n * theme-fixed by design and commented as such.\n *\n * Mapping decisions that involved judgment (design sign-off tracked in\n * the color-bridge spec):\n *   - The three legacy brand families (aqua, teal, purple) collapse into\n *     the single CADS brand family.\n *   - Legacy background ramp steps extra-light/light (and purple-hover)\n *     both map to CADS light; CADS mid is a net-new darker step. Legacy\n *     border ramps only had one \"light\" step and map to CADS light\n *     directly.\n *   - accent-strawberry maps to accent-pink (nearest CADS accent).\n *   - background-neutral-lab maps to background-neutral-primary; the\n *     legacy Dark value (#121212) equals the CADS Dark primary exactly.\n *\n * Same-name tokens whose MEANING shifted are silently owned by the CADS\n * definition and cannot be fixed here (one name, one value per scope):\n * e.g. legacy --background-error-light was a 20-level fill, CADS -light\n * is a 5-level wash (the 20-level equivalent is now -mid). Call sites\n * that need the heavier step migrate to -mid during call-site migration.\n *\n * Delete this file at brand cutover cleanup, when call sites have been\n * migrated to CADS token names.\n */\n\n/* Selector notes: the :root / [data-theme] compounds keep specificity at\n * (0,2,0) so these aliases beat the legacy colors.css declarations\n * (0,1,0) for the same names. The [data-theme] entries are required for\n * correctness, not just precedence: var() chains in custom properties\n * are substituted on the element that declares them and inherit as\n * resolved values, so the aliases must be re-declared on theme-carrying\n * elements (e.g. Lab2's nested data-theme='Dark' div) to pick up that\n * element's CADS values. */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Dark'],\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'][data-theme='Light'],\n[data-brand='codeai-audit'][data-theme='Dark'],\n[data-brand='codeai-audit'] [data-theme='Light'],\n[data-brand='codeai-audit'] [data-theme='Dark'] {\n  /* Backgrounds — brand families collapse to the CADS brand ramp */\n  --background-brand-aqua-extra-light: var(--background-brand-light);\n  --background-brand-aqua-light: var(--background-brand-light);\n  --background-brand-aqua-primary: var(--background-brand-primary);\n  --background-brand-aqua-strong: var(--background-brand-strong);\n  --background-brand-purple-extra-light: var(--background-brand-light);\n  --background-brand-purple-hover: var(--background-brand-light);\n  --background-brand-purple-light: var(--background-brand-light);\n  --background-brand-purple-primary: var(--background-brand-primary);\n\n  /* -fixed means \"same in both themes\": alias to the primitive, which is\n     theme-fixed by definition (legacy value was purple-50 in both themes) */\n  --background-brand-purple-primary-fixed: var(--brand-purple-50);\n  --background-brand-purple-strong: var(--background-brand-strong);\n  --background-brand-teal-extra-light: var(--background-brand-light);\n  --background-brand-teal-light: var(--background-brand-light);\n  --background-brand-teal-primary: var(--background-brand-primary);\n  --background-brand-teal-strong: var(--background-brand-strong);\n\n  /* Backgrounds — strawberry accent retires in favor of pink */\n  --background-accent-strawberry-light: var(--background-accent-pink-light);\n  --background-accent-strawberry-primary: var(--background-accent-pink-primary);\n  --background-accent-strawberry-strong: var(--background-accent-pink-strong);\n\n  /* Backgrounds — sentiment extra-light becomes light */\n  --background-error-extra-light: var(--background-error-light);\n  --background-info-extra-light: var(--background-info-light);\n  --background-success-extra-light: var(--background-success-light);\n  --background-warning-extra-light: var(--background-warning-light);\n\n  /* Backgrounds — neutral one-offs */\n  --background-neutral-disabled: var(--background-disabled-neutral);\n  --background-neutral-lab: var(--background-neutral-primary);\n\n  /* Borders — CADS drops the plural; brand families collapse */\n  --borders-brand-aqua-light: var(--border-brand-light);\n  --borders-brand-aqua-primary: var(--border-brand-primary);\n  --borders-brand-aqua-strong: var(--border-brand-strong);\n  --borders-brand-purple-light: var(--border-brand-light);\n  --borders-brand-purple-primary: var(--border-brand-primary);\n  --borders-brand-purple-strong: var(--border-brand-strong);\n  --borders-brand-teal-light: var(--border-brand-light);\n  --borders-brand-teal-primary: var(--border-brand-primary);\n  --borders-brand-teal-strong: var(--border-brand-strong);\n  --borders-error-light: var(--border-error-light);\n  --borders-error-primary: var(--border-error-primary);\n  --borders-error-strong: var(--border-error-strong);\n  --borders-info-light: var(--border-info-light);\n  --borders-info-primary: var(--border-info-primary);\n  --borders-info-strong: var(--border-info-strong);\n  --borders-success-light: var(--border-success-light);\n  --borders-success-primary: var(--border-success-primary);\n  --borders-success-strong: var(--border-success-strong);\n  --borders-warning-light: var(--border-warning-light);\n  --borders-warning-primary: var(--border-warning-primary);\n  --borders-warning-strong: var(--border-warning-strong);\n  --borders-neutral-disabled: var(--border-disabled-neutral);\n\n  /* legacy neutral border ramp light(gray-10)/primary(gray-20)/strong(gray-40)\n     lands on the CADS primary/secondary pair; light has no lighter CADS\n     step and joins primary */\n  --borders-neutral-light: var(--border-neutral-primary);\n  --borders-neutral-primary: var(--border-neutral-primary);\n  --borders-neutral-solid: var(--border-neutral-solid);\n  --borders-neutral-strong: var(--border-neutral-secondary);\n  --borders-neutral-white-fixed: var(--border-neutral-white-fixed);\n\n  /* Text — brand families collapse */\n  --text-brand-aqua-primary: var(--text-brand-primary);\n  --text-brand-aqua-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-aqua-secondary: var(--text-brand-secondary);\n  --text-brand-purple-primary: var(--text-brand-primary);\n  --text-brand-purple-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-purple-secondary: var(--text-brand-secondary);\n  --text-brand-teal-primary: var(--text-brand-primary);\n  --text-brand-teal-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-teal-secondary: var(--text-brand-secondary);\n\n  /* Text — renamed neutrals */\n  --text-neutral-disabled: var(--text-disabled-neutral);\n  --text-neutral-disabled-inverse: var(--text-disabled-neutral-inverse);\n  --text-neutral-inverse: var(--text-neutral-primary-inverse);\n}\n\n/* Legacy primitives with no CADS successor. Direct primitive usage is\n   rare (~30 call sites for the colored families) but must not fall\n   through to the legacy :root values under this brand. Same-step\n   mapping into the successor family; step 100 retires, CADS tops out\n   at 95. Colliding primitive names (neutral-*, sentiment-* 5–90,\n   brand-purple-5–90) are already redefined by the brand's own token\n   file (brandCodeAiNext.css, brandCodeAiAudit.css).\n\n   Unlike the aliases above, primitives do not vary by theme, so this\n   one root-level block covers both. Do not re-declare these rows on\n   [data-theme] elements: brandLegacyShim.css defines the same pairs\n   in the opposite direction there (--brand-orange-60 from\n   --accent-orange-60), and when both directions apply to the same\n   element, CSS treats the definitions as circular and blanks both\n   variables. */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'],\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'] {\n  --brand-aqua-10: var(--brand-purple-10);\n  --brand-aqua-20: var(--brand-purple-20);\n  --brand-aqua-30: var(--brand-purple-30);\n  --brand-aqua-40: var(--brand-purple-40);\n  --brand-aqua-50: var(--brand-purple-50);\n  --brand-aqua-60: var(--brand-purple-60);\n  --brand-aqua-70: var(--brand-purple-70);\n  --brand-aqua-80: var(--brand-purple-80);\n  --brand-aqua-90: var(--brand-purple-90);\n  --brand-aqua-100: var(--brand-purple-95);\n  --brand-teal-5: var(--brand-purple-5);\n  --brand-teal-10: var(--brand-purple-10);\n  --brand-teal-20: var(--brand-purple-20);\n  --brand-teal-30: var(--brand-purple-30);\n  --brand-teal-40: var(--brand-purple-40);\n  --brand-teal-50: var(--brand-purple-50);\n  --brand-teal-60: var(--brand-purple-60);\n  --brand-teal-70: var(--brand-purple-70);\n  --brand-teal-80: var(--brand-purple-80);\n  --brand-teal-90: var(--brand-purple-90);\n  --brand-teal-100: var(--brand-purple-95);\n  --brand-purple-100: var(--brand-purple-95);\n  --accent-strawberry-10: var(--brand-pink-10);\n  --accent-strawberry-20: var(--brand-pink-20);\n  --accent-strawberry-30: var(--brand-pink-30);\n  --accent-strawberry-40: var(--brand-pink-40);\n  --accent-strawberry-50: var(--brand-pink-50);\n  --accent-strawberry-60: var(--brand-pink-60);\n  --accent-strawberry-70: var(--brand-pink-70);\n  --accent-strawberry-80: var(--brand-pink-80);\n  --accent-strawberry-90: var(--brand-pink-90);\n  --accent-strawberry-100: var(--brand-pink-95);\n  --accent-orange-10: var(--brand-orange-10);\n  --accent-orange-20: var(--brand-orange-20);\n  --accent-orange-30: var(--brand-orange-30);\n  --accent-orange-40: var(--brand-orange-40);\n  --accent-orange-50: var(--brand-orange-50);\n  --accent-orange-60: var(--brand-orange-60);\n  --accent-orange-70: var(--brand-orange-70);\n  --accent-orange-80: var(--brand-orange-80);\n  --accent-orange-90: var(--brand-orange-90);\n  --accent-orange-100: var(--brand-orange-95);\n\n  /* legacy gray-99 (#121212) equals the CADS base black exactly */\n  --neutral-gray-99: var(--neutral-base-black);\n  --sentiment-error-100: var(--sentiment-error-95);\n  --sentiment-information-100: var(--sentiment-information-95);\n  --sentiment-success-100: var(--sentiment-success-95);\n  --sentiment-warning-100: var(--sentiment-warning-95);\n}\n","",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/brandLegacyAliases.css"],names:[],mappings:"AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EA0CE;;AAEF;;;;;;;2BAO2B;AAC3B;;;;;;;;;;EAUE,iEAAiE;EACjE,kEAAkE;EAClE,4DAA4D;EAC5D,gEAAgE;EAChE,8DAA8D;EAC9D,oEAAoE;EACpE,8DAA8D;EAC9D,8DAA8D;EAC9D,kEAAkE;;EAElE;4EAC0E;EAC1E,+DAA+D;EAC/D,gEAAgE;EAChE,kEAAkE;EAClE,4DAA4D;EAC5D,gEAAgE;EAChE,8DAA8D;;EAE9D,6DAA6D;EAC7D,yEAAyE;EACzE,6EAA6E;EAC7E,2EAA2E;;EAE3E,sDAAsD;EACtD,6DAA6D;EAC7D,2DAA2D;EAC3D,iEAAiE;EACjE,iEAAiE;;EAEjE,mCAAmC;EACnC,iEAAiE;EACjE,2DAA2D;;EAE3D,6DAA6D;EAC7D,qDAAqD;EACrD,yDAAyD;EACzD,uDAAuD;EACvD,uDAAuD;EACvD,2DAA2D;EAC3D,yDAAyD;EACzD,qDAAqD;EACrD,yDAAyD;EACzD,uDAAuD;EACvD,gDAAgD;EAChD,oDAAoD;EACpD,kDAAkD;EAClD,8CAA8C;EAC9C,kDAAkD;EAClD,gDAAgD;EAChD,oDAAoD;EACpD,wDAAwD;EACxD,sDAAsD;EACtD,oDAAoD;EACpD,wDAAwD;EACxD,sDAAsD;EACtD,0DAA0D;;EAE1D;;6BAE2B;EAC3B,sDAAsD;EACtD,wDAAwD;EACxD,oDAAoD;EACpD,yDAAyD;EACzD,gEAAgE;;EAEhE,mCAAmC;EACnC,oDAAoD;EACpD,gEAAgE;EAChE,wDAAwD;EACxD,sDAAsD;EACtD,kEAAkE;EAClE,0DAA0D;EAC1D,oDAAoD;EACpD,gEAAgE;EAChE,wDAAwD;;EAExD,4BAA4B;EAC5B,qDAAqD;EACrD,qEAAqE;EACrE,2DAA2D;AAC7D;;AAEA;;;;;;;;;;;;;;eAce;AACf;;;;EAIE,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,wCAAwC;EACxC,qCAAqC;EACrC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,uCAAuC;EACvC,wCAAwC;EACxC,0CAA0C;EAC1C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,6CAA6C;EAC7C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,2CAA2C;;EAE3C,gEAAgE;EAChE,4CAA4C;EAC5C,gDAAgD;EAChD,4DAA4D;EAC5D,oDAAoD;EACpD,oDAAoD;AACtD",sourcesContent:["/* Legacy token aliases for the CADS-schema brands.\n *\n * Under [data-brand='codeai-next'] every legacy semantic token\n * (colors.css) must resolve to a CodeAI value, so that code which has not\n * yet migrated to the CADS token schema (colors_codeAi.css) is still\n * rebranded. This file maps each legacy token name onto its CADS\n * successor. Tokens whose names are identical in both schemas are NOT\n * listed here: the brand's own token file (brandCodeAiNext.css,\n * brandCodeAiAudit.css) already redefines those in its scope.\n *\n * The same mapping is scoped to [data-brand='codeai-audit'], where the\n * CADS successors are pink (brandCodeAiAudit.css) and legacy names\n * therefore go pink too. That is the only reason the audit brand needs\n * to know legacy names exist: deleting this file after call-site\n * migration retires them from the audit brand as well, with no edit to\n * brandCodeAiAudit.css.\n *\n * Aliases point at CADS *semantic* tokens, which switch with\n * [data-theme] on their own — one brand-scoped block therefore covers\n * both Light and Dark. The few aliases that point at primitives are\n * theme-fixed by design and commented as such.\n *\n * Mapping decisions that involved judgment (design sign-off tracked in\n * the color-bridge spec):\n *   - The three legacy brand families (aqua, teal, purple) collapse into\n *     the single CADS brand family.\n *   - Legacy background ramp steps extra-light/light (and purple-hover)\n *     both map to CADS light; CADS mid is a net-new darker step. Legacy\n *     border ramps only had one \"light\" step and map to CADS light\n *     directly.\n *   - accent-strawberry maps to accent-pink (nearest CADS accent).\n *   - background-neutral-lab maps to background-neutral-primary; the\n *     legacy Dark value (#121212) equals the CADS Dark primary exactly.\n *\n * Same-name tokens whose MEANING shifted are silently owned by the CADS\n * definition and cannot be fixed here (one name, one value per scope):\n * e.g. legacy --background-error-light was a 20-level fill, CADS -light\n * is a 5-level wash (the 20-level equivalent is now -mid). Call sites\n * that need the heavier step migrate to -mid during call-site migration.\n *\n * Delete this file at brand cutover cleanup, when call sites have been\n * migrated to CADS token names.\n */\n\n/* Selector notes: the :root / [data-theme] compounds keep specificity at\n * (0,2,0) so these aliases beat the legacy colors.css declarations\n * (0,1,0) for the same names. The [data-theme] entries are required for\n * correctness, not just precedence: var() chains in custom properties\n * are substituted on the element that declares them and inherit as\n * resolved values, so the aliases must be re-declared on theme-carrying\n * elements (e.g. Lab2's nested data-theme='Dark' div) to pick up that\n * element's CADS values. */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Dark'],\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'][data-theme='Light'],\n[data-brand='codeai-audit'][data-theme='Dark'],\n[data-brand='codeai-audit'] [data-theme='Light'],\n[data-brand='codeai-audit'] [data-theme='Dark'] {\n  /* Backgrounds — brand families collapse to the CADS brand ramp */\n  --background-brand-aqua-extra-light: var(--background-brand-light);\n  --background-brand-aqua-light: var(--background-brand-light);\n  --background-brand-aqua-primary: var(--background-brand-primary);\n  --background-brand-aqua-strong: var(--background-brand-strong);\n  --background-brand-purple-extra-light: var(--background-brand-light);\n  --background-brand-purple-hover: var(--background-brand-light);\n  --background-brand-purple-light: var(--background-brand-light);\n  --background-brand-purple-primary: var(--background-brand-primary);\n\n  /* -fixed means \"same in both themes\": alias to the primitive, which is\n     theme-fixed by definition (legacy value was purple-50 in both themes) */\n  --background-brand-purple-primary-fixed: var(--brand-purple-50);\n  --background-brand-purple-strong: var(--background-brand-strong);\n  --background-brand-teal-extra-light: var(--background-brand-light);\n  --background-brand-teal-light: var(--background-brand-light);\n  --background-brand-teal-primary: var(--background-brand-primary);\n  --background-brand-teal-strong: var(--background-brand-strong);\n\n  /* Backgrounds — strawberry accent retires in favor of pink */\n  --background-accent-strawberry-light: var(--background-accent-pink-light);\n  --background-accent-strawberry-primary: var(--background-accent-pink-primary);\n  --background-accent-strawberry-strong: var(--background-accent-pink-strong);\n\n  /* Backgrounds — sentiment extra-light becomes light */\n  --background-error-extra-light: var(--background-error-light);\n  --background-info-extra-light: var(--background-info-light);\n  --background-success-extra-light: var(--background-success-light);\n  --background-warning-extra-light: var(--background-warning-light);\n\n  /* Backgrounds — neutral one-offs */\n  --background-neutral-disabled: var(--background-disabled-neutral);\n  --background-neutral-lab: var(--background-neutral-primary);\n\n  /* Borders — CADS drops the plural; brand families collapse */\n  --borders-brand-aqua-light: var(--border-brand-light);\n  --borders-brand-aqua-primary: var(--border-brand-primary);\n  --borders-brand-aqua-strong: var(--border-brand-strong);\n  --borders-brand-purple-light: var(--border-brand-light);\n  --borders-brand-purple-primary: var(--border-brand-primary);\n  --borders-brand-purple-strong: var(--border-brand-strong);\n  --borders-brand-teal-light: var(--border-brand-light);\n  --borders-brand-teal-primary: var(--border-brand-primary);\n  --borders-brand-teal-strong: var(--border-brand-strong);\n  --borders-error-light: var(--border-error-light);\n  --borders-error-primary: var(--border-error-primary);\n  --borders-error-strong: var(--border-error-strong);\n  --borders-info-light: var(--border-info-light);\n  --borders-info-primary: var(--border-info-primary);\n  --borders-info-strong: var(--border-info-strong);\n  --borders-success-light: var(--border-success-light);\n  --borders-success-primary: var(--border-success-primary);\n  --borders-success-strong: var(--border-success-strong);\n  --borders-warning-light: var(--border-warning-light);\n  --borders-warning-primary: var(--border-warning-primary);\n  --borders-warning-strong: var(--border-warning-strong);\n  --borders-neutral-disabled: var(--border-disabled-neutral);\n\n  /* legacy neutral border ramp light(gray-10)/primary(gray-20)/strong(gray-40)\n     lands on the CADS primary/secondary pair; light has no lighter CADS\n     step and joins primary */\n  --borders-neutral-light: var(--border-neutral-primary);\n  --borders-neutral-primary: var(--border-neutral-primary);\n  --borders-neutral-solid: var(--border-neutral-solid);\n  --borders-neutral-strong: var(--border-neutral-secondary);\n  --borders-neutral-white-fixed: var(--border-neutral-white-fixed);\n\n  /* Text — brand families collapse */\n  --text-brand-aqua-primary: var(--text-brand-primary);\n  --text-brand-aqua-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-aqua-secondary: var(--text-brand-secondary);\n  --text-brand-purple-primary: var(--text-brand-primary);\n  --text-brand-purple-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-purple-secondary: var(--text-brand-secondary);\n  --text-brand-teal-primary: var(--text-brand-primary);\n  --text-brand-teal-primary-fixed: var(--text-brand-primary-fixed);\n  --text-brand-teal-secondary: var(--text-brand-secondary);\n\n  /* Text — renamed neutrals */\n  --text-neutral-disabled: var(--text-disabled-neutral);\n  --text-neutral-disabled-inverse: var(--text-disabled-neutral-inverse);\n  --text-neutral-inverse: var(--text-neutral-primary-inverse);\n}\n\n/* Legacy primitives with no CADS successor. Direct primitive usage is\n   rare (~30 call sites for the colored families) but must not fall\n   through to the legacy :root values under this brand. Same-step\n   mapping into the successor family; step 100 retires, CADS tops out\n   at 95. Colliding primitive names (neutral-*, sentiment-* 5–90,\n   brand-purple-5–90) are already redefined by the brand's own token\n   file (brandCodeAiNext.css, brandCodeAiAudit.css).\n\n   Unlike the aliases above, primitives do not vary by theme, so this\n   one root-level block covers both. Do not re-declare these rows on\n   [data-theme] elements: brandLegacyShim.css defines the same pairs\n   in the opposite direction there (--brand-orange-60 from\n   --accent-orange-60), and when both directions apply to the same\n   element, CSS treats the definitions as circular and blanks both\n   variables. */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'],\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'] {\n  --brand-aqua-10: var(--brand-purple-10);\n  --brand-aqua-20: var(--brand-purple-20);\n  --brand-aqua-30: var(--brand-purple-30);\n  --brand-aqua-40: var(--brand-purple-40);\n  --brand-aqua-50: var(--brand-purple-50);\n  --brand-aqua-60: var(--brand-purple-60);\n  --brand-aqua-70: var(--brand-purple-70);\n  --brand-aqua-80: var(--brand-purple-80);\n  --brand-aqua-90: var(--brand-purple-90);\n  --brand-aqua-100: var(--brand-purple-95);\n  --brand-teal-5: var(--brand-purple-5);\n  --brand-teal-10: var(--brand-purple-10);\n  --brand-teal-20: var(--brand-purple-20);\n  --brand-teal-30: var(--brand-purple-30);\n  --brand-teal-40: var(--brand-purple-40);\n  --brand-teal-50: var(--brand-purple-50);\n  --brand-teal-60: var(--brand-purple-60);\n  --brand-teal-70: var(--brand-purple-70);\n  --brand-teal-80: var(--brand-purple-80);\n  --brand-teal-90: var(--brand-purple-90);\n  --brand-teal-100: var(--brand-purple-95);\n  --brand-purple-100: var(--brand-purple-95);\n  --accent-strawberry-10: var(--brand-pink-10);\n  --accent-strawberry-20: var(--brand-pink-20);\n  --accent-strawberry-30: var(--brand-pink-30);\n  --accent-strawberry-40: var(--brand-pink-40);\n  --accent-strawberry-50: var(--brand-pink-50);\n  --accent-strawberry-60: var(--brand-pink-60);\n  --accent-strawberry-70: var(--brand-pink-70);\n  --accent-strawberry-80: var(--brand-pink-80);\n  --accent-strawberry-90: var(--brand-pink-90);\n  --accent-strawberry-100: var(--brand-pink-95);\n  --accent-orange-10: var(--brand-orange-10);\n  --accent-orange-20: var(--brand-orange-20);\n  --accent-orange-30: var(--brand-orange-30);\n  --accent-orange-40: var(--brand-orange-40);\n  --accent-orange-50: var(--brand-orange-50);\n  --accent-orange-60: var(--brand-orange-60);\n  --accent-orange-70: var(--brand-orange-70);\n  --accent-orange-80: var(--brand-orange-80);\n  --accent-orange-90: var(--brand-orange-90);\n  --accent-orange-100: var(--brand-orange-95);\n\n  /* legacy gray-99 (#121212) equals the CADS base black exactly */\n  --neutral-gray-99: var(--neutral-base-black);\n  --sentiment-error-100: var(--sentiment-error-95);\n  --sentiment-information-100: var(--sentiment-information-95);\n  --sentiment-success-100: var(--sentiment-success-95);\n  --sentiment-warning-100: var(--sentiment-warning-95);\n}\n"],sourceRoot:""}]);const l=i},773:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,"/* CADS token names under the legacy brands.\n *\n * Code migrated to the CADS token schema (colors_codeAi.css) before the\n * brand cutover must still render under the legacy brands ('code',\n * 'codeai'), where only the colors.css tokens exist. This file defines\n * every CADS-only token name in terms of its nearest legacy equivalent.\n * CADS names that also exist in the legacy schema (most neutrals and\n * sentiment primaries) are already defined by colors.css and are not\n * listed.\n *\n * This is a best-effort visual bridge, not a design statement:\n *   - the CADS brand family maps to legacy teal (the legacy brand\n *     primary); CADS light/mid map to legacy extra-light/light;\n *   - all CADS disabled-<family> tokens collapse onto the single legacy\n *     neutral disabled tokens;\n *   - selected-* and accent mids have no legacy semantic equivalent and\n *     point at legacy primitives (theme-fixed, commented below);\n *   - accent-pink maps to legacy strawberry.\n *\n * Rows that reference legacy SEMANTIC tokens follow Light/Dark\n * automatically; rows that reference legacy primitives do not, which is\n * acceptable for a pre-cutover shim (dark mode ships with the CADS\n * schema, not the legacy one).\n *\n * Under both CADS brands every one of these names is re-declared at\n * higher specificity by the brand's own token file — brandCodeAiNext.css\n * for codeai-next, brandCodeAiAudit.css for codeai-audit — so this file\n * is inert there. That is what keeps the audit brand honest: were any\n * CADS name to fall through to this shim, it would render its real\n * legacy color under an audit that claims every token is pink.\n * Delete this file at brand cutover cleanup.\n *\n * The [data-theme] selectors exist because custom properties substitute\n * their var() chains on the declaring element and inherit as resolved\n * values: without re-declaration on theme-carrying elements, a dark\n * subtree would inherit light-resolved values from <html>.\n */\n\n:root,\n[data-theme='Light'],\n[data-theme='Dark'] {\n  /* Backgrounds — alpha scale (dark overrides below) */\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n\n  /* Backgrounds — brand (legacy brand primary is teal) */\n  --background-brand-primary: var(--background-brand-teal-primary);\n  --background-brand-light: var(--background-brand-teal-extra-light);\n  --background-brand-mid: var(--background-brand-teal-light);\n  --background-brand-strong: var(--background-brand-teal-strong);\n\n  /* Backgrounds — sentiment mid steps (legacy called this step light) */\n  --background-error-mid: var(--background-error-light);\n  --background-warning-mid: var(--background-warning-light);\n  --background-success-mid: var(--background-success-light);\n  --background-info-mid: var(--background-info-light);\n\n  /* Backgrounds — selected state (no legacy equivalent; teal fill). The\n     inverse is the legacy selected-menu glyph box: white on the teal\n     row (paired with a teal check via text-selected-primary-inverse). */\n  --background-selected-primary: var(--background-brand-teal-strong);\n  --background-selected-strong: var(\n    --brand-teal-80\n  ); /* primitive: theme-fixed */\n\n  --background-selected-primary-inverse: var(--background-neutral-white-fixed);\n\n  /* Backgrounds — disabled family collapses onto legacy neutral disabled */\n  --background-disabled-brand: var(--background-neutral-disabled);\n  --background-disabled-error: var(--background-neutral-disabled);\n  --background-disabled-info: var(--background-neutral-disabled);\n  --background-disabled-neutral: var(--background-neutral-disabled);\n  --background-disabled-orange: var(--background-neutral-disabled);\n  --background-disabled-pink: var(--background-neutral-disabled);\n  --background-disabled-success: var(--background-neutral-disabled);\n  --background-disabled-warning: var(--background-neutral-disabled);\n\n  /* Backgrounds — accents (pink maps to legacy strawberry) */\n  --background-accent-orange-mid: var(\n    --accent-orange-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-primary: var(--background-accent-strawberry-primary);\n  --background-accent-pink-light: var(--background-accent-strawberry-light);\n  --background-accent-pink-mid: var(\n    --accent-strawberry-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-strong: var(--background-accent-strawberry-strong);\n\n  /* Borders — CADS drops the plural */\n  --border-neutral-primary: var(--borders-neutral-primary);\n  --border-neutral-secondary: var(--borders-neutral-strong);\n  --border-neutral-solid: var(--borders-neutral-solid);\n  --border-neutral-white-fixed: var(--borders-neutral-white-fixed);\n  --border-neutral-black-fixed: var(\n    --neutral-base-black\n  ); /* primitive: theme-fixed */\n\n  --border-brand-primary: var(--borders-brand-teal-primary);\n  --border-brand-light: var(--borders-brand-teal-light);\n  --border-brand-mid: var(--brand-teal-20); /* primitive: theme-fixed */\n  --border-brand-strong: var(--borders-brand-teal-strong);\n  --border-error-primary: var(--borders-error-primary);\n  --border-error-light: var(--borders-error-light);\n  --border-error-mid: var(--sentiment-error-30); /* primitive: theme-fixed */\n  --border-error-strong: var(--borders-error-strong);\n  --border-warning-primary: var(--borders-warning-primary);\n  --border-warning-light: var(--borders-warning-light);\n  --border-warning-mid: var(\n    --sentiment-warning-30\n  ); /* primitive: theme-fixed */\n\n  --border-warning-strong: var(--borders-warning-strong);\n  --border-success-primary: var(--borders-success-primary);\n  --border-success-light: var(--borders-success-light);\n  --border-success-mid: var(\n    --sentiment-success-30\n  ); /* primitive: theme-fixed */\n\n  --border-success-strong: var(--borders-success-strong);\n  --border-info-primary: var(--borders-info-primary);\n  --border-info-light: var(--borders-info-light);\n  --border-info-mid: var(\n    --sentiment-information-30\n  ); /* primitive: theme-fixed */\n\n  --border-info-strong: var(--borders-info-strong);\n  --border-selected-primary: var(--borders-brand-teal-strong);\n  --border-selected-strong: var(--brand-teal-80); /* primitive: theme-fixed */\n  --border-selected-primary-inverse: var(--borders-neutral-white-fixed);\n\n  /* Focus ring: legacy teal; inverse ring (on a selected fill) goes\n     white to contrast. */\n  --border-focused-primary: var(--borders-brand-teal-primary);\n  --border-focused-inverse: var(--borders-neutral-white-fixed);\n  --border-disabled-brand: var(--borders-neutral-disabled);\n  --border-disabled-error: var(--borders-neutral-disabled);\n  --border-disabled-info: var(--borders-neutral-disabled);\n  --border-disabled-neutral: var(--borders-neutral-disabled);\n  --border-disabled-orange: var(--borders-neutral-disabled);\n  --border-disabled-pink: var(--borders-neutral-disabled);\n  --border-disabled-success: var(--borders-neutral-disabled);\n  --border-disabled-warning: var(--borders-neutral-disabled);\n\n  /* Accent borders mirror the CADS ramp steps on legacy primitives\n     (theme-fixed); legacy had no semantic accent borders. */\n  --border-accent-orange-primary: var(--accent-orange-50);\n  --border-accent-orange-light: var(--accent-orange-30);\n  --border-accent-orange-mid: var(--accent-orange-30);\n  --border-accent-orange-strong: var(--accent-orange-70);\n  --border-accent-pink-primary: var(--accent-strawberry-50);\n  --border-accent-pink-light: var(--accent-strawberry-30);\n  --border-accent-pink-mid: var(--accent-strawberry-30);\n  --border-accent-pink-strong: var(--accent-strawberry-70);\n\n  /* Text */\n  --text-neutral-primary-inverse: var(--text-neutral-inverse);\n  --text-brand-primary: var(--text-brand-teal-primary);\n  --text-brand-secondary: var(--text-brand-teal-secondary);\n  --text-brand-primary-fixed: var(--text-brand-teal-primary-fixed);\n  --text-selected-primary: var(--text-neutral-inverse);\n  --text-selected-primary-inverse: var(--text-brand-teal-primary);\n  --text-disabled-brand: var(--text-neutral-disabled);\n  --text-disabled-error: var(--text-neutral-disabled);\n  --text-disabled-info: var(--text-neutral-disabled);\n  --text-disabled-neutral: var(--text-neutral-disabled);\n  --text-disabled-neutral-inverse: var(--text-neutral-disabled-inverse);\n  --text-disabled-orange: var(--text-neutral-disabled);\n  --text-disabled-pink: var(--text-neutral-disabled);\n  --text-disabled-success: var(--text-neutral-disabled);\n  --text-disabled-warning: var(--text-neutral-disabled);\n\n  /* Accent text on legacy primitives (theme-fixed); orange sits at the\n     60 step, the darkest orange in legacy text use. */\n  --text-accent-orange-primary: var(--accent-orange-60);\n  --text-accent-orange-secondary: var(--accent-orange-80);\n  --text-accent-orange-primary-fixed: var(--accent-orange-60);\n  --text-accent-pink-primary: var(--accent-strawberry-50);\n  --text-accent-pink-secondary: var(--accent-strawberry-70);\n  --text-accent-pink-primary-fixed: var(--accent-strawberry-50);\n\n  /* CADS-only primitives with no legacy name at all (direct primitive\n     usage is rare and currently unused, but must not fall through to an\n     unresolved var() under this brand). Same-step mapping into the\n     nearest legacy family; legacy's extra \"100\" step (which CADS dropped)\n     absorbs CADS's \"95\" step, mirroring the reverse mapping in\n     brandLegacyAliases.css. brand-orange has no legacy brand\n     counterpart, so it maps to legacy's accent-orange; brand-pink maps to\n     accent-strawberry, same as the pink/strawberry semantic mapping\n     above. */\n  --brand-purple-95: var(--brand-purple-100);\n  --brand-orange-5: var(--accent-orange-10);\n  --brand-orange-10: var(--accent-orange-10);\n  --brand-orange-20: var(--accent-orange-20);\n  --brand-orange-30: var(--accent-orange-30);\n  --brand-orange-40: var(--accent-orange-40);\n  --brand-orange-50: var(--accent-orange-50);\n  --brand-orange-60: var(--accent-orange-60);\n  --brand-orange-70: var(--accent-orange-70);\n  --brand-orange-80: var(--accent-orange-80);\n  --brand-orange-90: var(--accent-orange-90);\n  --brand-orange-95: var(--accent-orange-100);\n  --brand-pink-5: var(--accent-strawberry-10);\n  --brand-pink-10: var(--accent-strawberry-10);\n  --brand-pink-20: var(--accent-strawberry-20);\n  --brand-pink-30: var(--accent-strawberry-30);\n  --brand-pink-40: var(--accent-strawberry-40);\n  --brand-pink-50: var(--accent-strawberry-50);\n  --brand-pink-60: var(--accent-strawberry-60);\n  --brand-pink-70: var(--accent-strawberry-70);\n  --brand-pink-80: var(--accent-strawberry-80);\n  --brand-pink-90: var(--accent-strawberry-90);\n  --brand-pink-95: var(--accent-strawberry-100);\n  --sentiment-error-5: var(--sentiment-error-10);\n  --sentiment-error-95: var(--sentiment-error-100);\n  --sentiment-information-5: var(--sentiment-information-10);\n  --sentiment-information-95: var(--sentiment-information-100);\n  --sentiment-success-5: var(--sentiment-success-10);\n  --sentiment-success-95: var(--sentiment-success-100);\n  --sentiment-warning-5: var(--sentiment-warning-10);\n  --sentiment-warning-95: var(--sentiment-warning-100);\n}\n\n/* Dark: the alpha scale flips to white, mirroring the CADS dark block. */\n[data-theme='Dark'] {\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n}\n","",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/brandLegacyShim.css"],names:[],mappings:"AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EAoCE;;AAEF;;;EAGE,qDAAqD;EACrD,0DAA0D;EAC1D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;;EAE5D,uDAAuD;EACvD,gEAAgE;EAChE,kEAAkE;EAClE,0DAA0D;EAC1D,8DAA8D;;EAE9D,sEAAsE;EACtE,qDAAqD;EACrD,yDAAyD;EACzD,yDAAyD;EACzD,mDAAmD;;EAEnD;;wEAEsE;EACtE,kEAAkE;EAClE;;GAEC,EAAE,2BAA2B;;EAE9B,4EAA4E;;EAE5E,yEAAyE;EACzE,+DAA+D;EAC/D,+DAA+D;EAC/D,8DAA8D;EAC9D,iEAAiE;EACjE,gEAAgE;EAChE,8DAA8D;EAC9D,iEAAiE;EACjE,iEAAiE;;EAEjE,2DAA2D;EAC3D;;GAEC,EAAE,2BAA2B;;EAE9B,6EAA6E;EAC7E,yEAAyE;EACzE;;GAEC,EAAE,2BAA2B;;EAE9B,2EAA2E;;EAE3E,oCAAoC;EACpC,wDAAwD;EACxD,yDAAyD;EACzD,oDAAoD;EACpD,gEAAgE;EAChE;;GAEC,EAAE,2BAA2B;;EAE9B,yDAAyD;EACzD,qDAAqD;EACrD,wCAAwC,EAAE,2BAA2B;EACrE,uDAAuD;EACvD,oDAAoD;EACpD,gDAAgD;EAChD,6CAA6C,EAAE,2BAA2B;EAC1E,kDAAkD;EAClD,wDAAwD;EACxD,oDAAoD;EACpD;;GAEC,EAAE,2BAA2B;;EAE9B,sDAAsD;EACtD,wDAAwD;EACxD,oDAAoD;EACpD;;GAEC,EAAE,2BAA2B;;EAE9B,sDAAsD;EACtD,kDAAkD;EAClD,8CAA8C;EAC9C;;GAEC,EAAE,2BAA2B;;EAE9B,gDAAgD;EAChD,2DAA2D;EAC3D,8CAA8C,EAAE,2BAA2B;EAC3E,qEAAqE;;EAErE;yBACuB;EACvB,2DAA2D;EAC3D,4DAA4D;EAC5D,wDAAwD;EACxD,wDAAwD;EACxD,uDAAuD;EACvD,0DAA0D;EAC1D,yDAAyD;EACzD,uDAAuD;EACvD,0DAA0D;EAC1D,0DAA0D;;EAE1D;4DAC0D;EAC1D,uDAAuD;EACvD,qDAAqD;EACrD,mDAAmD;EACnD,sDAAsD;EACtD,yDAAyD;EACzD,uDAAuD;EACvD,qDAAqD;EACrD,wDAAwD;;EAExD,SAAS;EACT,2DAA2D;EAC3D,oDAAoD;EACpD,wDAAwD;EACxD,gEAAgE;EAChE,oDAAoD;EACpD,+DAA+D;EAC/D,mDAAmD;EACnD,mDAAmD;EACnD,kDAAkD;EAClD,qDAAqD;EACrD,qEAAqE;EACrE,oDAAoD;EACpD,kDAAkD;EAClD,qDAAqD;EACrD,qDAAqD;;EAErD;sDACoD;EACpD,qDAAqD;EACrD,uDAAuD;EACvD,2DAA2D;EAC3D,uDAAuD;EACvD,yDAAyD;EACzD,6DAA6D;;EAE7D;;;;;;;;aAQW;EACX,0CAA0C;EAC1C,yCAAyC;EACzC,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,2CAA2C;EAC3C,2CAA2C;EAC3C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,6CAA6C;EAC7C,8CAA8C;EAC9C,gDAAgD;EAChD,0DAA0D;EAC1D,4DAA4D;EAC5D,kDAAkD;EAClD,oDAAoD;EACpD,kDAAkD;EAClD,oDAAoD;AACtD;;AAEA,yEAAyE;AACzE;EACE,0DAA0D;EAC1D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;AAC9D",sourcesContent:["/* CADS token names under the legacy brands.\n *\n * Code migrated to the CADS token schema (colors_codeAi.css) before the\n * brand cutover must still render under the legacy brands ('code',\n * 'codeai'), where only the colors.css tokens exist. This file defines\n * every CADS-only token name in terms of its nearest legacy equivalent.\n * CADS names that also exist in the legacy schema (most neutrals and\n * sentiment primaries) are already defined by colors.css and are not\n * listed.\n *\n * This is a best-effort visual bridge, not a design statement:\n *   - the CADS brand family maps to legacy teal (the legacy brand\n *     primary); CADS light/mid map to legacy extra-light/light;\n *   - all CADS disabled-<family> tokens collapse onto the single legacy\n *     neutral disabled tokens;\n *   - selected-* and accent mids have no legacy semantic equivalent and\n *     point at legacy primitives (theme-fixed, commented below);\n *   - accent-pink maps to legacy strawberry.\n *\n * Rows that reference legacy SEMANTIC tokens follow Light/Dark\n * automatically; rows that reference legacy primitives do not, which is\n * acceptable for a pre-cutover shim (dark mode ships with the CADS\n * schema, not the legacy one).\n *\n * Under both CADS brands every one of these names is re-declared at\n * higher specificity by the brand's own token file — brandCodeAiNext.css\n * for codeai-next, brandCodeAiAudit.css for codeai-audit — so this file\n * is inert there. That is what keeps the audit brand honest: were any\n * CADS name to fall through to this shim, it would render its real\n * legacy color under an audit that claims every token is pink.\n * Delete this file at brand cutover cleanup.\n *\n * The [data-theme] selectors exist because custom properties substitute\n * their var() chains on the declaring element and inherit as resolved\n * values: without re-declaration on theme-carrying elements, a dark\n * subtree would inherit light-resolved values from <html>.\n */\n\n:root,\n[data-theme='Light'],\n[data-theme='Dark'] {\n  /* Backgrounds — alpha scale (dark overrides below) */\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n\n  /* Backgrounds — brand (legacy brand primary is teal) */\n  --background-brand-primary: var(--background-brand-teal-primary);\n  --background-brand-light: var(--background-brand-teal-extra-light);\n  --background-brand-mid: var(--background-brand-teal-light);\n  --background-brand-strong: var(--background-brand-teal-strong);\n\n  /* Backgrounds — sentiment mid steps (legacy called this step light) */\n  --background-error-mid: var(--background-error-light);\n  --background-warning-mid: var(--background-warning-light);\n  --background-success-mid: var(--background-success-light);\n  --background-info-mid: var(--background-info-light);\n\n  /* Backgrounds — selected state (no legacy equivalent; teal fill). The\n     inverse is the legacy selected-menu glyph box: white on the teal\n     row (paired with a teal check via text-selected-primary-inverse). */\n  --background-selected-primary: var(--background-brand-teal-strong);\n  --background-selected-strong: var(\n    --brand-teal-80\n  ); /* primitive: theme-fixed */\n\n  --background-selected-primary-inverse: var(--background-neutral-white-fixed);\n\n  /* Backgrounds — disabled family collapses onto legacy neutral disabled */\n  --background-disabled-brand: var(--background-neutral-disabled);\n  --background-disabled-error: var(--background-neutral-disabled);\n  --background-disabled-info: var(--background-neutral-disabled);\n  --background-disabled-neutral: var(--background-neutral-disabled);\n  --background-disabled-orange: var(--background-neutral-disabled);\n  --background-disabled-pink: var(--background-neutral-disabled);\n  --background-disabled-success: var(--background-neutral-disabled);\n  --background-disabled-warning: var(--background-neutral-disabled);\n\n  /* Backgrounds — accents (pink maps to legacy strawberry) */\n  --background-accent-orange-mid: var(\n    --accent-orange-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-primary: var(--background-accent-strawberry-primary);\n  --background-accent-pink-light: var(--background-accent-strawberry-light);\n  --background-accent-pink-mid: var(\n    --accent-strawberry-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-strong: var(--background-accent-strawberry-strong);\n\n  /* Borders — CADS drops the plural */\n  --border-neutral-primary: var(--borders-neutral-primary);\n  --border-neutral-secondary: var(--borders-neutral-strong);\n  --border-neutral-solid: var(--borders-neutral-solid);\n  --border-neutral-white-fixed: var(--borders-neutral-white-fixed);\n  --border-neutral-black-fixed: var(\n    --neutral-base-black\n  ); /* primitive: theme-fixed */\n\n  --border-brand-primary: var(--borders-brand-teal-primary);\n  --border-brand-light: var(--borders-brand-teal-light);\n  --border-brand-mid: var(--brand-teal-20); /* primitive: theme-fixed */\n  --border-brand-strong: var(--borders-brand-teal-strong);\n  --border-error-primary: var(--borders-error-primary);\n  --border-error-light: var(--borders-error-light);\n  --border-error-mid: var(--sentiment-error-30); /* primitive: theme-fixed */\n  --border-error-strong: var(--borders-error-strong);\n  --border-warning-primary: var(--borders-warning-primary);\n  --border-warning-light: var(--borders-warning-light);\n  --border-warning-mid: var(\n    --sentiment-warning-30\n  ); /* primitive: theme-fixed */\n\n  --border-warning-strong: var(--borders-warning-strong);\n  --border-success-primary: var(--borders-success-primary);\n  --border-success-light: var(--borders-success-light);\n  --border-success-mid: var(\n    --sentiment-success-30\n  ); /* primitive: theme-fixed */\n\n  --border-success-strong: var(--borders-success-strong);\n  --border-info-primary: var(--borders-info-primary);\n  --border-info-light: var(--borders-info-light);\n  --border-info-mid: var(\n    --sentiment-information-30\n  ); /* primitive: theme-fixed */\n\n  --border-info-strong: var(--borders-info-strong);\n  --border-selected-primary: var(--borders-brand-teal-strong);\n  --border-selected-strong: var(--brand-teal-80); /* primitive: theme-fixed */\n  --border-selected-primary-inverse: var(--borders-neutral-white-fixed);\n\n  /* Focus ring: legacy teal; inverse ring (on a selected fill) goes\n     white to contrast. */\n  --border-focused-primary: var(--borders-brand-teal-primary);\n  --border-focused-inverse: var(--borders-neutral-white-fixed);\n  --border-disabled-brand: var(--borders-neutral-disabled);\n  --border-disabled-error: var(--borders-neutral-disabled);\n  --border-disabled-info: var(--borders-neutral-disabled);\n  --border-disabled-neutral: var(--borders-neutral-disabled);\n  --border-disabled-orange: var(--borders-neutral-disabled);\n  --border-disabled-pink: var(--borders-neutral-disabled);\n  --border-disabled-success: var(--borders-neutral-disabled);\n  --border-disabled-warning: var(--borders-neutral-disabled);\n\n  /* Accent borders mirror the CADS ramp steps on legacy primitives\n     (theme-fixed); legacy had no semantic accent borders. */\n  --border-accent-orange-primary: var(--accent-orange-50);\n  --border-accent-orange-light: var(--accent-orange-30);\n  --border-accent-orange-mid: var(--accent-orange-30);\n  --border-accent-orange-strong: var(--accent-orange-70);\n  --border-accent-pink-primary: var(--accent-strawberry-50);\n  --border-accent-pink-light: var(--accent-strawberry-30);\n  --border-accent-pink-mid: var(--accent-strawberry-30);\n  --border-accent-pink-strong: var(--accent-strawberry-70);\n\n  /* Text */\n  --text-neutral-primary-inverse: var(--text-neutral-inverse);\n  --text-brand-primary: var(--text-brand-teal-primary);\n  --text-brand-secondary: var(--text-brand-teal-secondary);\n  --text-brand-primary-fixed: var(--text-brand-teal-primary-fixed);\n  --text-selected-primary: var(--text-neutral-inverse);\n  --text-selected-primary-inverse: var(--text-brand-teal-primary);\n  --text-disabled-brand: var(--text-neutral-disabled);\n  --text-disabled-error: var(--text-neutral-disabled);\n  --text-disabled-info: var(--text-neutral-disabled);\n  --text-disabled-neutral: var(--text-neutral-disabled);\n  --text-disabled-neutral-inverse: var(--text-neutral-disabled-inverse);\n  --text-disabled-orange: var(--text-neutral-disabled);\n  --text-disabled-pink: var(--text-neutral-disabled);\n  --text-disabled-success: var(--text-neutral-disabled);\n  --text-disabled-warning: var(--text-neutral-disabled);\n\n  /* Accent text on legacy primitives (theme-fixed); orange sits at the\n     60 step, the darkest orange in legacy text use. */\n  --text-accent-orange-primary: var(--accent-orange-60);\n  --text-accent-orange-secondary: var(--accent-orange-80);\n  --text-accent-orange-primary-fixed: var(--accent-orange-60);\n  --text-accent-pink-primary: var(--accent-strawberry-50);\n  --text-accent-pink-secondary: var(--accent-strawberry-70);\n  --text-accent-pink-primary-fixed: var(--accent-strawberry-50);\n\n  /* CADS-only primitives with no legacy name at all (direct primitive\n     usage is rare and currently unused, but must not fall through to an\n     unresolved var() under this brand). Same-step mapping into the\n     nearest legacy family; legacy's extra \"100\" step (which CADS dropped)\n     absorbs CADS's \"95\" step, mirroring the reverse mapping in\n     brandLegacyAliases.css. brand-orange has no legacy brand\n     counterpart, so it maps to legacy's accent-orange; brand-pink maps to\n     accent-strawberry, same as the pink/strawberry semantic mapping\n     above. */\n  --brand-purple-95: var(--brand-purple-100);\n  --brand-orange-5: var(--accent-orange-10);\n  --brand-orange-10: var(--accent-orange-10);\n  --brand-orange-20: var(--accent-orange-20);\n  --brand-orange-30: var(--accent-orange-30);\n  --brand-orange-40: var(--accent-orange-40);\n  --brand-orange-50: var(--accent-orange-50);\n  --brand-orange-60: var(--accent-orange-60);\n  --brand-orange-70: var(--accent-orange-70);\n  --brand-orange-80: var(--accent-orange-80);\n  --brand-orange-90: var(--accent-orange-90);\n  --brand-orange-95: var(--accent-orange-100);\n  --brand-pink-5: var(--accent-strawberry-10);\n  --brand-pink-10: var(--accent-strawberry-10);\n  --brand-pink-20: var(--accent-strawberry-20);\n  --brand-pink-30: var(--accent-strawberry-30);\n  --brand-pink-40: var(--accent-strawberry-40);\n  --brand-pink-50: var(--accent-strawberry-50);\n  --brand-pink-60: var(--accent-strawberry-60);\n  --brand-pink-70: var(--accent-strawberry-70);\n  --brand-pink-80: var(--accent-strawberry-80);\n  --brand-pink-90: var(--accent-strawberry-90);\n  --brand-pink-95: var(--accent-strawberry-100);\n  --sentiment-error-5: var(--sentiment-error-10);\n  --sentiment-error-95: var(--sentiment-error-100);\n  --sentiment-information-5: var(--sentiment-information-10);\n  --sentiment-information-95: var(--sentiment-information-100);\n  --sentiment-success-5: var(--sentiment-success-10);\n  --sentiment-success-95: var(--sentiment-success-100);\n  --sentiment-warning-5: var(--sentiment-warning-10);\n  --sentiment-warning-95: var(--sentiment-warning-100);\n}\n\n/* Dark: the alpha scale flips to white, mirroring the CADS dark block. */\n[data-theme='Dark'] {\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n}\n"],sourceRoot:""}]);const l=i},769:(e,t,n)=>{"use strict";n.d(t,{A:()=>p});var r=n(12),o=n.n(r),a=n(13),i=n.n(a),l=n(773),s=n(774),c=n(775),d=n(776),u=i()(o());u.i(l.A),u.i(s.A),u.i(c.A),u.i(d.A),u.push([e.id,"/* Brand override layers. Import once, immediately after colors.css.\n *\n * Layering (see frontend/packages/component-library/src/themes/README.md):\n *   primitiveColors.css + colors.css   legacy tokens, :root — the pre-cutover default\n *   brandLegacyShim.css                CADS token names mapped onto legacy values,\n *                                      so migrated code renders under legacy brands\n *   brandCodeAiNext.css                canonical CADS tokens scoped to\n *                                      [data-brand='codeai-next'] (generated —\n *                                      see scripts/generateBrandCodeAiNext.mjs)\n *   brandCodeAiAudit.css               the same CADS tokens with every primitive\n *                                      swapped for a pink, scoped to\n *                                      [data-brand='codeai-audit'] (generated —\n *                                      see scripts/generateBrandCodeAiAudit.mjs)\n *   brandLegacyAliases.css             legacy token names mapped onto CADS values\n *                                      under both CADS brands, so unmigrated code\n *                                      is rebranded (and, under codeai-audit, pink)\n *\n * Order does not affect the result: custom properties substitute their\n * var() chains after the cascade, and no two of these files declare the\n * same token name in the same scope.\n *\n * Cleanup, once call sites use CADS token names: delete colors.css,\n * primitiveColors.css, brandLegacyShim.css and brandLegacyAliases.css,\n * and promote the canonical CADS files to :root. The audit brand needs\n * no changes at that point — it is already CADS-only.\n */\n","",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/brandOverrides.css"],names:[],mappings:"AAAA;;;;;;;;;;;;;;;;;;;;;;;;;EAyBE",sourcesContent:["/* Brand override layers. Import once, immediately after colors.css.\n *\n * Layering (see frontend/packages/component-library/src/themes/README.md):\n *   primitiveColors.css + colors.css   legacy tokens, :root — the pre-cutover default\n *   brandLegacyShim.css                CADS token names mapped onto legacy values,\n *                                      so migrated code renders under legacy brands\n *   brandCodeAiNext.css                canonical CADS tokens scoped to\n *                                      [data-brand='codeai-next'] (generated —\n *                                      see scripts/generateBrandCodeAiNext.mjs)\n *   brandCodeAiAudit.css               the same CADS tokens with every primitive\n *                                      swapped for a pink, scoped to\n *                                      [data-brand='codeai-audit'] (generated —\n *                                      see scripts/generateBrandCodeAiAudit.mjs)\n *   brandLegacyAliases.css             legacy token names mapped onto CADS values\n *                                      under both CADS brands, so unmigrated code\n *                                      is rebranded (and, under codeai-audit, pink)\n *\n * Order does not affect the result: custom properties substitute their\n * var() chains after the cascade, and no two of these files declare the\n * same token name in the same scope.\n *\n * Cleanup, once call sites use CADS token names: delete colors.css,\n * primitiveColors.css, brandLegacyShim.css and brandLegacyAliases.css,\n * and promote the canonical CADS files to :root. The audit brand needs\n * no changes at that point — it is already CADS-only.\n */\n@import './brandLegacyShim.css';\n@import './brandCodeAiNext.css';\n@import './brandCodeAiAudit.css';\n@import './brandLegacyAliases.css';\n"],sourceRoot:""}]);const p=u},768:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,"/* This file consists of Semantic colors,\n if you need DSCO colors with support of multiple themes, you need to import and use this file.\n */\n\n/* Colors are taken from DSCO Variables New Figma File - Semantic colors colors variables collection\n via variables2css plugin that generates css code based on Figma variables values and names.\n We're using css here in order to support not only scss, but also css files.\n Also, stylelint fix might be required for autogenerated colors, which can be done in one command.\n */\n\n/* Semantic Colors */\n\n/* Semantic colors values are taken from Primitive Colors (primitiveColors.css).\n Semantic color value is specified for every theme, meaning that unlike Primitive Colors (primitiveColors.css), Semantic colors are meant to be different for every theme.\n */\n\n/* Light theme Semantic colors \n(Light theme is a default one, that's why here's also :root rule)\n*/\n:root,\n[data-theme='Light'] {\n  --background-accent-orange-light: var(--accent-orange-10);\n  --background-accent-orange-primary: var(--accent-orange-50);\n  --background-accent-orange-strong: var(--accent-orange-70);\n  --background-accent-strawberry-light: var(--accent-strawberry-10);\n  --background-accent-strawberry-primary: var(--accent-strawberry-50);\n  --background-accent-strawberry-strong: var(--accent-strawberry-70);\n  --background-brand-aqua-extra-light: var(--brand-aqua-10);\n  --background-brand-aqua-light: var(--brand-aqua-20);\n  --background-brand-aqua-primary: var(--brand-aqua-50);\n  --background-brand-aqua-strong: var(--brand-aqua-70);\n  --background-brand-purple-extra-light: var(--brand-purple-5);\n  --background-brand-purple-hover: var(--brand-purple-10);\n  --background-brand-purple-light: var(--brand-purple-10);\n  --background-brand-purple-primary: var(--brand-purple-50);\n  --background-brand-purple-primary-fixed: var(--brand-purple-50);\n  --background-brand-purple-strong: var(--brand-purple-70);\n  --background-brand-teal-extra-light: var(--brand-teal-5);\n  --background-brand-teal-light: var(--brand-teal-10);\n  --background-brand-teal-primary: var(--brand-teal-60);\n  --background-brand-teal-strong: var(--brand-teal-70);\n  --background-error-extra-light: var(--sentiment-error-10);\n  --background-error-light: var(--sentiment-error-20);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-info-extra-light: var(--sentiment-information-10);\n  --background-info-light: var(--sentiment-information-20);\n  --background-info-primary: var(--sentiment-information-50);\n  --background-info-strong: var(--sentiment-information-70);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-disabled: var(--neutral-gray-20);\n  --background-neutral-lab: var(--neutral-base-white);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-true-base: var(--neutral-base-white);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-success-extra-light: var(--sentiment-success-10);\n  --background-success-light: var(--sentiment-success-20);\n  --background-success-primary: var(--sentiment-success-50);\n  --background-success-strong: var(--sentiment-success-70);\n  --background-warning-extra-light: var(--sentiment-warning-10);\n  --background-warning-light: var(--sentiment-warning-20);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-strong: var(--sentiment-warning-70);\n  --borders-brand-aqua-light: var(--brand-aqua-10);\n  --borders-brand-aqua-primary: var(--brand-aqua-50);\n  --borders-brand-aqua-strong: var(--brand-aqua-70);\n  --borders-brand-purple-light: var(--brand-purple-10);\n  --borders-brand-purple-primary: var(--brand-purple-50);\n  --borders-brand-purple-strong: var(--brand-purple-70);\n  --borders-brand-teal-light: var(--brand-teal-10);\n  --borders-brand-teal-primary: var(--brand-teal-50);\n  --borders-brand-teal-strong: var(--brand-teal-70);\n  --borders-error-light: var(--sentiment-error-10);\n  --borders-error-primary: var(--sentiment-error-50);\n  --borders-error-strong: var(--sentiment-error-70);\n  --borders-info-light: var(--sentiment-information-10);\n  --borders-info-primary: var(--sentiment-information-50);\n  --borders-info-strong: var(--sentiment-information-70);\n  --borders-neutral-disabled: var(--neutral-gray-20);\n  --borders-neutral-light: var(--neutral-gray-10);\n  --borders-neutral-primary: var(--neutral-gray-20);\n  --borders-neutral-solid: var(--neutral-base-black);\n  --borders-neutral-strong: var(--neutral-gray-40);\n  --borders-neutral-white-fixed: var(--neutral-base-white);\n  --borders-success-light: var(--sentiment-success-10);\n  --borders-success-primary: var(--sentiment-success-50);\n  --borders-success-strong: var(--sentiment-success-70);\n  --borders-warning-light: var(--sentiment-warning-10);\n  --borders-warning-primary: var(--sentiment-warning-50);\n  --borders-warning-strong: var(--sentiment-warning-70);\n  --text-brand-aqua-primary: var(--brand-aqua-60);\n  --text-brand-aqua-primary-fixed: var(--brand-aqua-60);\n  --text-brand-aqua-secondary: var(--brand-aqua-70);\n  --text-brand-purple-primary: var(--brand-purple-50);\n  --text-brand-purple-primary-fixed: var(--brand-purple-50);\n  --text-brand-purple-secondary: var(--brand-purple-70);\n  --text-brand-teal-primary: var(--brand-teal-50);\n  --text-brand-teal-primary-fixed: var(--brand-teal-50);\n  --text-brand-teal-secondary: var(--brand-teal-70);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-60);\n  --text-info-primary: var(--sentiment-information-50);\n  --text-info-primary-fixed: var(--sentiment-information-50);\n  --text-info-secondary: var(--sentiment-information-70);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-disabled: var(--neutral-gray-20);\n  --text-neutral-disabled-inverse: var(--neutral-base-white);\n  --text-neutral-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-quaternary: var(--neutral-gray-80);\n  --text-neutral-secondary: var(--neutral-gray-95);\n  --text-neutral-tertiary: var(--neutral-gray-90);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-success-primary: var(--sentiment-success-50);\n  --text-success-primary-fixed: var(--sentiment-success-50);\n  --text-success-secondary: var(--sentiment-success-70);\n  --text-warning-primary: var(--sentiment-warning-70);\n  --text-warning-primary-fixed: var(--sentiment-warning-70);\n  --text-warning-secondary: var(--sentiment-warning-70);\n}\n\n/* Dark Theme Semantic Colors */\n[data-theme='Dark'] {\n  --background-accent-orange-light: var(--accent-orange-90);\n  --background-accent-orange-primary: var(--accent-orange-50);\n  --background-accent-orange-strong: var(--accent-orange-40);\n  --background-accent-strawberry-light: var(--accent-strawberry-90);\n  --background-accent-strawberry-primary: var(--accent-strawberry-50);\n  --background-accent-strawberry-strong: var(--accent-strawberry-40);\n  --background-brand-aqua-extra-light: var(--brand-aqua-90);\n  --background-brand-aqua-light: var(--brand-aqua-80);\n  --background-brand-aqua-primary: var(--brand-aqua-50);\n  --background-brand-aqua-strong: var(--brand-aqua-40);\n  --background-brand-purple-extra-light: var(--brand-purple-90);\n  --background-brand-purple-hover: var(--brand-purple-80);\n  --background-brand-purple-light: var(--brand-purple-80);\n  --background-brand-purple-primary: var(--brand-purple-50);\n  --background-brand-purple-primary-fixed: var(--brand-purple-50);\n  --background-brand-purple-strong: var(--brand-purple-40);\n  --background-brand-teal-extra-light: var(--brand-teal-90);\n  --background-brand-teal-light: var(--brand-teal-80);\n  --background-brand-teal-primary: var(--brand-teal-60);\n  --background-brand-teal-strong: var(--brand-teal-40);\n  --background-error-extra-light: var(--sentiment-error-90);\n  --background-error-light: var(--sentiment-error-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-strong: var(--sentiment-error-40);\n  --background-info-extra-light: var(--sentiment-information-90);\n  --background-info-light: var(--sentiment-information-80);\n  --background-info-primary: var(--sentiment-information-50);\n  --background-info-strong: var(--sentiment-information-40);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-disabled: var(--neutral-gray-80);\n  --background-neutral-lab: var(--neutral-gray-99);\n  --background-neutral-octonary: var(--neutral-gray-20);\n  --background-neutral-primary: var(--neutral-base-black);\n  --background-neutral-primary-inverse: var(--neutral-base-white);\n  --background-neutral-quaternary: var(--neutral-gray-80);\n  --background-neutral-quinary: var(--neutral-gray-70);\n  --background-neutral-secondary: var(--neutral-gray-95);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-30);\n  --background-neutral-tertiary: var(--neutral-gray-90);\n  --background-neutral-true-base: var(--neutral-base-true-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-success-extra-light: var(--sentiment-success-90);\n  --background-success-light: var(--sentiment-success-80);\n  --background-success-primary: var(--sentiment-success-50);\n  --background-success-strong: var(--sentiment-success-40);\n  --background-warning-extra-light: var(--sentiment-warning-90);\n  --background-warning-light: var(--sentiment-warning-80);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-strong: var(--sentiment-warning-40);\n  --borders-brand-aqua-light: var(--brand-aqua-90);\n  --borders-brand-aqua-primary: var(--brand-aqua-40);\n  --borders-brand-aqua-stron