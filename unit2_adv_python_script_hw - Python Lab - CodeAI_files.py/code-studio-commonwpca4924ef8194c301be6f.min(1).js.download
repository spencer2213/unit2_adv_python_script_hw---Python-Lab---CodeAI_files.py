AGF,4CACE,WAAA,CAIJ,sBACE,UAAA,CACA,aAAA,CACA,YAAA,CACA,qBAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,OAAA,CACA,kBAAA,CAGF,sBACE,iBAAA,CAEA,4BACE,iBAAA,CACA,SAAA,CACA,OAAA,CACA,UAAA,CACA,oBAAA,CACA,SAAA,CACA,UAAA,CACA,gDAAA,CACA,iBAAA,CACA,eAAA,CAKF,4CACE,qBAAA,CAIJ,gCACE,YArawB,CAwa1B,sBACE,YAAA,CACA,iBAAA,CACA,aAAA,CACA,eAAA,CACA,kBAAA,CACA,qBAAA,CAGF,sBACE,mBAAA,CACA,gBAAA,CACA,6CAAA,CAGF,sBACE,uBAAA,CACA,0BAAA,CAGF,mCACE,8DAAA,CAIF,sBACE,4CAAA,CACA,8CAAA,CACA,6CAAA,CACA,2BAAA,CACA,sBAAA,CACA,kBAAA,CACA,eAAA,CAGF,sBACE,0BAAA,CACA,4CAAA,CACA,8CAAA,CACA,6CAAA,CACA,2BAAA,CACA,sBAAA,CACA,kBAAA,CACA,eAAA,CAGF,sBACE,6BAAA,CACA,YAAA,CAGF,sBACE,6CAAA,CACA,8CAAA,CACA,4BAAA,CACA,2BAAA,CACA,sBAAA,CACA,kBAAA,CACA,eAAA,CAGF,sBACE,eAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,WAAA,CAEA,kCACE,eAAA,CAIJ,sBACE,wBAAA,CACA,YAAA,CACA,WAAA,CACA,kBAAA,CACA,QAAA,CACA,iBAAA,CACA,oBAAA,CACA,qCAAA,CACA,QAAA,CACA,wCAAA,CACA,QAAA,CACA,eAAA,CACA,eAAA,CAEA,2BACE,WAAA,CACA,gBAAA,CAGF,2CACE,uDAAA,CACA,qDAAA,CACA,iBAAA,CACA,oBAAA,CACA,iCAAA,CACA,eAAA,CAGF,6BAEE,mBAAA,CACA,kEAAA,CACA,qDAAA,CACA,iBAAA,CACA,oBAAA,CACA,iCAAA,CAGF,4BACE,mDAAA,CACA,oBAAA,CAGF,4CACE,qCAAA,CACA,aAAA,CACA,aAAA,CACA,uBAAA,CACA,SAAA,CACA,oDAAA,CAKF,6BACE,qBAAA,CACA,iBAAA,CAGF,wBACE,kCAAA,CACA,eAAA,CACA,yBAAA,CAEA,0BACE,uBAAA,CAKN,sBACE,YAAA,CACA,eAAA,CAEA,6BACE,qBAAA,CACA,iBAAA,CAGF,wBACE,kCAAA,CACA,eAAA,CACA,yBAAA,CACA,iBAAA,CACA,UAAA,CACA,0BAAA,CAEA,0BACE,WAAA,CACA,uBAAA,CACA,iBAAA,CACA,sDAAA,CACA,sCAAA,CAMJ,sBACE,WAAA,CACA,YAAA,CACA,oDAAA,CAEA,yBACE,cAAA,CACA,eAAA,CACA,QAAA,CAGF,sBACE,sDAAA,CACA,mBAAA,CACA,kBAAA,CACA,YAAA,CACA,6BAAA,CACA,oBAAA,CACA,kBAAA,CAEA,wBACE,aAAA,CACA,yBAAA,CACA,eAAA,CACA,cAAA,CAKN,sBACE,WAAA,CACA,YAAA,CACA,oDAAA,CACA,kBAAA,CACA,YAAA,CACA,QAAA,CACA,eAAA,CAGF,sBACE,YAAA,CACA,sBAAA,CACA,QAAA,CACA,kBAAA,CAEA,4BACE,WAAA,CAIJ,sBACE,QAAA,CACA,SAAA,CACA,YAAA,CACA,kBAAA,CACA,cAAA,CACA,QAAA,CAEA,4BACE,WAAA,CAIJ,sBACE,gBAAA,CACA,iCAAA,CACA,yBAAA,CACA,eAAA,CAEA,wBACE,uBAAA,CACA,oBAAA,CAIJ,sBACE,WAAA,CACA,gBAAA,CACA,mDAAA,CACA,YAAA,CACA,6BAAA,CACA,sBAAA,CACA,kBAAA,CAGF,yBACE,iCAAA,CACA,cAAA,CACA,mBAAA,CACA,mCAAA,CACA,wCAAA,CACA,gBAAA,CAGF,yBACE,iCAAA,CACA,cAAA,CACA,kBAAA,CAGJ,sBACE,YAAA,CACA,gBAAA,CACA,qBAAA,CACA,kBAAA,CACA,QAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,kBAAA,CACA,QAAA,CACA,kBAAA,CAEA,yBACE,QAAA,CAGF,wBACE,QAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CACA,kBAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,kBAAA,CAGF,sBACE,YAAA,CACA,WAAA,CACA,2BAAA,CACA,qBAAA,CACA,kBAAA,CACA,QAAA,CACA,gBAAA,CACA,iBAAA,CAEA,wBACE,oBAAA,CAGF,sBACE,2DAAA,CACA,4DAAA,CAGF,sBACE,qDAAA,CACA,+CAAA,CAGF,sBACE,6DAAA,CACA,8DAAA,CAIJ,sBACE,mBAAA,CACA,gBAAA,CACA,kBAAA,CACA,OAAA,CACA,iBAAA,CACA,wDAAA,CACA,SAAA,CACA,wBACE,iCAAA,CACA,QAAA,CAEF,sBACE,wDAAA,CAGF,sBACE,+CAAA,CAGF,sBACE,uDAAA,CAIJ,sBACE,cAAA,CACA,YAAA,CACA,sBAAA,CACA,iCAAA,CAIA,wBACE,0CAAA,CACA,iBAAA,CACA,2CAAA,CAGA,mCAAA,CACA,wCAAA,CACA,iBAAA,CACA,eAAA,CACA,iDAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,WAAA,CACA,iBAAA,CACA,QAAA,CACA,iBAAA,CACA,wDAAA,CACA,uDAAA,CAGF,sBACE,YAAA,CACA,6BAAA,CACA,kBAAA,CACA,UAAA,CAGF,sBACE,cAAA,CACA,YAAA,CACA,sBAAA,CACA,iCAAA,CAGF,sBACE,wCAAA,CACA,iBAAA,CAGF,sBACE,eAAA,CACA,eAAA,CACA,qBAAA,CACA,WAAA,CACA,QAAA,CACA,UAAA,CAEA,+BACE,UAAA,CACA,eAAA,CAMJ,sBACE,gBAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","@import 'font';\n@import '@code-dot-org/component-library-styles/font';\n@import '@code-dot-org/component-library-styles/typography.module';\n@import '@code-dot-org/component-library-styles/mixins';\n\n@keyframes pulse {\n  0% {\n    transform: scale(0.9);\n  }\n  70% {\n    transform: scale(1);\n    box-shadow: 0 0 0 50px rgba(90 153 212 / 0);\n  }\n  100% {\n    transform: scale(0.9);\n    box-shadow: 0 0 0 0 rgba(90 153 212 / 0);\n  }\n}\n\n$container-width: 512;\n$header-height: 40;\n$body-height: 612;\n$fab-left: 11;\n$fab-right: 11;\n$fab-bottom: 35;\n$fab-height: 48;\n$sidebar-tooltip-z-index: 2010;\n\n:export {\n  containerHeight: $header-height + $body-height;\n  containerWidth: $container-width;\n  fabOriginX: $fab-left;\n  // magic number 16 seems to correct for borders/margins/etc.\n  fabOriginY: $fab-bottom + $fab-height + 16;\n}\n\n.fabBackgroundDrawer {\n  display: flex;\n  flex-direction: column;\n  border-right: 0.125rem solid var(--borders-neutral-strong);\n  border-left: 0.125rem solid var(--borders-neutral-strong);\n  background: var(--background-neutral-primary);\n  flex: 1;\n  overflow-x: hidden;\n  overflow-y: auto;\n\n  &:last-child {\n    border-radius: 0 0 0.25rem 0.25rem;\n    border-bottom: 0.125rem solid var(--borders-neutral-strong);\n  }\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.floatingActionButtonRight {\n  position: fixed;\n  right: $fab-right * 1px;\n  bottom: $fab-bottom * 1px;\n  height: $fab-height * 1px;\n  width: 48px;\n  background-size: 60px;\n  padding: 0;\n  background-color: transparent;\n  border-width: 0;\n  border-radius: 50%;\n  z-index: 1000;\n\n  img {\n    opacity: 1;\n  }\n\n  .floatingActionButtonTag {\n    position: absolute;\n    width: 25px;\n    left: 33px;\n    top: -8px;\n  }\n}\n\n// Styles for AI Diff Container\n.aiDiffContainer {\n  position: fixed;\n  left: 10px;\n  bottom: 106px;\n  z-index: 2000;\n  width: $container-width * 1px;\n\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n}\n\n// Used to accomodate the sidebar in the AI Differentiation workspace.\n.aiDiffContainerWide {\n  position: fixed;\n  left: 10px;\n  bottom: 106px;\n  z-index: 2000;\n\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  width: 712px;\n}\n\n.chatContainer {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  flex: 1 1 0;\n\n  .chatHeader {\n    display: flex;\n    padding: 0.5rem 1rem;\n    align-items: center;\n    gap: 0.75rem;\n    align-self: stretch;\n    border-bottom: 1px solid var(--borders-neutral-primary, #d4dae1);\n    background: var(--background-neutral-primary, #fff);\n\n    .chatHeaderTitle {\n      flex: 1 0 0;\n      max-width: 180px;\n\n      p {\n        width: 100%;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n    }\n\n    .chatHeaderButtons {\n      display: flex;\n      width: 15.2188rem;\n      justify-content: flex-end;\n      align-items: center;\n      gap: 0.5rem;\n    }\n  }\n}\n\n.hiddenAiDiffPanel {\n  display: none;\n}\n\n.pulse {\n  animation: pulse 1.5s 1.7;\n  box-shadow: 0 0 0 0 rgba(90 153 212 / 0.5);\n}\n\n.taOverlay {\n  position: fixed;\n  left: 51px;\n  bottom: 97px;\n\n  height: 18px;\n  width: 28px;\n  background-size: 28px;\n  padding: 0;\n\n  border-width: 2px;\n  border-color: var(--borders-neutral-light);\n  border-radius: 15px;\n  border-style: solid;\n}\n\n.aiBotHeader {\n  position: relative;\n  padding-right: 12px;\n  padding-top: 3px;\n}\n\n.taOverlayHeader {\n  position: absolute;\n  top: 0;\n  right: 0;\n  display: flex;\n  padding: 2px 3px;\n  justify-content: center;\n  align-items: center;\n  border-radius: 58px;\n  background: var(--background-brand-aqua-primary);\n\n  span {\n    @include main-font-medium;\n    // `-fixed` because the parent `.taOverlayHeader` background is\n    // `--background-brand-aqua-primary` which stays bright aqua in both\n    // Light and Dark cdo themes. A theme-following text token would resolve\n    // to white in Dark mode and lose contrast on the aqua background.\n    color: var(--text-neutral-black-fixed);\n    font-size: 8px;\n    font-style: normal;\n    line-height: 100%;\n    text-transform: uppercase;\n    p {\n      margin-bottom: 0;\n    }\n  }\n}\n\n.aiDiffHeader {\n  border-radius: 4px 4px 0 0;\n  background: var(--background-neutral-primary-inverse);\n  color: var(--text-neutral-inverse);\n\n  border-top: 2px solid var(--borders-neutral-strong);\n  border-right: 2px solid var(--borders-neutral-strong);\n  border-left: 2px solid var(--borders-neutral-strong);\n\n  padding-inline-start: 0.75rem;\n\n  display: flex;\n  height: $header-height + 2px;\n  justify-content: space-between;\n  align-items: center;\n  align-self: stretch;\n}\n\n.aiDiffHeaderLeftSide {\n  display: flex;\n  gap: 0.25rem;\n  align-items: center;\n\n  .aiBotOutlineIcon {\n    width: 1.5rem;\n    height: 1.5rem;\n  }\n\n  .headerTag {\n    margin-left: 4px;\n\n    div {\n      background-color: var(--background-neutral-octonary);\n\n      span {\n        color: var(--text-neutral-inverse);\n      }\n    }\n  }\n}\n\n.aiDiffHeaderText {\n  @include label-two;\n  margin: 0;\n}\n\n.aiDiffHeaderRightSide {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\n.fabBackground {\n  display: flex;\n  flex-direction: column;\n  border-right: 0.125rem solid var(--borders-neutral-strong);\n  border-left: 0.125rem solid var(--borders-neutral-strong);\n  background: var(--background-neutral-primary);\n  box-shadow: 0.25rem 0.25rem 0.375rem 0 rgba(0 0 0 / 0.25);\n  height: $body-height + 2px;\n  overflow-x: hidden;\n  overflow-y: auto;\n\n  &:last-child {\n    border-radius: 0 0 0.25rem 0.25rem;\n    border-bottom: 0.125rem solid var(--borders-neutral-strong);\n  }\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.chat {\n  &Content {\n    padding: 20px 16px;\n    overflow-y: scroll;\n\n    display: flex;\n    flex-direction: column;\n    flex-grow: 1;\n    gap: 1rem;\n  }\n\n  &Footer {\n    display: flex;\n    padding: 1rem 1.25rem 0.875rem;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 2px;\n    border-top: 2px solid var(--borders-neutral-light);\n  }\n}\n\n// Necessary to prevent \"Was this helpful?...\" message footer from being wider\n// than the message box for short messages.\n.message-assistant {\n  min-width: 270px;\n}\n\n.message-user {\n  margin-inline-start: 48px;\n}\n\n.messageFeedback {\n  &Container {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    align-self: stretch;\n    color: var(--text-neutral-quaternary);\n  }\n  &Left {\n    display: flex;\n    align-items: center;\n  }\n  &Right {\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n    gap: 8px;\n    flex: 1 0 0;\n  }\n  &Button i {\n    color: var(--text-neutral-quaternary);\n  }\n  &Confirm i {\n    color: var(--text-success-primary);\n  }\n  &Negative i {\n    color: var(--text-error-primary);\n  }\n}\n\n.chips fieldset div {\n  justify-content: flex-end;\n}\n\n.floatingActionButton {\n  position: fixed;\n  left: $fab-left * 1px;\n  bottom: $fab-bottom * 1px;\n  height: $fab-height * 1px;\n  width: 48px;\n  background-size: 60px;\n  padding: 0;\n  background-color: transparent;\n  border-width: 0;\n  border-radius: 50%;\n  z-index: 1000;\n\n  img {\n    opacity: 1;\n  }\n\n  .floatingActionButtonTag {\n    position: absolute;\n    width: 25px;\n    left: 33px;\n    top: -8px;\n  }\n}\n\n.aiBotImg {\n  width: 42px;\n  height: 68px;\n  margin: 20px;\n  float: left;\n}\n\n.hideWaitingForResponse {\n  display: none;\n}\n\n.waitingForResponse {\n  width: 50px;\n}\n\n// Sidebar styles\n.aiDiffWorkspace {\n  display: flex;\n  flex-direction: row;\n  height: 100%;\n}\n\n.sidebarContainer {\n  width: 243px;\n  flex: 0 0 243px;\n  background-color: var(--background-neutral-secondary);\n  height: auto;\n  display: flex;\n  border-right: 1px solid var(--borders-neutral-strong);\n  transition: all 0.2s ease-in-out;\n\n  &.sidebarContainerCollapsed {\n    width: 65px;\n    flex: 0 0 65px;\n    transition: all 0.2s ease-in-out;\n  }\n\n  .expandedNewChatButton {\n    flex-grow: 1;\n  }\n}\n\n.sidebarBox {\n  width: 100%;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.sidebarActions {\n  display: flex;\n  padding: 8px 16px 0;\n  align-items: flex-start;\n  gap: 8px;\n  align-self: stretch;\n}\n\n.buttonWithUnreadDot {\n  position: relative;\n\n  &:after {\n    position: absolute;\n    left: 16px;\n    top: 3px;\n    content: '';\n    display: inline-block;\n    width: 8px;\n    height: 8px;\n    background-color: var(--background-error-primary);\n    border-radius: 50%;\n    margin-left: 4px;\n  }\n}\n\n.sidebarBoxCollapsed {\n  .sidebarActions {\n    flex-direction: column;\n  }\n}\n\nhtml body .sidebarActionTooltip {\n  z-index: $sidebar-tooltip-z-index;\n}\n\n.sidebarContent {\n  display: flex;\n  overflow-y: scroll;\n  width: inherit;\n  margin-top: 16px;\n  margin-bottom: 16px;\n  flex-direction: column;\n}\n\n.sidebarSectionTitle {\n  margin: 0 !important;\n  padding: 8px 16px;\n  color: var(--text-neutral-tertiary) !important;\n}\n\n.sidebarChatItem {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n:global(.Mui-selected).sidebarChatButton {\n  background-color: var(--background-neutral-tertiary) !important;\n}\n\n//body text three\n.sidebarChatItemPrimary {\n  color: var(--text-neutral-primary) !important;\n  font-family: var(--font-family-main) !important;\n  font-size: var(--font-size-body-sm) !important;\n  line-height: 1.54 !important;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.sidebarChatItemPrimarySelected {\n  font-weight: 600 !important;\n  color: var(--text-neutral-primary) !important;\n  font-family: var(--font-family-main) !important;\n  font-size: var(--font-size-body-sm) !important;\n  line-height: 1.54 !important;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.sidebarArtifactIconContainer {\n  justify-content: space-between;\n  display: flex;\n}\n\n.sidebarChatItemSecondary {\n  color: var(--text-neutral-tertiary) !important;\n  font-family: var(--font-family-main) !important;\n  font-size: 0.688rem !important;\n  line-height: 1.64 !important;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.sidebarManageLink {\n  margin-left: 8px;\n}\n\n.sidebarCategories {\n  display: flex;\n  flex-direction: column;\n  gap: 0.125rem;\n\n  &:not(:empty) {\n    margin-top: 1rem;\n  }\n}\n\n.categoryActionButton {\n  background-color: inherit;\n  display: flex;\n  height: 32px;\n  align-items: center;\n  gap: 12px;\n  padding-left: 16px;\n  text-decoration: none;\n  color: var(--text-neutral-black-fixed);\n  border: 0;\n  font-size: var(--font-size-body-sm, 14px);\n  margin: 0;\n  min-height: 32px;\n  border-radius: 0;\n\n  & span {\n    flex-grow: 1;\n    text-align: start;\n  }\n\n  &.selected {\n    border-left: 4px solid var(--borders-brand-teal-primary);\n    background-color: var(--background-neutral-quaternary);\n    padding-left: 12px;\n    text-decoration: none;\n    color: var(--text-neutral-primary);\n    font-weight: 600;\n  }\n\n  &:active {\n    // !important necessary to override application.css\n    border: 0 !important;\n    border-left: 4px solid var(--borders-brand-teal-primary) !important;\n    background-color: var(--background-neutral-quaternary);\n    padding-left: 12px;\n    text-decoration: none;\n    color: var(--text-neutral-primary);\n  }\n\n  &:hover {\n    background-color: var(--background-neutral-tertiary);\n    text-decoration: none;\n  }\n\n  .readAt {\n    color: var(--background-error-primary);\n    font-size: 8px;\n    min-width: 8px;\n    margin-inline-start: 8px;\n    width: 8px;\n    line-height: var(--font-line-height-body-xxs, 17.6px);\n  }\n}\n\n.artifactButtons {\n  button {\n    margin-inline-end: 8px;\n    margin-bottom: 8px;\n  }\n\n  a {\n    color: var(--text-neutral-tertiary);\n    font-weight: 600;\n    text-decoration: underline;\n\n    i {\n      margin-inline-start: 4px;\n    }\n  }\n}\n\n.artifactShowButtons {\n  display: flex;\n  margin-top: 12px;\n\n  button {\n    margin-inline-end: 8px;\n    margin-bottom: 8px;\n  }\n\n  a {\n    color: var(--text-neutral-tertiary);\n    font-weight: 600;\n    text-decoration: underline;\n    align-self: center;\n    width: 100%;\n    justify-content: flex-start;\n\n    i {\n      padding: 4px;\n      margin-inline-start: 4px;\n      border-radius: 4px;\n      background: var(--background-brand-aqua-light, #bffffc);\n      color: var(--text-brand-aqua-secondary);\n    }\n  }\n}\n\n.artifactConfiguration {\n  &Section {\n    margin: 20px;\n    padding: 20px;\n    background-color: var(--background-neutral-secondary);\n\n    h6 {\n      font-size: 16px;\n      font-weight: 600;\n      margin: 0;\n    }\n\n    &Header {\n      border-bottom: 1px solid var(--borders-neutral-primary);\n      padding-bottom: 12px;\n      margin-bottom: 12px;\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      align-self: stretch;\n\n      a {\n        color: #9660bf;\n        text-decoration: underline;\n        font-weight: 600;\n        font-size: 14px;\n      }\n    }\n  }\n\n  &TitleSection {\n    margin: 20px;\n    padding: 20px;\n    background-color: var(--background-neutral-secondary);\n    flex-direction: row;\n    display: flex;\n    gap: 12px;\n    align-items: end;\n  }\n\n  &Dropdowns {\n    display: flex;\n    align-items: flex-start;\n    gap: 24px;\n    align-self: stretch;\n\n    label {\n      width: 294px;\n    }\n  }\n\n  &Checkboxes {\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: row;\n    flex-wrap: wrap;\n    gap: 12px;\n\n    label {\n      width: 294px;\n    }\n  }\n\n  &FAQLink {\n    margin-left: 20px;\n    color: var(--text-neutral-primary);\n    text-decoration: underline;\n    font-weight: 600;\n\n    i {\n      margin-inline-start: 4px;\n      text-decoration: none;\n    }\n  }\n\n  &SaveButtons {\n    margin: 20px;\n    padding-top: 20px;\n    border-top: 1px solid var(--borders-neutral-primary);\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    align-self: stretch;\n  }\n\n  h3 {\n    color: var(--text-neutral-primary);\n    font-size: 24px;\n    line-height: 31.68px;\n    font-family: var(--font-family-main);\n    font-weight: var(--font-weight-semi-bold);\n    margin: 0 0 8px 0;\n  }\n\n  h4 {\n    color: var(--text-neutral-primary);\n    font-size: 16px;\n    margin-bottom: 20px;\n  }\n}\n.artifactContainer {\n  display: flex;\n  padding-top: 60px;\n  flex-direction: column;\n  align-items: center;\n  gap: 60px;\n}\n\n.artifactHeader {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 12px;\n  align-self: stretch;\n\n  h1 {\n    margin: 0;\n  }\n\n  p {\n    margin: 0;\n  }\n}\n\n.artifactContentBlocksContainer {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 32px;\n  margin-bottom: 64px;\n}\n\n.artifactContentBlock {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.artifactContent {\n  display: flex;\n  width: 800px;\n  padding: 50px 40px 40px 40px;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  margin-top: -16px;\n  border-radius: 4px;\n\n  p {\n    white-space: pre-line;\n  }\n\n  &Blue {\n    border: 1px solid var(--borders-brand-teal-primary, #0093a4);\n    background: var(--background-brand-teal-extra-light, #e0f8f9);\n  }\n\n  &Red {\n    border: 1px solid var(--accent-strawberry-50, #ed6060);\n    background: var(--accent-strawberry-10, #ffe3e3);\n  }\n\n  &Purple {\n    border: 1px solid var(--borders-brand-purple-primary, #8c52ba);\n    background: var(--background-brand-purple-extra-light, #f6edfd);\n  }\n}\n\n.artifactContentLabel {\n  display: inline-flex;\n  padding: 8px 16px;\n  align-items: center;\n  gap: 8px;\n  border-radius: 4px;\n  background: var(--background-brand-teal-primary, #0093a4);\n  z-index: 1;\n  p {\n    color: var(--text-neutral-inverse);\n    margin: 0;\n  }\n  &Blue {\n    background: var(--background-brand-teal-primary, #0093a4);\n  }\n\n  &Red {\n    background: var(--accent-strawberry-50, #ed6060);\n  }\n\n  &Purple {\n    background: var(--borders-brand-purple-primary, #8c52ba);\n  }\n}\n\n.artifactIcon {\n  font-size: 20px;\n  display: flex;\n  justify-content: center;\n  color: var(--text-neutral-inverse);\n}\n\n.markdownStyle {\n  p {\n    color: var(--text-neutral-primary, #292f36);\n    text-align: center;\n    font-feature-settings: 'liga' off, 'clig' off;\n\n    /* Body/Body 1 - ExtraStrong */\n    font-family: var(--font-family-body);\n    font-size: var(--font-size-body-lg, 20px);\n    font-style: normal;\n    font-weight: 700;\n    line-height: var(--font-line-height-body-lg, 28px); /* 140% */\n  }\n}\n\n.answerKeyContainer {\n  display: flex;\n  flex-direction: column;\n  width: 840px;\n  padding: 12px 20px;\n  gap: 20px;\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-primary, #d4dae1);\n  background: var(--background-neutral-secondary, #f0f2f5);\n}\n\n.answerKeyHeader {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex: 1 0 0;\n}\n\n.answerIcon {\n  font-size: 20px;\n  display: flex;\n  justify-content: center;\n  color: var(--text-neutral-primary);\n}\n\n.artifactThreadIcon {\n  color: var(--background-neutral-octonary);\n  align-self: center;\n}\n\n.artifactTitleInput {\n  min-height: 24px;\n  max-height: 24px;\n  box-sizing: border-box;\n  resize: none;\n  margin: 0;\n  width: 100%;\n\n  &:disabled {\n    opacity: 0.5;\n    background: none;\n  }\n}\n\n// Hosted inside a lab's flex row (see the `inline` prop): the container must\n// not claim width of its own, only the inline drawer within it does.\n.fabContainedInline {\n  display: contents;\n}\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n"],sourceRoot:""}]),i.locals={containerHeight:"652",containerWidth:"512",fabOriginX:"11",fabOriginY:"99","heading-xxl":"OlokC5A6sm3PiupARdDA",wrapper:"a2qwp_xJBTnA0JqX3O_I","heading-xl":"E73kwxEx5mB0LBS9gBIS","heading-lg":"AFr_owWZAMCCYs5sheZT","heading-md":"jnPAccukmNJGe8PkQMbS","heading-sm":"_Ynr7VlT7_Cv40SI1Hp7","heading-xs":"ICtQgT0_BF7IRBaSZrQr","body-one":"kyIJWCTJ59QQYdL7FZVf","body-two":"Iop6uvKCR4han51zGzvP","body-three":"TP4q00_8bcgF8A_xaoKO","body-four":"OLtdU4HKKD5yi8AHzytK","overline-one":"gkToPsAueYq8cdLWhK30","overline-two":"BTLwp1Qc0NimvrmSNI8F","overline-three":"wXJ7eNVn9epcfRpYf9mX",strong:"z_ZYwXaip5CInbbzDLlG",em:"XFy9HFhRPONqut2sjX8s",figcaption:"orFZDlIkjD3Ctp4AGlfD","no-margin":"FR_XMrQLOgB643NCB2Tr",fabBackgroundDrawer:"lpGVit1eBQgWX