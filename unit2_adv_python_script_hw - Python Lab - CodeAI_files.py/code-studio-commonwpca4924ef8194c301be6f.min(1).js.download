// space, and not long enough to force a horizontal scrollbar (e.g.\n  // JavaLab contained levels), add enough padding to enable the\n  // horizontal scrollbar, so the content doesn\'t get cut off by the\n  // vertical scrollbar.\n  padding-inline-end: 12px;\n}\n\n.summaryEntryPoint.isStandalone {\n  padding-top: 40px;\n}\n\n.summaryEntryPoint.noQuestionContent {\n  margin-left: 50px;\n}\n\n.button {\n  float: left;\n}\n\n[dir="rtl"] .button {\n  float: right;\n}\n\n.responseIcon {\n  float: left;\n  padding: 1px 8px;\n\n  height: 30px; // button height;\n  line-height: 30px;\n\n  /* stylelint-disable selector-pseudo-class-no-unknown */\n  :global(.fa-user) {\n    vertical-align: middle;\n    font-size: 30px;\n    color: var(--background-brand-teal-primary);\n  }\n  /* stylelint-enable selector-pseudo-class-no-unknown */\n}\n\n[dir="rtl"] .responseIcon {\n  float: right;\n}\n\n.responseCounter {\n  float: left;\n  padding: 2px 0;\n\n  height: 38px; // button height;\n  line-height: 34px;\n\n  p {\n    margin: 0;\n  }\n\n  span.counter {\n    display: inherit;\n    line-height: 16px;\n  }\n\n  span.text {\n    display: block;\n    line-height: 16px;\n  }\n}\n\n[dir="rtl"] .responseCounter {\n  float: right;\n\n  // Since the `X/Y` counter doesn\'t have anything to get translated, explicitly\n  // set the text direction when in RTL mode.\n  span.counter {\n    direction: rtl;\n  }\n}\n'],sourceRoot:""}]),i.locals={summaryEntryPoint:"f6runZ81nWmx5rMD5d1c",isStandalone:"raIUkokuCqiDvvaPB5SA",noQuestionContent:"YSRUtzKyaRp_4_CQNMzQ",button:"Qi2OX4FC2OIPh9n_TK78",responseIcon:"Ap3xrp0XyXMCfBSIMo9x",responseCounter:"b0cKawcGybYdVLzmQhpj",counter:"ohTLOJTEx2v9Osruv4w5",text:"_rN7TSLxdfH7ec4OxWla"};const l=i},7704:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".KFKkmjS0smsul6UVsVwf{margin:24px 0 12px 0;padding:0 0 5px 5px}.KFKkmjS0smsul6UVsVwf h5{margin-bottom:0}.KFKkmjS0smsul6UVsVwf .iMGH2KDTTulrEXlmP255{display:flex;flex