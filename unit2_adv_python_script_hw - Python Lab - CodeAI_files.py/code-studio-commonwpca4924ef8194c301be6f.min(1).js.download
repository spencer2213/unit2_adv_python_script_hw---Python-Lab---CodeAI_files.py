A,CA+IE,oRAvLF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CAyJF,sBAjME,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAqJE,oRApMF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAkKF,sBC5OE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAwJE,2FC/OF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAgKF,sBCvPE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CA6JE,2FC1PF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CAsKF,sBCnQE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CAmKE,2FCtQF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CA2KF,sBC9QE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAwKE,2FCjRF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAkLF,sBC3RE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CAuKE,2FC9RF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CA+KF,sBCtSE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CA4KE,2FCzSF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CAoLF,sBCjTE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAiLE,2FCpTF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAyLF,6BApLE,wCAAA,CAuLA,qFAvLA,wCAAA,CA8LF,yBA1LE,iBAAA,CA6LA,yEA7LA,iBAAA,CAoMF,iCC1TE,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CA8LA,iGC7TA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CAoMF,sBACE,QAAA,CAEE,+WAQE,QAAA,CAGF,4FAEE,eAAA,CEjZN,sBAEE,qBAAA,CACA,iBAAA,CACA,iBAAA,CACA,qBAAA,CAMA,oCACE,oBAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,6BAAA,CACA,eAAA,CACA,gBAAA,CACA,aAAA,CAMA,oCACE,oBAAA,CAIA,qCADF,6BAEI,SAAA,CACA,aAAA,CACA,YAAA,CACA,mBAAA,CAAA,CAGF,qCARF,6BASI,YAAA,CAAA,CAKN,sBASE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,iBAAA,CACA,SAAA,CAZA,qCADF,sBAEI,SAAA,CAAA,CAGF,qCALF,sBAMI,UAAA,CAAA,CASF,iDACE,iCAAA,CACA,eAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n",'@import "breakpoints";\n@import \'@code-dot-org/component-library-styles/typography.module\';\n\n.banner {\n  // background-image is passed in via the `style` attribute\n  background-size: cover;\n  position: relative;\n  padding: 2rem 1rem;\n  box-sizing: border-box;\n\n  /*\n    The banner background image leaves an open space for text on the left. Therefore, in Right-to-Left languages, the\n    banner needs to be flipped horizontally so the background image empty space is on the right.\n   */\n  html[dir="rtl"] & {\n    transform: scaleX(-1);\n  }\n}\n\n.contentWrapper {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  max-width: 960px;\n  min-height: 100px;\n  margin: 0 auto;\n\n  /*\n    Since the whole banner was flipped horizontally, we need to un-flip all the content in the header so that the text\n    and layout are not backwards\n   */\n  html[dir="rtl"] & {\n    transform: scaleX(-1);\n  }\n\n  figure {\n    @media screen and (min-width: $width-sm) {\n      width: 25%;\n      margin: 0 auto;\n      display: flex;\n      justify-content: end;\n    }\n\n    @media screen and (max-width: $width-sm) {\n      display: none\n    }\n  }\n}\n\n.textWrapper {\n  @media screen and (min-width: $width-sm) {\n    width: 60%;\n  }\n\n  @media screen and (max-width: $width-sm) {\n    width: 100%;\n  }\n\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  position: relative;\n  z-index: 1;\n\n  h1, p {\n    color: var(--text-neutral-inverse);\n    margin-bottom: 0;\n  }\n}\n\n\n\n'],sourceRoot:""}]),i.locals={"heading-xxl":"zQQWOGFVfPDTqSsYgtTV",wrapper:"KF2jlG6lFhJElKVZK4ah","heading-xl":"DAWIuSZTWiEdBBXvTirw","heading-lg":"MUTSDK_WJGVS8EIOhnXH","heading-md":"wkH_to14YfhVszuXlmYK","heading-sm":"c5HgvafdPcvuBwMjn6X4","heading-xs":"r5Bs1FyY85C0skTw4w0a","body-one":"cRXIM1WJdadxFIxpJG9K","body-two":"tm5YuDnwOFEzROt1pncZ","body-three":"vAcFoIBtIwOSByueHdgQ","body-four":"IWRMy9La6H3cw9m3Zrak","overline-one":"DuEr3SUBaXJuU_dz3faX","overline-two":"kE01AymXyMJg2ewixmaW","overline-three":"HXQzciFeBso9dxAg9hOQ",strong:"eJ2QjI9i_S8gh9V7LWY4",em:"NXyAODAwY76ch1CWnlHB",figcaption:"wx3n2FvlVqjdnSx0ozhR","no-margin":"td51VtEmMIIsrEXuaHPw",banner:"SAjbQIIQU3PlnxYnP5aX",contentWrapper:"M74dsHmiDlCQiDHeVlqy",textWrapper:"rx3k1ERLfF6WZta3ZUIE"};const l=i},5165:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,'.S565SiZJd3p2n1fy7YjR{display:flex;justify-content:space-between;margin:10px 0}.Jt_r8NBSFa9KRZTQTws6{margin:10px 0;color:#8c52ba;font-size:14px;line-height:22px}.iWrbLU354Dqqwb_w9g8n.MuiTypography-root{margin:25px 0 10px 0}.y7wJW2KfRGoLFgm86Rlb{margin-top:0}.y7wJW2KfRGoLFgm86Rlb.iWrbLU354Dqqwb_w9g8n.MuiTypography-root{margin-top:0}.tmE0tmPNO0Y70p_nP1wz{list-style-type:none}.sbFmpfPFUHsn8VhmemIg{display:flex;flex-direction:row;margin-top:40px}.sbFmpfPFUHsn8VhmemIg h2{margin-bottom:10px}.HGNimGtQWIKAAIbPrw8A{width:59%;padding-right:20px}.u0cgD0Sxy6f8yhe7PKHR{width:41%;padding:0 10px 10px 20px;border-left:solid 1px #333}.bnZr01LQJ2EbGKpbvoon{display:flex;justify-content:flex-end}.S5fum9KTnoV_MEIAD5vU{margin-right:5px}.Vghm5hQnygmSE5RCfUcw{position:relative;top:1px;margin:0 2px;font-size:16px}.HhqYiD48F_8df4d6rlgC{margin:0 2px}.vZ6j3LPPdGi9G5ria1Qw{display:flex;flex-direction:row;align-items:center}.aCBQdI8OtTGug4eXtZOF{margin-left:50px}.B6yeNBsUgK96AJO9srZ4{padding:10px 10px 0;border:2px solid var(--borders-warning-light);border-radius:4px;background-color:var(--background-warning-light);color:var(--text-neutral-secondary);margin-bottom:10px}.suZ5azCEOMEx8lWUasbu{display:flex;align-items:center}.CZCScLtyO73P0OT1qUs6{margin-right:10px}.LcJWnn9pPKts4XNVf5wf{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:600;font-style:normal;color:#4d575f}.h98bf6yt1bxqjFr0xQl2{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:700;font-style:normal;color:#0596ce}.h98bf6yt1bxqjFr0xQl2:hover{text-decoration:underline}.GSQmNvZptFRv7QBXSNUJ{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:600;font-style:normal;color:#4d575f}.BVzeINbFQZivzijDPYf3{padding:3px}.OpWz2g6cIgYaO1yP3Xvp{padding:3px}.WvM1_FCyp2MB0HuAxxW1{display:inline-block}.jVWPhITkBBYbuDDIcCr6{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:400;font-style:normal;width:300px;background-color:#ebe8f1}.gbQrzNtbwJDa1QS88FXC{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:400;font-style:normal;width:300px}.bp1AmyFOmgTtUXuBqwOV{margin-left:10px}.KE7db8LKDO7v96IhZEOh{margin:0 2px}.OzbcaFibvbKzbP2fTeym{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:700;font-style:normal}.WjdAm3qEpLGQ650_ztSb{margin-left:15px}.AdOk58H8pl2atUcWjZwt{top:-2px}.E7yir0h3aNCiuM9izKYo.MuiTypography-root{color:var(--text-brand-purple-primary)}.BJNSYOhvPywloRkKdUB8.MuiTypography-root{margin:10px 0}.QxB9mI5xn0QD1OnLNdgX{display:flex;flex-direction:column;width:100%}.S58Mk3IAuusQo4iUGME7{margin-left:5px;font-style:italic}.ffooacDyHbk0b8fWt8jS{margin-bottom:5px;padding-left:5px;border-left:5px solid #ccc}.bjOvhw6M7aX3DqR2SCvM{margin-bottom:5px}.vr3m3g7B_6EhPpo74nSZ{padding:0 10px 10px}.HG0d8aJfE_huWPPm2XVH{max-height:60vh;overflow:auto}.tAZrnku3g28TOgSWnIKg{display:flex;flex-wrap:wrap}.S3OIBVBxCfiscya6jwQT{margin:5px}.lZvQeZSFOq7JeYRYxrR6{margin-bottom:5px}.qmJTNE3MAfnnQVbKwbQw{border-style:solid solid none solid;border-top-left-radius:10px;border-top-right-radius:10px;border-width:1px;border-color:var(--tip-border);padding:5px 10px;width:222px;display:flex;align-items:center;gap:6px;cursor:pointer}.qmJTNE3MAfnnQVbKwbQw.S5elXxCyO7LupBmEWbHk{background-color:var(--tip-primary);color:var(--text-neutral-inverse)}.qmJTNE3MAfnnQVbKwbQw.S5elXxCyO7LupBmEWbHk:hover{background-color:var(--background-neutral-primary);color:var(--tip-primary)}.qmJTNE3MAfnnQVbKwbQw.vnJAjsLEUcMxGVLRe_oj{background-color:var(--background-neutral-primary);color:var(--tip-primary)}.qmJTNE3MAfnnQVbKwbQw.vnJAjsLEUcMxGVLRe_oj:hover{background-color:var(--tip-primary);color:var(--text-neutral-inverse)}._DzQuKPuqc4X7Kp1k8K5{border-style:solid;border-width:1px;border-color:var(--tip-border);background-color:var(--tip-secondary);padding:10px}.eaCVPTekMcFmw39Oprsb{margin-left:7px;margin-right:5px}.GHG5YktIupoRMoOuRIK0{margin-left:auto}',"",{version:3,sources:["webpack://./src/templates/lessonOverview/lesson-plan.module.scss","webpack://./../shared/css/color.scss","webpack://./../shared/css/font.scss"],names:[],mappings:"AAUA,sBACE,YAAA,CACA,6BAAA,CACA,aAAA,CAGF,sBACE,aAAA,CACA,aCYO,CDXP,cAAA,CACA,gBAAA,CAOA,yCACE,oBAAA,CAIJ,sBACE,YAAA,CAIA,8DACE,YAAA,CAKJ,sBACE,oBAAA,CAKF,sBACE,YAAA,CACA,kBAAA,CACA,eAAA,CAEA,yBACE,kBAAA,CAIJ,sBACE,SAAA,CACA,kBAAA,CAGF,sBACE,SAAA,CACA,wBAAA,CACA,0BAAA,CAGF,sBACE,YAAA,CACA,wBAAA,CAGF,sBACE,gBAAA,CAGF,sBAGE,iBAAA,CACA,OAAA,CACA,YAAA,CACA,cAAA,CAGF,sBACE,YAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,kBAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,mBAAA,CACA,6CAAA,CACA,iBAAA,CACA,gDAAA,CACA,mCAAA,CACA,kBAAA,CAKF,sBACE,YAAA,CACA,kBAAA,CAGF,sBACE,iBAAA,CAKF,sBErCE,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CFqCA,aClHc,CDqHhB,sBE/BE,yYAhFU,CAiFV,eAxEiB,CAyEjB,iBAAA,CF+BA,aC3BW,CD6BX,4BACE,yBAAA,CAIJ,sBEnDE,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CFmDA,aChIc,CDmIhB,sBACE,WAAA,CAGF,sBACE,WAAA,CAKF,sBACE,oBAAA,CAGF,sBE5FE,yYA/CU,CAgDV,eA1CoB,CA2CpB,iBAAA,CF4FA,WAAA,CACA,wBC/HgB,CDkIlB,sBElGE,yYA/CU,CAgDV,eA1CoB,CA2CpB,iBAAA,CFkGA,WAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,YAAA,CAGF,sBE9EE,yYAhFU,CAiFV,eAxEiB,CAyEjB,iBAAA,CFkFF,sBACE,gBAAA,CAKF,sBACE,QAAA,CAQA,yCACE,sCAAA,CAOF,yCACE,aAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,UAAA,CAGF,sBACE,eAAA,CACA,iBAAA,CAGF,sBACE,iBAAA,CACA,gBAAA,CACA,0BAAA,CAGF,sBACE,iBAAA,CAKF,sBAGE,mBAAA,CAKF,sBACE,eAAA,CACA,aAAA,CAGF,sBACE,YAAA,CACA,cAAA,CAGF,sBACE,UAAA,CAKF,sBACE,iBAAA,CAGF,sBAEE,mCAAA,CACA,2BAAA,CACA,4BAAA,CACA,gBAAA,CACA,8BAAA,CACA,gBAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,OAAA,CACA,cAAA,CAOF,2CACE,mCAAA,CACA,iCAAA,CAEA,iDACE,kDAAA,CACA,wBAAA,CAIJ,2CACE,kDAAA,CACA,wBAAA,CAEA,iDACE,mCAAA,CACA,iCAAA,CAIJ,sBACE,kBAAA,CACA,gBAAA,CACA,8BAAA,CACA,qCAAA,CACA,YAAA,CAGF,sBACE,eAAA,CACA,gBAAA,CAGF,sBACE,gBAAA",sourcesContent:["@import 'color.scss';\n@import 'font.scss';\n\n// Consolidated styles for the lesson plan (lessonOverview) views. This replaces\n// the per-component inline `styles` objects and folds in the former\n// resource-list, lesson-standards, and lesson-tip CSS modules. The\n// level-details-dialog module is intentionally kept separate.\n\n// -- Shared by LessonOverview and StudentLessonOverview --------------------\n\n.header {\n  display: flex;\n  justify-content: space-between;\n  margin: 10px 0;\n}\n\n.navLink {\n  margin: 10px 0;\n  color: $purple;\n  font-size: 14px;\n  line-height: 22px;\n}\n\n// MUI's Typography root sets `margin: 0` at single-class\n// specificity, so pair our class with the MUI class to win on specificity\n// rather than on stylesheet load order.\n.headingWithMargins {\n  &:global(.MuiTypography-root) {\n    margin: 25px 0 10px 0;\n  }\n}\n\n.titleNoTopMargin {\n  margin-top: 0;\n\n  // .headingWithMargins above is also 0-2-0, so add a class to outrank it when\n  // a heading carries both, instead of depending on which rule comes last.\n  &.headingWithMargins:global(.MuiTypography-root) {\n    margin-top: 0;\n  }\n}\n\n// Bulletless list, shared by LessonStandards and LessonAgenda.\n.noBullets {\n  list-style-type: none;\n}\n\n// -- LessonOverview --------------------------------------------------------\n\n.frontPage {\n  display: flex;\n  flex-direction: row;\n  margin-top: 40px;\n\n  h2 {\n    margin-bottom: 10px;\n  }\n}\n\n.left {\n  width: 59%;\n  padding-right: 20px;\n}\n\n.right {\n  width: 41%;\n  padding: 0 10px 10px 20px;\n  border-left: solid 1px #333;\n}\n\n.dropdowns {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.printDropdown {\n  margin-right: 5px;\n}\n\n.printIcon {\n  // the icon text is a different size than the button text, so nudge it up to\n  // keep it vertically centered\n  position: relative;\n  top: 1px;\n  margin: 0 2px;\n  font-size: 16px;\n}\n\n.customText {\n  margin: 0 2px;\n}\n\n.standardsHeaderAndButton {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n}\n\n.fullCourseAlignmentButton {\n  margin-left: 50px;\n}\n\n.copyResourceWarningArea {\n  padding: 10px 10px 0;\n  border: 2px solid var(--borders-warning-light);\n  border-radius: 4px;\n  background-color: var(--background-warning-light);\n  color: var(--text-neutral-secondary);\n  margin-bottom: 10px;\n}\n\n// -- StudentLessonOverview -------------------------------------------------\n\n.headerActions {\n  display: flex;\n  align-items: center;\n}\n\n.printButton {\n  margin-right: 10px;\n}\n\n// -- LessonStandards -------------------------------------------------------\n\n.frameworkName {\n  @include main-font-semi-bold;\n  color: $dark_charcoal;\n}\n\n.categoryShortcode {\n  @include main-font-bold;\n  color: $link_color;\n\n  &:hover {\n    text-decoration: underline;\n  }\n}\n\n.standardShortcode {\n  @include main-font-semi-bold;\n  color: $dark_charcoal;\n}\n\n.summary {\n  padding: 3px;\n}\n\n.standard {\n  padding: 3px;\n}\n\n// -- LessonNavigationDropdown ----------------------------------------------\n\n.dropdown {\n  display: inline-block;\n}\n\n.section {\n  @include main-font-regular;\n  width: 300px;\n  background-color: $lightest_purple;\n}\n\n.lesson {\n  @include main-font-regular;\n  width: 300px;\n}\n\n.lessonLabelWrapper {\n  margin-left: 10px;\n}\n\n.lessonLabel {\n  margin: 0 2px;\n}\n\n.boldText {\n  @include main-font-bold;\n}\n\n// -- LessonAgenda ----------------------------------------------------------\n\n.agendaSection {\n  margin-left: 15px;\n}\n\n// -- ResourceList (formerly resource-list.module.scss) ---------------------\n\n.dropdownButton {\n  top: -2px;\n}\n\n// -- Activity --------------------------------------------------------------\n\n.activityHeader {\n  // MuiTypography-root sets `color` at the same specificity, so pair with the\n  // MUI class rather than relying on stylesheet load order.\n  &:global(.MuiTypography-root) {\n    color: var(--text-brand-purple-primary);\n  }\n}\n\n// -- ActivitySection -------------------------------------------------------\n\n.activitySectionHeader {\n  &:global(.MuiTypography-root) {\n    margin: 10px 0;\n  }\n}\n\n.textAndProgression {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n}\n\n.remarks {\n  margin-left: 5px;\n  font-style: italic;\n}\n\n.remarksBody {\n  margin-bottom: 5px;\n  padding-left: 5px;\n  border-left: 5px solid #ccc;\n}\n\n.progression {\n  margin-bottom: 5px;\n}\n\n// -- ProgressionDetails ----------------------------------------------------\n\n.progressionBox {\n  // The original inline style also set `margin: '10px, 0px'`, but the stray\n  // comma made it invalid CSS that browsers dropped; kept out here as a no-op.\n  padding: 0 10px 10px;\n}\n\n// -- LevelDetailsDialog ----------------------------------------------------\n\n.scrollContainer {\n  max-height: 60vh;\n  overflow: auto;\n}\n\n.sublevelCards {\n  display: flex;\n  flex-wrap: wrap;\n}\n\n.dialogButton {\n  margin: 5px;\n}\n\n// -- LessonTip (formerly lesson-tip.module.scss) ---------------------------\n\n.tip {\n  margin-bottom: 5px;\n}\n\n.tab {\n  // borders everywhere except the bottom\n  border-style: solid solid none solid;\n  border-top-left-radius: 10px;\n  border-top-right-radius: 10px;\n  border-width: 1px;\n  border-color: var(--tip-border);\n  padding: 5px 10px;\n  width: 222px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n}\n\n// The tab's foreground/background swap on expand and invert on hover.\n// --tip-primary is the per-tip-type strong color; it pairs against the neutral\n// surface (--background-neutral-primary) and inverse text (--text-neutral-inverse)\n// tokens, which both resolve to white in light mode and flip together in dark.\n.tab.expanded {\n  background-color: var(--tip-primary);\n  color: var(--text-neutral-inverse);\n\n  &:hover {\n    background-color: var(--background-neutral-primary);\n    color: var(--tip-primary);\n  }\n}\n\n.tab.collapsed {\n  background-color: var(--background-neutral-primary);\n  color: var(--tip-primary);\n\n  &:hover {\n    background-color: var(--tip-primary);\n    color: var(--text-neutral-inverse);\n  }\n}\n\n.box {\n  border-style: solid;\n  border-width: 1px;\n  border-color: var(--tip-border);\n  background-color: var(--tip-secondary);\n  padding: 10px;\n}\n\n.icon {\n  margin-left: 7px;\n  margin-right: 5px;\n}\n\n.caret {\n  margin-left: auto;\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","// Common site-wide fonts, put here for easy access from all scss files\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n// Please note (!): use only single quotes (' ') for strings (!) to allow our custom converter to work properly.\n// This file is being transpiled to js object.\n// (So it can be used in jsx/tsx files for inline styles. This is made mostly for legacy.\n// Try to avoid use of inline styles if you're creating new component).\n// Keeping that in mind -\n\n$geist-font: 'Geist';\n$space-grotesk-font: 'Space Grotesk';\n$noto-sans-fonts: 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Armenian', 'Noto Sans Bengali',\n'Noto Sans SC', 'Noto Sans TC', 'Noto Sans Devanagari', 'Noto Sans Georgian', 'Noto Sans Hebrew', 'Noto Sans JP',\n'Noto Sans Kannada', 'Noto Sans Khmer', 'Noto Sans KR', 'Noto Sans Myanmar', 'Noto Sans Sinhala',\n'Noto Sans Tamil', 'Noto Sans Telugu', 'Noto Sans Thai', 'Noto Sans Thaana', 'Noto Sans Math';\n\n$main-font: $geist-font, $noto-sans-fonts, sans-serif;\n$heading-font: $space-grotesk-font, $main-font;\n\n$thin-font-weight: 100;\n$extra-light-font-weight: 200;\n$light-font-weight: 300;\n$regular-font-weight: 400;\n$medium-font-weight: 500;\n$semi-bold-font-weight: 600;\n$bold-font-weight: 700;\n$extra-bold-font-weight: 800;\n$black-font-weight: 900;\n\n@mixin main-font-thin {\n  font-family: $main-font;\n  font-weight: $thin-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: $main-font;\n  font-weight: $extra-light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: $main-font;\n  font-weight: $light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: $main-font;\n  font-weight: $regular-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: $main-font;\n  font-weight: $medium-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: $main-font;\n  font-weight: $semi-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: $main-font;\n  font-weight: $bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: $main-font;\n  font-weight: $extra-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: $main-font;\n  font-weight: $black-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n$barlowSemiCondensed-semibold: 'Barlow Semi Condensed Semibold', $noto-sans-fonts, sans-serif;\n$barlowSemiCondensed-medium: 'Barlow Semi Condensed Medium', $noto-sans-fonts, sans-serif;\n\n$code-font: 'Source Code Pro', Monaco, 'Bitstream Vera Sans Mono', 'Lucida Console', Terminal, monospace;\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.