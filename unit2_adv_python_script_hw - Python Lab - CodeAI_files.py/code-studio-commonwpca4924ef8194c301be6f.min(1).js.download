gin-left:4px;width:24px;text-align:center;flex-shrink:0}.StZ3bmihsURgH8iernDW .bWEU14uOlYGtKfmF3Qgg .a1BWpW7Z79OwPJ2rYSQq{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.StZ3bmihsURgH8iernDW .bWEU14uOlYGtKfmF3Qgg .MkfwTw0QW3pMwFJzf6VC{font-style:italic}.StZ3bmihsURgH8iernDW .SwZRPxI1rD7Z8yhrOe1_{font-size:11px;min-width:240px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.StZ3bmihsURgH8iernDW .m0nVbISKzgn0oUjO_cBd{display:flex;margin-right:15px}.StZ3bmihsURgH8iernDW .SXEWZMZWvBUKOBBIAs7n{display:inline-block;font-size:13px;width:15px;margin-right:10px;color:#989ea5;text-align:right}.StZ3bmihsURgH8iernDW .sp3gH3oAafE1utOLu8si{margin-right:0}.StZ3bmihsURgH8iernDW .TIAZVtj5yn0ZAGLofSyL{color:#d1d4d8}.StZ3bmihsURgH8iernDW .sLfXGRqn4dGzhRmXFtPt{display:inline-block;font-size:16px}.StZ3bmihsURgH8iernDW .b7_J6ZNTdExVPObjXTOu{color:#abb0b6}.StZ3bmihsURgH8iernDW .fNpG4eCduVNvFwVN0yD2{color:#727a83;cursor:default}","",{version:3,sources:["webpack://./src/music/views/soundsPanel.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAEA,sBACE,gBAAA,CACA,WAAA,CACA,YAAA,CACA,YAAA,CACA,qBAAA,CAEA,uBACE,YAAA,CACA,6BAAA,CACA,iBAAA,CACA,OAAA,CAGE,kDACE,gBAAA,CAKN,sBACE,YAAA,CACA,kBAAA,CACA,eAAA,CACA,MAAA,CACA,OAAA,CAEA,4CACE,wBCuJS,CDtJT,MAAA,CACA,iBAAA,CACA,oBAAA,CAGF,4CACE,wBCgJS,CD/IT,MAAA,CACA,iBAAA,CACA,oBAAA,CAIJ,4CACE,aAAA,CACA,sBAAA,CACA,eAAA,CACA,cAAA,CAEA,kDACE,wBCiIW,CD9Hb,0DACE,yBAAA,CAGF,4CACE,wBCwHW,CDrHb,wDACE,cAAA,CAGF,4CACE,UAAA,CACA,WAAA,CACA,kBAAA,CACA,UAAA,CAGF,4CACE,8BAAA,CACA,UAAA,CAEA,4CACE,cAAA,CAGF,4CACE,cAAA,CACA,eAAA,CAIJ,4CACE,WAAA,CACA,UAAA,CACA,iBAAA,CAIJ,4CACE,eAAA,CACA,cAAA,CACA,UAAA,CACA,aAAA,CACA,YAAA,CACA,6BAAA,CACA,kBAAA,CACA,cAAA,CAEA,kDACE,wBC2EW,CDzEX,wEACE,aCkES,CD9Db,0DACE,yBAAA,CAGF,4CACE,wBC8DW,CD3Db,4CACE,YAAA,CACA,kBAAA,CACA,uBAAA,CAEA,kEACE,gBAAA,CACA,eAAA,CACA,UAAA,CACA,iBAAA,CACA,aAAA,CAGF,kEACE,cAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CAEA,kEACE,iBAAA,CAKN,4CACE,cAAA,CACA,eAAA,CACA,iBAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CAGF,4CACE,YAAA,CACA,iBAAA,CAIJ,4CACE,oBAAA,CACA,cAAA,CACA,UAAA,CACA,iBAAA,CACA,aCWa,CDVb,gBAAA,CAEA,4CACE,cAAA,CAEA,4CACE,aCCS,CDIf,4CACE,oBAAA,CACA,cAAA,CAGF,4CACE,aCRa,CDUb,4CACE,aCRW,CDSX,cAAA",sourcesContent:["@import 'color.scss';\n\n.soundsPanel {\n  user-select: none;\n  width: 600px;\n  height: 290px;\n  display: flex;\n  flex-direction: column;\n\n  &Top {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 5px;\n    gap: 8px;\n\n    .segmentedButtons {\n      span {\n        user-select: none;\n      }\n    }\n  }\n\n  &Body {\n    display: flex;\n    flex-direction: row;\n    overflow: hidden;\n    flex: 1;\n    gap: 5px;\n\n    .leftColumn {\n      background-color: $neutral_dark;\n      flex: 1;\n      overflow-y: scroll;\n      scroll-padding: 1px 0;\n    }\n\n    .rightColumn {\n      background-color: $neutral_dark;\n      flex: 1;\n      overflow-y: scroll;\n      scroll-padding: 1px 0;\n    }\n  }\n\n  .folderRow {\n    padding: 6px 0;\n    margin: 1px 1px 6px 1px;\n    overflow: hidden;\n    cursor: pointer;\n\n    &:hover {\n      background-color: $neutral_dark90;\n    }\n\n    &:focus-visible {\n      outline: $neutral_light solid 1px;\n    }\n\n    &Selected {\n      background-color: $neutral_dark80;\n    }\n\n    &:first-child {\n      margin-top: 1px;\n    }\n\n    &Left {\n      width: 55px;\n      height: 55px;\n      margin: 0 6px 0 4px;\n      float: left;\n    }\n\n    &Middle {\n      width: calc(100% - 75px - 58px);\n      float: left;\n\n      &Name {\n        font-size: 16px;\n      }\n\n      &SubTitle {\n        font-size: 11px;\n        line-height: 2em;\n      }\n    }\n\n    &Right {\n      float: right;\n      width: 43px;\n      margin-right: 15px;\n    }\n  }\n\n  .soundRow {\n    overflow: hidden;\n    font-size: 14px;\n    margin: 1px;\n    padding: 6px 0;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    cursor: pointer;\n\n    &:hover {\n      background-color: $neutral_dark90;\n\n      .lengthNoMarginRight {\n        color: $neutral_dark30;\n      }\n    }\n\n    &:focus-visible {\n      outline: $neutral_light solid 1px;\n    }\n\n    &Selected {\n      background-color: $neutral_dark80;\n    }\n\n    &Left {\n      display: flex;\n      align-items: center;\n      width: calc(100% - 30px);\n\n      .typeIcon {\n        margin-right: 6px;\n        margin-left: 4px;\n        width: 24px;\n        text-align: center;\n        flex-shrink: 0;\n      }\n\n      .name {\n        font-size: 14px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n\n        &Vocal {\n          font-style: italic;\n        }\n      }\n    }\n\n    &Middle {\n      font-size: 11px;\n      min-width: 240px;\n      text-align: center;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    &Right {\n      display: flex;\n      margin-right: 15px;\n    }\n  }\n\n  .length {\n    display: inline-block;\n    font-size: 13px;\n    width: 15px;\n    margin-right: 10px;\n    color: $neutral_dark50;\n    text-align: right;\n\n    &NoMarginRight {\n      margin-right: 0;\n\n      &Selected {\n        color: $neutral_dark20;\n      }\n    }\n  }\n\n  .previewContainer {\n    display: inline-block;\n    font-size: 16px;\n  }\n\n  .preview {\n    color: $neutral_dark40;\n\n    &Playing {\n      color: $neutral_dark70;\n      cursor: default;\n    }\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;