iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CA4KE,iDCzSF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CAoLF,gBCjTE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAiLE,qDCpTF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAyLF,eApLE,wCAAA,CAuLA,6CAvLA,wCAAA,CA8LF,OA1LE,iBAAA,CA6LA,6BA7LA,iBAAA,CAoMF,uBC1TE,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CA8LA,6DC7TA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CAoMF,WACE,QAAA,CAEE,+KAQE,QAAA,CAGF,4CAEE,eAAA,CA9MN,aAhIE,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,sBAAA,CAyHE,gJAnIF,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,sBAAA,CAmIF,YA7IE,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA,CACA,sBAAA,CA6HE,0IAhJF,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA,CACA,sBAAA,CAuIF,YA1JE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD4BA,iBAAA,CACA,gBAAA,CAmIE,0IA7JF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD4BA,iBAAA,CACA,gBAAA,CA6IF,YAvKE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAyIE,0IA1KF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAmJF,YApLE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CA+IE,0IAvLF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CAyJF,YAjME,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAqJE,0IApMF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAkKF,UC5OE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAwJE,yCC/OF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAgKF,UCvPE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CA6JE,yCC1PF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CAsKF,YCnQE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CAmKE,6CCtQF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CA2KF,WC9QE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAwKE,2CCjRF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAkLF,cC3RE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CAuKE,iDC9RF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CA+KF,cCtSE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CA4KE,iDCzSF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CAoLF,gBCjTE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAiLE,qDCpTF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAyLF,eApLE,wCAAA,CAuLA,6CAvLA,wCAAA,CA8LF,OA1LE,iBAAA,CA6LA,6BA7LA,iBAAA,CAoMF,uBC1TE,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CA8LA,6DC7TA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CAoMF,WACE,QAAA,CAEE,+KAQE,QAAA,CAGF,4CAEE,eAAA,CE/YN,iBASI,YAAA,CACA,iBAAA,CACA,eAAA,CACA,eAAA,CACA,qBAAA,CACA,mBAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CACA,mBAAA,CACA,eCwNU,CDvNV,eAAA,CAlBI,wFAEI,mDAAA,CACA,kBAAA,CAiBR,oBACI,2CAAA,CAGJ,mBDYF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CE5GM,qBD+BN,mCAAA,CACA,wCAAA,CACA,iBAAA,CG9BA,yBAAA,CAiBA,kCAAA,CACA,gBAAA,CFnBU,sCAAA,CACA,yBAAA,CAEA,sFACI,wCAAA,CAGJ,mCACI,sCAAA,CAMZ,4BACI,eAAA,CACA,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,iBAAA,CACA,eAAA,CACA,qCAAA,CAEA,gDACI,WAAA,CAGJ,sDACI,wBAAA,CAGJ,sDACI,wBCsIK,CDrIL,kBAAA,CAGJ,8CACI,aAAA,CACA,gBAAA,CACA,kBAAA,CAGJ,qCACI,aAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","@import '@code-dot-org/component-library-styles/font';\n@import 'color';\n@import '@code-dot-org/component-library-styles/typography.module';\n@import '@code-dot-org/component-library-styles/mixins';\n\n#copyright-modal {\n    #ui-close-dialog {\n        &:focus,\n        &:focus-visible {\n            outline: 2px solid var(--borders-brand-teal-primary);\n            outline-offset: 2px;\n        }\n    }\n\n    display: flex;\n    min-width: 37.5rem;\n    max-width: 50rem;\n    max-height: 80vh;\n    box-sizing: border-box;\n    padding: 1.5rem 2rem;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 1rem;\n    border-radius: 0.5rem;\n    background: $light_white;\n    overflow: hidden;\n\n    hr {\n        border-color: var(--borders-neutral-primary);\n    }\n\n    & p {\n        @include body-three;\n\n        & a {\n            @include link-body-three;\n            color: var(--text-brand-purple-primary);\n            text-decoration: underline;\n\n            &:hover, :active, :visited {\n                color: var(--text-brand-purple-secondary);\n            }\n\n            &:focus-visible {\n                color: var(--text-brand-purple-primary);\n            }\n        }\n\n    }\n\n    .modalBody {\n        max-height: 60vh;\n        display: flex;\n        flex-direction: column;\n        align-items: flex-start;\n        overflow-x: hidden;\n        overflow-y: auto;\n        scrollbar-color: $light_gray_200 transparent; /* Scrollbar styling for Firefox browsers */\n\n        ::-webkit-scrollbar {\n            width: 0.5rem;\n        }\n\n        ::-webkit-scrollbar-track {\n            background: transparent;\n        }\n\n        ::-webkit-scrollbar-thumb {\n            background-color: $light_gray_200;\n            border-radius: 6rem;\n        }\n\n        .awsLogoContainer {\n            display: block;\n            margin-left: -2px;\n            margin-bottom: 1rem;\n        }\n\n        .awsLogo {\n            width: 11.5rem;\n        }\n    }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n"],sourceRoot:""}]);const l=i},2853:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,'#localeForm{min-width:6.25rem;max-width:50%}.languageSelect>div{display:flex;align-items:center}.languageSelect>div select{height:1.625rem;padding-inline-start:1.75rem;padding-inline-end:1.75rem}.languageSelect>div:before{position:absolute;pointer-events:none;height:1rem;width:1.5rem;padding-inline-start:.5rem;color:#394450;content:"";text-align:center;font-family:"Font Awesome 6 Pro",sans-serif;font-size:.8125rem;font-style:normal;font-weight:400;line-height:1.25}.music-black .languageSelect>div select{border-color:#fff;background-color:#394450;color:#fff}.music-black .languageSelect>div::after{background-color:initial;color:#fff}.music-black .languageSelect>div::before{background-color:initial;color:#fff}.music-black .languageSelect>div:has(select:hover) select:not(:disabled){color:#fff;background-color:#394450}.music-black .languageSelect>div:has(select:hover)::before{color:#fff}.music-black .languageSelect>div:has(select:hover)::after{color:#fff}.music-black .languageSelect>div:has(select:active) select:not(:disabled){color:#fff;background-color:#394450}.music-black .languageSelect>div:has(select:active)::before{color:#fff}.music-black .languageSelect>div:has(select:active)::after{color:#fff}',"",{version:3,sources:["webpack://./src/sharedComponents/footer/I18nDropdown/style.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAAA,YAEA,iBACE,CAAA,aACA,CAAA,oBAIA,YACE,CAAA,kBACA,CAAA,2BAEA,eACE,CAAA,4BACA,CAAA,0BACA,CAAA,2BAGF,iBACE,CAAA,mBACA,CAAA,WACA,CAAA,YACA,CAAA,0BACA,CAAA,aC2LW,CAAA,WDxLX,CAAA,iBACA,CAAA,2CAEA,CAAA,kBACA,CAAA,iBAEA,CAAA,eACA,CAAA,gBACA,CAAA,wCAQA,iBCsMQ,CAAA,wBA9BG,CAAA,UA8BH,CAAA,wCDjMR,wBACE,CAAA,UCgMM,CAAA,yCD7LR,wBACE,CAAA,UC4LM,CAAA,yEDvLN,UCuLM,CAAA,wBA9BG,CAAA,2DDrJT,UCmLM,CAAA,0DDhLN,UCgLM,CAAA,0ED1KN,UC0KM,CAAA,wBA9BG,CAAA,4DDvIT,UCqKM,CAAA,2DDlKN,UCkKM",sourcesContent:["@import 'color';\n\n#localeForm {\n  min-width: 6.25rem;\n  max-width: 50%;\n}\n\n.languageSelect {\n  > div {\n    display: flex;\n    align-items: center;\n\n    select {\n      height: 1.625rem;\n      padding-inline-start: 1.75rem;\n      padding-inline-end: 1.75rem;\n    }\n\n    &:before {\n      position: absolute;\n      pointer-events: none;\n      height: 1rem;\n      width: 1.5rem;\n      padding-inline-start: 0.5rem;\n\n      color: $light_gray_950;\n      content: '\\f0ac';\n      text-align: center;\n\n      font-family: 'Font Awesome 6 Pro', sans-serif;\n      font-size: 0.8125rem;\n\n      font-style: normal;\n      font-weight: 400;\n      line-height: 1.25;\n    }\n  }\n}\n\n.music-black {\n  .languageSelect {\n    > div {\n      select {\n        border-color: $light_white;\n        background-color: $light_gray_950;\n        color: $light_white;\n      }\n      &::after {\n        background-color: initial;\n        color: $light_white;\n      }\n      &::before {\n        background-color: initial;\n        color: $light_white;\n      }\n\n      &:has(select:hover) {\n        select:not(:disabled) {\n          color: $light_white;\n          background-color: $light_gray_950;\n        }\n        &::before {\n          color: $light_white;\n        }\n        &::after {\n          color: $light_white;\n        }\n      }\n\n      &:has(select:active) {\n        select:not(:disabled) {\n          color: $light_white;\n          background-color: $light_gray_950;\n        }\n\n        &::before {\n          color: $light_white;\n        }\n        &::after {\n          color: $light_white;\n        }\n      }\n    }\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]);const l=i},5728:(e,t,n)=>{"use strict";n.d(t,{A:()=>c});var r=n(12),o=n.n(r),a=n(13),i=n.n(a),l=n(5827),s=i()(o());s.i(l.A),s.push([e.id,'.shepherd-element{z-index:1038}.shepherd-modal-overlay-container{z-index:1035}.shepherd-element.tour-step-above-modal{z-index:1070}.tour-step-highlight{position:relative !important;outline:none}.tour-step-highlight:focus-visible{outline:2px solid var(--borders-brand-teal-primary);outline-offset:2px}.tour-step-highlight::before{content:"";position:absolute;inset:-3px;padding:3px;border-radius:inherit;background:linear-gradient(90deg, #15c5f9, #2b72ff, #8f20ec, #c710c2, #e50976, #15c5f9);background-size:300% 300%;animation:tour-highlight-gradient-shift 12s linear infinite;pointer-events:none;mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude;-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:destination-out}@supports not ((mask-composite: exclude) or (-webkit-mask-composite: destination-out)){.tour-step-highlight::before{content:none}}@media(prefers-reduced-motion: reduce){.tour-step-highlight::before{animation:none}}@keyframes tour-highlight-gradient-shift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}.custom-shepherd-onboarding-container,.custom-shepherd-step-container{font-family:var(--font-family-main);color:var(--text-neutral-primary);background-color:var(--background-neutral-primary);box-shadow:0 12px 40px rgba(28,45,94,.16);border-radius:8px}.shepherd-has-title.custom-shepherd-onboarding-container .shepherd-content .shepherd-header,.shepherd-has-title.custom-shepherd-step-container .shepherd-content .shepherd-header{background-color:var(--background-neutral-primary);padding:0;margin-bottom:8px}.shepherd-has-title.custom-shepherd-onboarding-container .shepherd-content .shepherd-cancel-icon,.shepherd-has-title.custom-shepherd-step-container .shepherd-content .shepherd-cancel-icon{color:var(--text-neutral-tertiary);position:absolute;top:12px;right:12px}.shepherd-has-title.custom-shepherd-onboarding-container .shepherd-content .shepherd-cancel-icon:hover,.shepherd-has-title.custom-shepherd-step-container .shepherd-content .shepherd-cancel-icon:hover{color:var(--text-neutral-primary)}.shepherd-has-title.custom-shepherd-onboarding-container .shepherd-content .shepherd-cancel-icon:focus-visible,.shepherd-has-title.custom-shepherd-step-container .shepherd-content .shepherd-cancel-icon:focus-visible{outline:2px solid var(--borders-brand-teal-primary);outline-offset:2px}.custom-shepherd-onboarding-container .shepherd-content,.custom-shepherd-step-container .shepherd-content{padding:24px}.custom-shepherd-onboarding-container .shepherd-text,.custom-shepherd-step-container .shepherd-text{padding:0;margin-bottom:16px;color:var(--text-neutral-tertiary)}.custom-shepherd-onboarding-container .shepherd-footer,.custom-shepherd-step-container .shepherd-footer{padding:0;gap:8px}.custom-shepherd-onboarding-container h3,.custom-shepherd-step-container h3{font-size:1.25rem;font-weight:500;line-height:28px}.custom-shepherd-onboarding-container .shepherd-button,.custom-shepherd-step-container .shepherd-button{margin:0;padding:8px 16px;transition:none;font-size:16px;font-weight:600}.custom-shepherd-onboarding-container .shepherd-button:focus-visible,.custom-shepherd-step-container .shepherd-button:focus-visible{outline:2px solid var(--borders-brand-teal-primary);outline-offset:2px}.custom-shepherd-onboarding-container .custom-shepherd-button-primary,.custom-shepherd-step-container .custom-shepherd-button-primary{background:var(--background-brand-purple-primary);color:var(--text-neutral-white-fixed)}.custom-shepherd-onboarding-container .custom-shepherd-button-primary:not(:disabled):hover,.custom-shepherd-step-container .custom-shepherd-button-primary:not(:disabled):hover{background:var(--background-brand-purple-strong)}.custom-shepherd-onboarding-container .custom-shepherd-button-primary:disabled,.custom-shepherd-step-container .custom-shepherd-button-primary:disabled,.custom-shepherd-onboarding-container .custom-shepherd-button-primary[aria-disabled=true],.custom-shepherd-step-container .custom-shepherd-button-primary[aria-disabled=true]{background:var(--background-neutral-disabled);color:var(--text-neutral-disabled-inverse)}.custom-shepherd-onboarding-container .custom-shepherd-button-secondary,.custom-shepherd-step-container .custom-shepherd-button-secondary{border:1px solid var(--borders-neutral-solid);background-color:var(--background-neutral-primary);color:var(--text-neutral-primary)}.custom-shepherd-onboarding-container .custom-shepherd-button-secondary:not(:disabled):hover,.custom-shepherd-step-container .custom-shepherd-button-secondary:not(:disabled):hover{background-color:var(--background-neutral-tertiary);border:1px solid var(--borders-neutral-solid);color:var(--text-neutral-primary)}.custom-shepherd-onboarding-container .custom-shepherd-button-secondary:disabled,.custom-shepherd-step-container .custom-shepherd-button-secondary:disabled,.custom-shepherd-onboarding-container .custom-shepherd-button-secondary[aria-disabled=true],.custom-shepherd-step-container .custom-shepherd-button-secondary[aria-disabled=true]{border-color:var(--borders-neutral-disabled);color:var(--text-neutral-disabled);background-color:var(--background-neutral-primary)}.shepherd-element.shepherd-has-title[data-popper-placement^=bottom].custom-shepherd-onboarding-container>.shepherd-arrow:before,.shepherd-element.shepherd-has-title[data-popper-placement^=bottom].custom-shepherd-step-container>.shepherd-arrow:before{background-color:var(--background-neutral-primary)}.onboarding-completion-content{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px}.onboarding-completion-content .onboarding-completion-emoji{font-size:48px;line-height:1}.onboarding-completion-step .shepherd-footer,.onboarding-stacked-buttons .shepherd-footer{flex-direction:column;align-items:stretch}.onboarding-step-content{display:flex;flex-direction:row;align-items:flex-start;gap:12px}.onboarding-sparkle-icon{flex-shrink:0;margin-top:2px;background:linear-gradient(to right, #15c5f9, #2b72ff, #8f20ec, #c710c2, #e50976);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:rgba(0,0,0,0)}.onboarding-step-text{flex:1}.quiz-options-grid{display:flex;flex-direction:column;gap:8px;margin-top:16px}.quiz-option{padding:10px 16px;border:1px solid var(--neutral-white-alpha-30);border-radius:6px;background:rgba(0,0,0,0);color:var(--neutral-base-white);font-family:var(--font-family-main);font-size:14px;font-weight:500;cursor:pointer;text-align:left;transition:border-color .15s}.quiz-option:not(:disabled):hover{border-color:var(--neutral-white-alpha-70)}.quiz-option:disabled{cursor:default}div .quiz-option-wrong{border-color:#e53e3e;background-color:rgba(229,62,62,.15);color:var(--accent-strawberry-40)}div .quiz-option-correct{border-color:#38a169;background-color:rgba(56,161,105,.15);color:#68d391}.quiz-feedback{margin-top:12px;font-family:var(--font-family-main);font-size:14px;font-weight:600;color:var(--neutral-gray-50)}.custom-shepherd-onboarding-container{background-color:var(--neutral-base-black);color:var(--neutral-base-white)}.custom-shepherd-onboarding-container .shepherd-content{display:flex;flex-direction:row;flex-wrap:wrap;align-items:flex-start;padding:12px 14px 14px 14px;gap:8px}.custom-shepherd-onboarding-container .shepherd-text{flex:1;min-width:0;order:1;color:var(--neutral-base-white);padding:0;margin-bottom:0}.custom-shepherd-onboarding-container .shepherd-header{order:2;flex-shrink:0;padding:0 !important}.custom-shepherd-onboarding-container.shepherd-has-title .shepherd-content .shepherd-header{background-color:rgba(0,0,0,0);padding:0;margin-bottom:0}.custom-shepherd-onboarding-container .shepherd-cancel-icon{position:static;color:var(--neutral-base-white)}.custom-shepherd-onboarding-container .shepherd-cancel-icon:hover{color:#c8c8c8}.custom-shepherd-onboarding-container .shepherd-footer{flex-basis:100%;order:3;padding:0;gap:8px;justify-content:flex-end}.custom-shepherd-onboarding-container.shepherd-element>.shepherd-arrow:before{background-color:var(--neutral-base-black)}.onboarding-syllabus-review-level-step{width:276px}.onboarding-progress-table-step{width:240px}.onboarding-step-text-stack{display:flex;flex-direction:column}.onboarding-step-supportive-text{color:var(--neutral-white-alpha-60);font-size:12px;margin-top:8px}',"",{version:3,sources:["webpack://./src/sharedComponents/productTour/shepherd.scss","webpack://./../frontend/packages/component-library-styles/variables.scss"],names:[],mappings:"AAMA,kBACE,YAAA,CAGF,kCACE,YAAA,CAMF,wCACE,YCFe,CDKjB,qBACE,4BAAA,CACA,YAAA,CAEA,mCACE,mDAAA,CACA,kBAAA,CAGF,6BACE,UAAA,CACA,iBAAA,CACA,UAAA,CACA,WAAA,CACA,qBAAA,CACA,uFAAA,CASA,yBAAA,CACA,2DAAA,CACA,mBAAA,CAGA,oEAAA,CACA,sBAAA,CACA,4EAAA,CAEA,sCAAA,CAIJ,uFAGE,6BACE,YAAA,CAAA,CAIJ,uCACE,6BACE,cAAA,CAAA,CAIJ,yCACE,GACE,0BAAA,CAGF,IACE,4BAAA,CAGF,KACE,0BAAA,CAAA,CAKJ,sEACE,mCAAA,CACA,iCAAA,CACA,kDAAA,CACA,yCAAA,CACA,iBAAA,CAEA,kLACE,kDAAA,CACA,SAAA,CACA,iBAAA,CAGF,4LACE,kCAAA,CACA,iBAAA,CACA,QAAA,CACA,UAAA,CAEA,wMACE,iCAAA,CAGF,wNACE,mDAAA,CACA,kBAAA,CAIJ,0GACE,YAAA,CAGF,oGACE,SAAA,CACA,kBAAA,CACA,kCAAA,CAGF,wGACE,SAAA,CACA,OAAA,CAGF,4EACE,iBAAA,CACA,eAAA,CACA,gBAAA,CAGF,wGACE,QAAA,CACA,gBAAA,CACA,eAAA,CACA,cAAA,CACA,eAAA,CAGF,oIACE,mDAAA,CACA,kBAAA,CAIF,sIACE,iDAAA,CACA,qCAAA,CAEA,gLACE,gDAAA,CAGF,sUAEE,6CAAA,CACA,0CAAA,CAKJ,0IACE,6CAAA,CACA,kDAAA,CACA,iCAAA,CAEA,oLACE,mDAAA,CACA,6CAAA,CACA,iCAAA,CAGF,8UAGE,4CAAA,CACA,kCAAA,CACA,kDAAA,CAKJ,0PAEE,kDAAA,CASJ,+BACE,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,iBAAA,CACA,OAAA,CAEA,4DACE,cAAA,CACA,aAAA,CAIJ,0FAEE,qBAAA,CACA,mBAAA,CAGF,yBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,QAAA,CAGF,yBACE,aAAA,CACA,cAAA,CACA,iFAAA,CAQA,oBAAA,CACA,4BAAA,CACA,qCAAA,CAGF,sBACE,MAAA,CAIF,mBACE,YAAA,CACA,qBAAA,CACA,OAAA,CACA,eAAA,CAGF,aACE,iBAAA,CACA,8CAAA,CACA,iBAAA,CACA,wBAAA,CACA,+BAAA,CACA,mCAAA,CACA,cAAA,CACA,eAAA,CACA,cAAA,CACA,eAAA,CACA,4BAAA,CAEA,kCACE,0CAAA,CAGF,sBACE,cAAA,CAIJ,uBACE,oBAAA,CACA,oCAAA,CACA,iCAAA,CAGF,yBACE,oBAAA,CACA,qCAAA,CACA,aAAA,CAGF,eACE,eAAA,CACA,mCAAA,CACA,cAAA,CACA,eAAA,CACA,4BAAA,CAIF,sCAGE,0CAAA,CACA,+BAAA,CAIA,wDACE,YAAA,CACA,kBAAA,CACA,cAAA,CACA,sBAAA,CACA,2BAAA,CACA,OAAA,CAIF,qDACE,MAAA,CACA,WAAA,CACA,OAAA,CACA,+BAAA,CACA,SAAA,CACA,eAAA,CAIF,uDACE,OAAA,CACA,aAAA,CACA,oBAAA,CAGF,4FACE,8BAAA,CACA,SAAA,CACA,eAAA,CAIF,4DACE,eAAA,CACA,+BAAA,CAEA,kEACE,aAAA,CAKJ,uDACE,eAAA,CACA,OAAA,CACA,SAAA,CACA,OAAA,CACA,wBAAA,CAGF,8EACE,0CAAA,CAIJ,uCACE,WAAA,CAGF,gCACE,WAAA,CAGF,4BACE,YAAA,CACA,qBAAA,CAGF,iCACE,mCAAA,CACA,cAAA,CACA,cAAA",sourcesContent:["@import 'shepherd.js/dist/css/shepherd.css';\n@import 'color.scss';\n@import '@code-dot-org/component-library-styles/variables.scss';\n\n// Keep Shepherd below our modal stack ($zindex-modal-backdrop, $zindex-modal)\n// so dialogs that open during a tour appear on top.\n.shepherd-element {\n  z-index: $zindex-modal-backdrop - 2;\n}\n\n.shepherd-modal-overlay-container {\n  z-index: $zindex-modal-backdrop - 5;\n}\n\n// Opt-in for steps that attach to an element inside an open modal.\n// Add 'tour-step-above-modal' to the step's `classes` to restore\n// the step above the modal stack.\n.shepherd-element.tour-step-above-modal {\n  z-index: $zindex-popover;\n}\n\n.tour-step-highlight {\n  position: relative !important;\n  outline: none;\n\n  &:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: 2px;\n  }\n\n  &::before {\n    content: '';\n    position: absolute;\n    inset: -3px;\n    padding: 3px;\n    border-radius: inherit;\n    background: linear-gradient(\n      90deg,\n      #15c5f9,\n      #2b72ff,\n      #8f20ec,\n      #c710c2,\n      #e50976,\n      #15c5f9\n    );\n    background-size: 300% 300%;\n    animation: tour-highlight-gradient-shift 12s linear infinite;\n    pointer-events: none;\n    // Mask punches a hole in the interior so only the 3px border ring is painted,\n    // regardless of whether the highlighted element has a background.\n    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n    mask-composite: exclude;\n    -webkit-mask: linear-gradient(#000 0 0) content-box,\n      linear-gradient(#000 0 0);\n    -webkit-mask-composite: destination-out;\n  }\n}\n\n@supports not (\n  (mask-composite: exclude) or (-webkit-mask-composite: destination-out)\n) {\n  .tour-step-highlight::before {\n    content: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tour-step-highlight::before {\n    animation: none;\n  }\n}\n\n@keyframes tour-highlight-gradient-shift {\n  0% {\n    background-position: 0% 50%;\n  }\n\n  50% {\n    background-position: 100% 50%;\n  }\n\n  100% {\n    background-position: 0% 50%;\n  }\n}\n\n// Shared styles for all shepherd step containers.\n%shepherd-step-container-base {\n  font-family: var(--font-family-main);\n  color: var(--text-neutral-primary);\n  background-color: var(--background-neutral-primary);\n  box-shadow: 0 12px 40px rgb(28 45 94 / 16%);\n  border-radius: 8px;\n\n  &.shepherd-has-title .shepherd-content .shepherd-header {\n    background-color: var(--background-neutral-primary);\n    padding: 0;\n    margin-bottom: 8px;\n  }\n\n  &.shepherd-has-title .shepherd-content .shepherd-cancel-icon {\n    color: var(--text-neutral-tertiary);\n    position: absolute;\n    top: 12px;\n    right: 12px;\n\n    &:hover {\n      color: var(--text-neutral-primary);\n    }\n\n    &:focus-visible {\n      outline: 2px solid var(--borders-brand-teal-primary);\n      outline-offset: 2px;\n    }\n  }\n\n  .shepherd-content {\n    padding: 24px;\n  }\n\n  .shepherd-text {\n    padding: 0;\n    margin-bottom: 16px;\n    color: var(--text-neutral-tertiary);\n  }\n\n  .shepherd-footer {\n    padding: 0;\n    gap: 8px;\n  }\n\n  h3 {\n    font-size: 1.25rem;\n    font-weight: 500;\n    line-height: 28px;\n  }\n\n  .shepherd-button {\n    margin: 0;\n    padding: 8px 16px;\n    transition: none;\n    font-size: 16px;\n    font-weight: 600;\n  }\n\n  .shepherd-button:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: 2px;\n  }\n\n  // Aligned with purple primary button styles.\n  .custom-shepherd-button-primary {\n    background: var(--background-brand-purple-primary);\n    color: var(--text-neutral-white-fixed);\n\n    &:not(:disabled):hover {\n      background: var(--background-brand-purple-strong);\n    }\n\n    &:disabled,\n    &[aria-disabled='true'] {\n      background: var(--background-neutral-disabled);\n      color: var(--text-neutral-disabled-inverse);\n    }\n  }\n\n  // Aligned with secondary black button styles.\n  .custom-shepherd-button-secondary {\n    border: 1px solid var(--borders-neutral-solid);\n    background-color: var(--background-neutral-primary);\n    color: var(--text-neutral-primary);\n\n    &:not(:disabled):hover {\n      background-color: var(--background-neutral-tertiary);\n      border: 1px solid var(--borders-neutral-solid);\n      color: var(--text-neutral-primary);\n    }\n\n    &:disabled,\n    &[aria-disabled='true'],\n    &[aria-disabled='true']:hover {\n      border-color: var(--borders-neutral-disabled);\n      color: var(--text-neutral-disabled);\n      background-color: var(--background-neutral-primary);\n    }\n  }\n\n  // The default style for the bottom arrow is a gray color, we want white.\n  &.shepherd-element.shepherd-has-title[data-popper-placement^='bottom']\n    > .shepherd-arrow:before {\n    background-color: var(--background-neutral-primary);\n  }\n}\n\n// Style the shepherd step container to approximately match the dsco popover.\n.custom-shepherd-step-container {\n  @extend %shepherd-step-container-base;\n}\n\n.onboarding-completion-content {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  gap: 8px;\n\n  .onboarding-completion-emoji {\n    font-size: 48px;\n    line-height: 1;\n  }\n}\n\n.onboarding-completion-step .shepherd-footer,\n.onboarding-stacked-buttons .shepherd-footer {\n  flex-direction: column;\n  align-items: stretch;\n}\n\n.onboarding-step-content {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.onboarding-sparkle-icon {\n  flex-shrink: 0;\n  margin-top: 2px;\n  background: linear-gradient(\n    to right,\n    #15c5f9,\n    #2b72ff,\n    #8f20ec,\n    #c710c2,\n    #e50976\n  );\n  background-clip: text;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.onboarding-step-text {\n  flex: 1;\n}\n\n// Quiz step: column of answer option buttons.\n.quiz-options-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.quiz-option {\n  padding: 10px 16px;\n  border: 1px solid var(--neutral-white-alpha-30);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--neutral-base-white);\n  font-family: var(--font-family-main);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  text-align: left;\n  transition: border-color 0.15s;\n\n  &:not(:disabled):hover {\n    border-color: var(--neutral-white-alpha-70);\n  }\n\n  &:disabled {\n    cursor: default;\n  }\n}\n\ndiv .quiz-option-wrong {\n  border-color: #e53e3e;\n  background-color: rgb(229 62 62 / 15%);\n  color: var(--accent-strawberry-40);\n}\n\ndiv .quiz-option-correct {\n  border-color: #38a169;\n  background-color: rgb(56 161 105 / 15%);\n  color: #68d391;\n}\n\n.quiz-feedback {\n  margin-top: 12px;\n  font-family: var(--font-family-main);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--neutral-gray-50);\n}\n\n// Onboarding tour step container styles.\n.custom-shepherd-onboarding-container {\n  @extend %shepherd-step-container-base;\n\n  background-color: var(--neutral-base-black);\n  color: var(--neutral-base-white);\n\n  // Lay out the content as a flex row so the sparkle+text and the X button\n  // all sit on the same line, with the footer wrapping beneath.\n  .shepherd-content {\n    display: flex;\n    flex-direction: row;\n    flex-wrap: wrap;\n    align-items: flex-start;\n    padding: 12px 14px 14px 14px;\n    gap: 8px;\n  }\n\n  // Text takes all available width and renders first.\n  .shepherd-text {\n    flex: 1;\n    min-width: 0;\n    order: 1;\n    color: var(--neutral-base-white);\n    padding: 0;\n    margin-bottom: 0;\n  }\n\n  // Header only contains the cancel icon here; push it to the right.\n  .shepherd-header {\n    order: 2;\n    flex-shrink: 0;\n    padding: 0 !important;\n  }\n\n  &.shepherd-has-title .shepherd-content .shepherd-header {\n    background-color: transparent;\n    padding: 0;\n    margin-bottom: 0;\n  }\n\n  // Take the cancel icon out of absolute positioning so it sits inline.\n  .shepherd-cancel-icon {\n    position: static;\n    color: var(--neutral-base-white);\n\n    &:hover {\n      color: rgb(200 200 200);\n    }\n  }\n\n  // Footer wraps to a second row and aligns buttons to the right.\n  .shepherd-footer {\n    flex-basis: 100%;\n    order: 3;\n    padding: 0;\n    gap: 8px;\n    justify-content: flex-end;\n  }\n\n  &.shepherd-element > .shepherd-arrow:before {\n    background-color: var(--neutral-base-black);\n  }\n}\n\n.onboarding-syllabus-review-level-step {\n  width: 276px;\n}\n\n.onboarding-progress-table-step {\n  width: 240px;\n}\n\n.onboarding-step-text-stack {\n  display: flex;\n  flex-direction: column;\n}\n\n.onboarding-step-supportive-text {\n  color: var(--neutral-white-alpha-60);\n  font-size: 12px;\n  margin-top: 8px;\n}\n","// Design System wide common variables\n\n$form-field-width: 18.75rem;\n\n// Border radius\n$regular-border-radius: 0.25rem;\n\n// z-index values\n// These values match Bootstrap's z-index values\n// See: https://getbootstrap.com/docs/5.0/layout/z-index/\n$zindex-dropdown: 1000;\n$zindex-sticky: 1020;\n$zindex-fixed: 1030;\n$zindex-modal-backdrop: 1040;\n$zindex-offcanvas: 1050;\n$zindex-modal: 1060;\n$zindex-popover: 1070;\n$zindex-tooltip: 1080;\n"],sourceRoot:""}]);const c=s},7742:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,'.ufiSFXKgA0RyYr2aYsFR{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-heading);font-weight:var(--font-weight-semi-bold);font-size:3rem;line-height:1.08;letter-spacing:-0.01em}.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h1,.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h2,.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h3,.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h4,.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h5,.ufiSFXKgA0RyYr2aYsFR.od3l2M8t9pKnTz7zp2zE h6{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-heading);font-weight:var(--font-weight-semi-bold);font-size:3rem;line-height:1.08;letter-spacing:-0.01em}.pmgen7RXjSLdAfZQBCoi{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-heading);font-weight:var(--font-weight-semi-bold);font-size:2.375rem;line-height:1.05;letter-spacing:-0.01em}.pmgen7RXjSLdAfZQBCoi.od3