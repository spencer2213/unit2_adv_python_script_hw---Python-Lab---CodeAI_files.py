eAi.css (canonical CADS\n * exports), rescoped under [data-brand='codeai-audit'] with every\n * primitive replaced by a pink of the same ramp position, by\n * scripts/generateBrandCodeAiAudit.mjs. Re-run that script after design\n * re-exports either source file.\n *\n * This is the DSCO-coverage audit tool, reached with ?brand=codeai-audit\n * (see Cdo::Brand). Everything that resolves through the token system\n * renders pink; anything left with a hard-coded color does not, and is a\n * bug to file. Comments below are the canonical files' own and describe\n * the real CADS palette, not these values.\n */\n\n/* Primitive Colors */\n\n/* This file consists of primitive color tokens. These values are fixed, theme-agnostic and defined at the level of the brand guidelines. */\n\n/* Aim to use semantic color tokens (colors.css) over primitive colors in the majority of cases. Primitive colors may be used for components that are truly theme-agnostic and have no semantic meaning. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* stylelint-disable color-hex-length */\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'],\n[data-brand='codeai-audit'][data-theme='Light'],\n[data-brand='codeai-audit'] [data-theme='Light'],\n[data-brand='codeai-audit'][data-theme='Dark'],\n[data-brand='codeai-audit'] [data-theme='Dark'] {\n  --brand-purple-5: #fff0f7;\n  --brand-purple-10: #ffe0ef;\n  --brand-purple-20: #ffd6ec;\n  --brand-purple-30: #ffb3dc;\n  --brand-purple-40: #ff8fc9;\n  --brand-purple-50: #ff69b4;\n  --brand-purple-60: #e8488f;\n  --brand-purple-70: #cc2b7a;\n  --brand-purple-80: #b02e6c;\n  --brand-purple-90: #99255d;\n  --brand-purple-95: #8f2058;\n  --brand-orange-5: #fff0f7;\n  --brand-orange-10: #ffe0ef;\n  --brand-orange-20: #ffd6ec;\n  --brand-orange-30: #ffb3dc;\n  --brand-orange-40: #ff8fc9;\n  --brand-orange-50: #ff69b4;\n  --brand-orange-60: #e8488f;\n  --brand-orange-70: #cc2b7a;\n  --brand-orange-80: #b02e6c;\n  --brand-orange-90: #99255d;\n  --brand-orange-95: #8f2058;\n  --brand-pink-5: #fff0f7;\n  --brand-pink-10: #ffe0ef;\n  --brand-pink-20: #ffd6ec;\n  --brand-pink-30: #ffb3dc;\n  --brand-pink-40: #ff8fc9;\n  --brand-pink-50: #ff69b4;\n  --brand-pink-60: #e8488f;\n  --brand-pink-70: #cc2b7a;\n  --brand-pink-80: #b02e6c;\n  --brand-pink-90: #99255d;\n  --brand-pink-95: #8f2058;\n  --neutral-base-black: #5c0f38;\n  --neutral-base-true-black: #3d0823;\n  --neutral-base-white: #fff8fc;\n  --neutral-black-alpha-5: #ff69b40d;\n  --neutral-black-alpha-10: #ff69b41a;\n  --neutral-black-alpha-20: #ff69b433;\n  --neutral-black-alpha-30: #ff69b44d;\n  --neutral-black-alpha-40: #ff69b466;\n  --neutral-black-alpha-50: #ff69b480;\n  --neutral-black-alpha-60: #ff69b499;\n  --neutral-black-alpha-70: #ff69b4b2;\n  --neutral-black-alpha-80: #ff69b4cc;\n  --neutral-black-alpha-90: #ff69b4e5;\n  --neutral-black-alpha-95: #ff69b4f2;\n  --neutral-gray-5: #fff0f7;\n  --neutral-gray-10: #ffe0ef;\n  --neutral-gray-20: #ffd6ec;\n  --neutral-gray-30: #ffb3dc;\n  --neutral-gray-40: #ff69b4;\n  --neutral-gray-50: #e8488f;\n  --neutral-gray-60: #cc2b7a;\n  --neutral-gray-70: #b02e6c;\n  --neutral-gray-80: #99255d;\n  --neutral-gray-90: #8f2058;\n  --neutral-gray-95: #6e1543;\n  --neutral-white-alpha-5: #ff69b40d;\n  --neutral-white-alpha-10: #ff69b41a;\n  --neutral-white-alpha-20: #ff69b433;\n  --neutral-white-alpha-30: #ff69b44d;\n  --neutral-white-alpha-40: #ff69b466;\n  --neutral-white-alpha-50: #ff69b480;\n  --neutral-white-alpha-60: #ff69b499;\n  --neutral-white-alpha-70: #ff69b4b2;\n  --neutral-white-alpha-80: #ff69b4cc;\n  --neutral-white-alpha-90: #ff69b4e5;\n  --neutral-white-alpha-95: #ff69b4f2;\n  --sentiment-error-5: #fff0f7;\n  --sentiment-error-10: #ffe0ef;\n  --sentiment-error-20: #ffd6ec;\n  --sentiment-error-30: #ffb3dc;\n  --sentiment-error-40: #ff8fc9;\n  --sentiment-error-50: #ff69b4;\n  --sentiment-error-60: #e8488f;\n  --sentiment-error-70: #cc2b7a;\n  --sentiment-error-80: #b02e6c;\n  --sentiment-error-90: #99255d;\n  --sentiment-error-95: #8f2058;\n  --sentiment-information-5: #fff0f7;\n  --sentiment-information-10: #ffe0ef;\n  --sentiment-information-20: #ffd6ec;\n  --sentiment-information-30: #ffb3dc;\n  --sentiment-information-40: #ff8fc9;\n  --sentiment-information-50: #ff69b4;\n  --sentiment-information-60: #e8488f;\n  --sentiment-information-70: #cc2b7a;\n  --sentiment-information-80: #b02e6c;\n  --sentiment-information-90: #99255d;\n  --sentiment-information-95: #8f2058;\n  --sentiment-success-5: #fff0f7;\n  --sentiment-success-10: #ffe0ef;\n  --sentiment-success-20: #ffd6ec;\n  --sentiment-success-30: #ffb3dc;\n  --sentiment-success-40: #ff8fc9;\n  --sentiment-success-50: #ff69b4;\n  --sentiment-success-60: #e8488f;\n  --sentiment-success-70: #cc2b7a;\n  --sentiment-success-80: #b02e6c;\n  --sentiment-success-90: #99255d;\n  --sentiment-success-95: #8f2058;\n  --sentiment-warning-5: #fff0f7;\n  --sentiment-warning-10: #ffe0ef;\n  --sentiment-warning-20: #ffd6ec;\n  --sentiment-warning-30: #ffb3dc;\n  --sentiment-warning-40: #ff8fc9;\n  --sentiment-warning-50: #ff69b4;\n  --sentiment-warning-60: #e8488f;\n  --sentiment-warning-70: #cc2b7a;\n  --sentiment-warning-80: #b02e6c;\n  --sentiment-warning-90: #99255d;\n  --sentiment-warning-95: #8f2058;\n}\n\n/* CADS Semantic Colors */\n\n/* This file consists of Semantic colors, if you need color tokens that support multiple themes, you need to import and use this file. */\n\n/* Raw values for Semantic colors are defined in Primitive Colors (primitiveColors.css), while semantic color values are specified for every theme. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* Light Theme Semantic Colors (light is the default theme, that's why :root rule is included) */\n[data-brand='codeai-audit']:root,\n[data-brand='codeai-audit'][data-theme='Light'],\n[data-brand='codeai-audit'] [data-theme='Light'] {\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-true-base: var(--neutral-base-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-strong: var(--sentiment-success-90);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-strong: var(--sentiment-information-90);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-selected-primary-inverse: var(--sentiment-success-5);\n  --background-disabled-brand: var(--brand-purple-5);\n  --background-disabled-error: var(--sentiment-error-5);\n  --background-disabled-info: var(--sentiment-information-5);\n\n  /* Matches background-neutral-quaternary by value today, but disabled intent is decoupled so the state can be restyled independently. */\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-disabled-orange: var(--brand-orange-5);\n  --background-disabled-pink: var(--brand-pink-5);\n  --background-disabled-success: var(--sentiment-success-5);\n  --background-disabled-warning: var(--sentiment-warning-5);\n\n  /* The Run button orange is an intentional a11y exception. It fails 4.5:1 contrast with white labels but we are keeping it for its deep user association with \"run\" (and Blockly's run blocks). */\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-10);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n\n  /* Border state selected strong and primary intentionally match the background state color. */\n  --border-selected-primary: var(--brand-purple-80);\n  --border-selected-strong: var(--brand-purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-disabled-orange: var(--brand-orange-5);\n  --border-disabled-pink: var(--brand-pink-5);\n  --border-disabled-success: var(--sentiment-success-5);\n  --border-disabled-warning: var(--sentiment-warning-5);\n  --border-focused-inverse: var(--sentiment-success-5);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-10);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-10);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-brand-primary-fixed: var(--brand-purple-50);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-warning-primary: var(--sentiment-warning-50);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-warning-primary-fixed: var(--sentiment-warning-50);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-success-primary-fixed: var(--sentiment-success-70);\n  --text-info-primary: var(--sentiment-information-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-info-primary-fixed: var(--sentiment-information-70);\n\n  /* Selected state text pairs with background and border-state-selected — always use the two together. */\n  --text-selected-primary: var(--sentiment-success-5);\n  --text-selected-primary-inverse: var(--brand-purple-95);\n  --text-disabled-brand: var(--brand-purple-5);\n  --text-disabled-error: var(--sentiment-error-5);\n  --text-disabled-info: var(--sentiment-information-5);\n  --text-disabled-neutral: var(--neutral-gray-20);\n\n  /* Single inverse for the whole disabled family: label color for solid-fill disabled elements of any color; pair with the matching background/disabled/<color>. Outline disabled elements use text/disabled/<color> instead. */\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-disabled-orange: var(--brand-orange-5);\n  --text-disabled-pink: var(--brand-pink-5);\n  --text-disabled-success: var(--sentiment-success-5);\n  --text-disabled-warning: var(--sentiment-warning-5);\n\n  /* Orange text intentionally keeps the true brand-guideline level-50 value instead of bumping for contrast */\n  --text-accent-orange-primary: var(--brand-orange-50);\n  --text-accent-orange-secondary: var(--brand-orange-70);\n  --text-accent-orange-primary-fixed: var(--brand-orange-50);\n  --text-accent-pink-primary: var(--brand-pink-50);\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-accent-pink-primary-fixed: var(--brand-pink-50);\n}\n\n/* Dark Theme Semantic Colors */\n[data-brand='codeai-audit'][data-theme='Dark'],\n[data-brand='codeai-audit'] [data-theme='Dark'] {\n  --background-neutral-primary: var(--neutral-base-black);\n  --background-neutral-secondary: var(--neutral-gray-95);\n  --background-neutral-tertiary: var(--neutral-gray-90);\n  --background-neutral-quaternary: var(--neutral-gray-80);\n  --background-neutral-quinary: var(--neutral-gray-70);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-30);\n  --background-neutral-octonary: var(--neutral-gray-20);\n  --background-neutral-primary-inverse: var(--neutral-base-white);\n  --background-neutral-true-base: var(--neutral-base-true-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-95);\n  --background-brand-mid: var(--brand-purple-80);\n\n  /* Strong variables are mostly used for hover states, in dark mode they invert and become lighter. They fail 4.5:1 contrast with labels, but we only need the default state to pass. */\n  --background-brand-strong: var(--brand-purple-40);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-95);\n  --background-error-mid: var(--sentiment-error-80);\n  --background-error-strong: var(--sentiment-error-40);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-95);\n  --background-warning-mid: var(--sentiment-warning-80);\n  --background-warning-strong: var(--sentiment-warning-40);\n\n  /* Level 70 is preserved for success even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-95);\n  --background-success-mid: var(--sentiment-success-80);\n\n  /* Bc success is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-success-strong: var(--sentiment-success-60);\n\n  /* Level 70 is preserved for info even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-95);\n  --background-info-mid: var(--sentiment-information-80);\n\n  /* Bc info is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-info-strong: var(--sentiment-information-60);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--sentiment-success-5);\n  --background-selected-strong: var(--sentiment-success-20);\n  --background-selected-primary-inverse: var(--brand-purple-80);\n  --background-disabled-brand: var(--neutral-gray-80);\n  --background-disabled-error: var(--neutral-gray-80);\n  --background-disabled-info: var(--neutral-gray-80);\n  --background-disabled-neutral: var(--neutral-gray-80);\n  --background-disabled-orange: var(--neutral-gray-80);\n  --background-disabled-pink: var(--neutral-gray-80);\n  --background-disabled-success: var(--neutral-gray-80);\n  --background-disabled-warning: var(--neutral-gray-80);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-95);\n  --background-accent-orange-mid: var(--brand-orange-80);\n  --background-accent-orange-strong: var(--brand-orange-40);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-95);\n  --background-accent-pink-mid: var(--brand-pink-80);\n  --background-accent-pink-strong: var(--brand-pink-40);\n  --border-neutral-primary: var(--neutral-gray-80);\n  --border-neutral-secondary: var(--neutral-gray-60);\n  --border-neutral-solid: var(--neutral-base-white);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n\n  /* Primary borders of all colors stay at level 50 in dark mode since contrast only needs 3:1. */\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-90);\n  --border-brand-mid: var(--brand-purple-70);\n  --border-brand-strong: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-90);\n  --border-error-mid: var(--sentiment-error-70);\n  --border-error-strong: var(--sentiment-error-30);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-90);\n  --border-warning-mid: var(--sentiment-warning-70);\n  --border-warning-strong: var(--sentiment-warning-30);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-90);\n  --border-success-mid: var(--sentiment-success-70);\n  --border-success-strong: var(--sentiment-success-30);\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-90);\n  --border-info-mid: var(--sentiment-information-70);\n  --border-info-strong: var(--sentiment-information-30);\n  --border-focused-primary: var(--brand-purple-30);\n  --border-selected-primary: var(--sentiment-success-5);\n  --border-selected-strong: var(--sentiment-success-20);\n  --border-selected-primary-inverse: var(--brand-purple-80);\n  --border-disabled-brand: var(--neutral-gray-80);\n  --border-disabled-error: var(--neutral-gray-80);\n  --border-disabled-info: var(--neutral-gray-80);\n  --border-disabled-neutral: var(--neutral-gray-80);\n  --border-disabled-orange: var(--neutral-gray-80);\n  --border-disabled-pink: var(--neutral-gray-80);\n  --border-disabled-success: var(--neutral-gray-80);\n  --border-disabled-warning: var(--neutral-gray-80);\n  --border-focused-inverse: var(--brand-purple-50);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-90);\n  --border-accent-orange-mid: var(--brand-orange-70);\n  --border-accent-orange-strong: var(--brand-orange-30);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-90);\n  --border-accent-pink-mid: var(--brand-pink-70);\n  --border-accent-pink-strong: var(--brand-pink-30);\n  --text-neutral-primary: var(--neutral-base-white);\n  --text-neutral-secondary: var(--neutral-gray-5);\n  --text-neutral-tertiary: var(--neutral-gray-10);\n  --text-neutral-quaternary: var(--neutral-gray-20);\n  --text-neutral-primary-inverse: var(--neutral-base-black);\n  --text-neutral-placeholder: var(--neutral-gray-60);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--neutral-base-white);\n  --text-brand-secondary: var(--brand-purple-5);\n  --text-brand-primary-fixed: var(--brand-purp