 .ok97i9SbMaA2zTJIovvo:hover,.C9Qsh5quT1utnjDqfHmQ .ok97i9SbMaA2zTJIovvo:hover,.IJdbY07IzEtfNrO1aCJk .ok97i9SbMaA2zTJIovvo:hover,.tL2KyXwOfMZOxowyuHLA .ok97i9SbMaA2zTJIovvo:hover{opacity:.7;transform:none;background-color:rgba(0,0,0,0)}.wucMVoP19KrewWTyKNNB .aasoNWG5MjtV10ZSmNSK,.C9Qsh5quT1utnjDqfHmQ .aasoNWG5MjtV10ZSmNSK,.IJdbY07IzEtfNrO1aCJk .aasoNWG5MjtV10ZSmNSK,.tL2KyXwOfMZOxowyuHLA .aasoNWG5MjtV10ZSmNSK{background-color:#f7f8fa;color:#292f36;border-radius:0 2px 2px 0;transition:color .8s ease,background-color .8s ease,transform .2s ease}.wucMVoP19KrewWTyKNNB .aasoNWG5MjtV10ZSmNSK.rC5Mq4GlRpQYConDIP39,.C9Qsh5quT1utnjDqfHmQ .aasoNWG5MjtV10ZSmNSK.rC5Mq4GlRpQYConDIP39,.IJdbY07IzEtfNrO1aCJk .aasoNWG5MjtV10ZSmNSK.rC5Mq4GlRpQYConDIP39,.tL2KyXwOfMZOxowyuHLA .aasoNWG5MjtV10ZSmNSK.rC5Mq4GlRpQYConDIP39{background-color:#000;color:#f7f8fa}.lEkrDs50T2ymzqWBHhim{width:4px}","",{version:3,sources:["webpack://./src/music/views/InstrumentGrid/styles.module.scss","webpack://./../shared/css/color.scss","webpack://./src/mixins.scss"],names:[],mappings:"AAqBA,sBACE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,YAAA,CACA,gBAAA,CACA,iBAAA,CACA,wBCyJa,CDtJf,sBACE,YAAA,CACA,kBAAA,CACA,kBAAA,CACA,6BAAA,CAEA,4CACE,YAAA,CACA,QAAA,CAIJ,sBACE,aAAA,CAGF,kEACE,YAAA,CACA,qBAAA,CACA,eAAA,CACA,kBAAA,CAGF,sBAEE,eAAA,CAGF,4CAGE,gBAAA,CACA,6BAAA,CAGF,sBACE,YAAA,CACA,OAAA,CACA,mBAAA,CACA,+CAAA,CACA,eAAA,CAEA,sBACE,SAAA,CACA,eAAA,CAGF,sBACE,SAAA,CACA,YAAA,CAKE,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAFF,8MAEE,wBAAA,CAMR,sBACE,YAAA,CAGF,wFE9EE,QAAA,CACA,SAAA,CACA,WAAA,CACA,eAAA,CACA,8BAAA,CF6EA,WAAA,CACA,cAAA,CE5EA,gHACE,eAAA,CAGF,oHACE,sBAAA,CF2EA,gbACE,oBAAA,CACA,wBCoEW,CDnEX,SAAA,CAKF,4MACE,kBAAA,CAIJ,gLACE,UAnHS,CAoHT,WAnHU,CAoHV,wBC0Da,CDzDb,qBAAA,CACA,uDAAA,CAEA,oQACE,wBCoDW,CDjDb,2UAEE,wBCekB,CDdlB,obACE,oBAAA,CAKN,ghBAEE,cAAA,CACA,UAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,aCyBY,CDtBd,gLAEE,WAAA,CACA,0BAAA,CACA,8BAAA,CACA,2BAAA,CACA,SAAA,CAEA,wMACE,UAAA,CACA,cAAA,CACA,8BAAA,CAIJ,gLAEE,wBCKY,CDJZ,aCeW,CDdX,yBAAA,CACA,sEAAA,CAEA,oQACE,qBAAA,CACA,aCFU,CDmBhB,sBACE,SAAA",sourcesContent:["@import '../../../mixins.scss';\n@import 'color.scss';\n\n$colors-drums: #6c5ce7, #0984e3, #00cec9, #00b894, #a29bfe, #74b9ff, #81ecec, #55efc4;\n$cell-width: 25px;\n$cell-height: 18px;\n$row-gap: 4px;\n$display-rows: 9;\n$peek-height: 5px;\n\n:export {\n  cellWidth: $cell-width;\n  cellHeight: $cell-height;\n  rowGap: $row-gap;\n  displayRows: $display-rows;\n  peekHeight: $peek-height;\n  black: $black;\n  white: $white;\n  selectedColor: var(--brand-aqua-50);\n}\n\n.container {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 10px;\n  user-select: none;\n  color-scheme: dark;\n  background-color: $neutral_dark;\n}\n\n.controlRow {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: space-between;\n\n  .left {\n    display: flex;\n    gap: 16px;\n  }\n}\n\n.flexAutoWidth {\n  flex: 0 0 auto;\n}\n\n%sequence-editor {\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n  padding-right: 16px;\n}\n\n.sequence-editor-drums {\n  @extend %sequence-editor;\n  overflow: hidden;\n}\n\n.sequence-editor-simple,\n.sequence-editor-chromatic {\n  @extend %sequence-editor;\n  max-height: ($cell-height + $row-gap) * $display-rows + ($peek-height * 2);\n  flex-direction: column-reverse;\n}\n\n.pitchRow {\n  display: flex;\n  gap: 4px;\n  align-items: stretch;\n  transition: opacity 0.8s ease, min-height 0.8s ease;\n  overflow: hidden;\n\n  &Showing {\n    opacity: 1;\n    min-height: ($cell-height + $row-gap);\n  }\n\n  &Hidden {\n    opacity: 0;\n    min-height: 0;\n  }\n\n  @for $i from 1 through 8 {\n    &:nth-child(#{$i}) {\n      .cell-outer-drums > .innerCell.selected,\n      .cell-outer-drums:hover > .innerCell.selected {\n        background-color: nth($colors-drums, 8 - $i + 1);\n      }\n    }\n  }\n}\n\n.cellRow {\n  display: flex;\n}\n\n%cell-outer,\n.cell-outer {\n  @include remove-button-styles;\n  padding: calc($row-gap / 2);\n  cursor: pointer;\n\n  &:hover,\n  &:focus-visible {\n    .innerCell {\n      transform: scale(1.2);\n      background-color: $neutral_dark40;\n      z-index: 1;\n    }\n  }\n\n  &:active {\n    .innerCell {\n      transform: scale(1);\n    }\n  }\n\n  .innerCell {\n    width: $cell-width;\n    height: $cell-height;\n    background-color: $neutral_dark80;\n    box-sizing: border-box;\n    transition: transform 0.2s ease, background-color 0.2s ease;\n\n    &.preview {\n      background-color: $neutral_dark70;\n    }\n\n    &.selected,\n    &.selected:hover {\n      background-color: $brand_primary_default;\n      &.preview {\n        transform: scale(1.2);\n      }\n    }\n  }\n\n  .label,\n  %label {\n    font-size: 12px;\n    width: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: $neutral_light;\n  }\n\n  .textLabel {\n    @extend %label;\n    width: 100px;\n    justify-content: flex-start;\n    background-color: transparent;\n    transition: opacity 0.2s ease;\n    opacity: 1;\n\n    &:hover {\n      opacity: 0.7;\n      transform: none;\n      background-color: transparent;\n    }\n  }\n\n  .keyLabel {\n    @extend %label;\n    background-color: $neutral_light;\n    color: $neutral_dark;\n    border-radius: 0 2px 2px 0;\n    transition: color 0.8s ease, background-color 0.8s ease, transform 0.2s ease;\n\n    &.blackKey {\n      background-color: black;\n      color: $neutral_light;\n    }\n  }\n}\n\n.cell-outer-simple {\n  @extend %cell-outer;\n}\n\n.cell-outer-chromatic {\n  @extend %cell-outer;\n}\n\n.cell-outer-drums {\n  @extend %cell-outer;\n}\n\n.spacer {\n  width: 4px;\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n"],sourceRoot:""}]),i.locals={cellWidth:"25px",cellHeight:"18px",rowGap:"4px",displayRows:"9",peekHeight:"5px",black:"#000",white:"#fff",selectedColor:"var(--brand-aqua-50)",container:"dEzs1BUBTpwbd9mhTRM1",controlRow:"JfMaRebW8UZBWMCWe62U",left:"PUhxVO4YNCRrfoguXc2N",flexAutoWidth:"jDNmMIOLfjjn5OdEopal","sequence-editor-simple":"LJnWA6KNmW1WZrjfjKgr","sequence-editor-chromatic":"RzsEvSkmufEcdhbIDA5n","sequence-editor-drums":"uHeAz1HY6RtMQ5YhJYK3",pitchRow:"_cakDkSBzDt3s2pCNcwe",pitchRowShowing:"TRtyAkSZi901YejGt3p7",pitchRowHidden:"ezRUYxfdIqiGWsDN_9pg","cell-outer-drums":"wucMVoP19KrewWTyKNNB",innerCell:"UfcDZ7UNY_pNhYifgcWQ",selected:"JblvBD_bFoHsxdLJV6oH",cellRow:"l_1cXEgXpCV7jCkAXuxS","cell-outer-chromatic":"C9Qsh5quT1utnjDqfHmQ","cell-outer-simple":"IJdbY07IzEtfNrO1aCJk","cell-outer":"tL2KyXwOfMZOxowyuHLA",preview:"iaSz5gyi3e6J1tGfZ9oK",label:"ABAGpsKmBakc5WqpSJOb",keyLabel:"aasoNWG5MjtV10ZSmNSK",textLabel:"ok97i9SbMaA2zTJIovvo",blackKey:"rC5Mq4GlRpQYConDIP39",spacer:"lEkrDs50T2ymzqWBHhim"};const l=i},7738:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".fES2aIn11u2jZ4EJWPLC{background-color:#292f36;display:flex;flex-direction:column;gap:10px;padding:10px;user-select:none}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi{background-color:#5f6872;color:#f7f8fa;cursor:pointer;height:50px;display:flex;align-items:center;box-sizing:border-box;padding:4px;padding-inline-end:15px;gap:20px}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .dIsdkjYlx4tZnI1bHBtr{display:contents;box-sizing:border-box;text-align:center}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .dIsdkjYlx4tZnI1bHBtr .fcAKupVAL5V2niEhtlgE{transition:opacity .1s ease-in;font-size:20px}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi:hover .XQecU0X5j8IF1ZWTk3so{transform:scale(1.05, 1.05);transition:.1s ease-in-out}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .XQecU0X5j8IF1ZWTk3so{width:42px;height:42px;transform:scale(1, 1);transition:.1s ease-in-out}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .XQecU0X5j8IF1ZWTk3so:hover,.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .UP6h3sUlGMKfgfOlCLlF{transform:scale(1.05, 1.05);transition:.1s ease-in-out}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .ExF4oVkusl8twUW01ECI{height:42px;width:42px;max-width:initial;border-radius:4px;background-color:#000}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .RHDLzGZqbFzSGwGg2umN{flex-grow:1;overflow:hidden}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .RHDLzGZqbFzSGwGg2umN .G4xGy3zkjZ14qg14m3mg{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:18px;line-height:1.5em}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .RHDLzGZqbFzSGwGg2umN .vPdPDfsBWLuyu6Rrd4aw{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .sHFBkmmhYnmuuqGjdHem{display:contents}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .yFjsgsUCeAL5QTlF7dQe{display:contents}.fES2aIn11u2jZ4EJWPLC .Dda8QRD1Qdnisbh9BLdi .yFjsgsUCeAL5QTlF7dQe .fcAKupVAL5V2niEhtlgE{transition:opacity .1s ease-in;color:#f7f8fa;font-size:16px}","",{version:3,sources:["webpack://./src/music/views/MiniMusicPlayer.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAEA,sBACE,wBCkLa,CDjLb,YAAA,CACA,qBAAA,CACA,QAAA,CACA,YAAA,CACA,gBAAA,CAEA,4CACE,wBCwKa,CDvKb,aC8JY,CD7JZ,cAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,qBAAA,CACA,WAAA,CACA,uBAAA,CACA,QAAA,CAEA,kEACE,gBAAA,CACA,qBAAA,CACA,iBAAA,CAEA,wFACE,8BAAA,CACA,cAAA,CAKF,wEACE,2BAAA,CACA,0BAAA,CAIJ,kEACE,UAAA,CACA,WAAA,CACA,qBAAA,CACA,0BAAA,CAEA,0IACE,2BAAA,CACA,0BAAA,CAGF,kEACE,WAAA,CACA,UAAA,CACA,iBAAA,CACA,iBAAA,CACA,qBClDA,CDsDJ,kEACE,WAAA,CACA,eAAA,CAEA,wFACE,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,cAAA,CACA,iBAAA,CAGF,wFACE,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,cAAA,CAIJ,kEACE,gBAAA,CAEA,kEACE,gBAAA,CAEA,wFACE,8BAAA,CACA,aCkFM,CDjFN,cAAA",sourcesContent:['@import "color.scss";\n\n.miniMusicPlayer {\n  background-color: $neutral_dark;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 10px;\n  user-select: none;\n\n  .entry {\n    background-color: $neutral_dark80;\n    color: $neutral_light;\n    cursor: pointer;\n    height: 50px;\n    display: flex;\n    align-items: center;\n    box-sizing: border-box;\n    padding: 4px;\n    padding-inline-end: 15px;\n    gap: 20px;\n\n    .control {\n      display: contents;\n      box-sizing: border-box;\n      text-align: center;\n\n      .icon {\n        transition: opacity 0.1s ease-in;\n        font-size: 20px;\n      }\n    }\n\n    &:hover {\n      .pack {\n        transform: scale(1.05, 1.05);\n        transition: 0.1s ease-in-out;\n      }\n    }\n\n    .pack {\n      width: 42px;\n      height: 42px;\n      transform: scale(1, 1);\n      transition: 0.1s ease-in-out;\n\n      &:hover, &Playing {\n        transform: scale(1.05, 1.05);\n        transition: 0.1s ease-in-out;\n      }\n\n      &Image {\n        height: 42px;\n        width: 42px;\n        max-width: initial;\n        border-radius: 4px;\n        background-color: $black;\n      }\n    }\n\n    .body {\n      flex-grow: 1;\n      overflow: hidden;\n\n      .name {\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        font-size: 18px;\n        line-height: 1.5em;\n      }\n\n      .details {\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        font-size: 12px;\n      }\n    }\n\n    .other {\n      display: contents;\n\n      &Link {\n        display: contents;\n\n        .icon {\n          transition: opacity 0.1s ease-in;\n          color: $neutral_light;\n          font-size: 16px;\n        }\n      }\n    }\n  }\n}\n',"// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 