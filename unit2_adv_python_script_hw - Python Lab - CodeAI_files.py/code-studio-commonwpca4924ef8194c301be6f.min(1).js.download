CAAA,CACA,wDAAA,CACA,0CAAA,CAEA,4PACE,eAAA,CACA,6DAAA,CAGF,yiBAEE,6DAAA,CACA,yCAAA,CAIJ,kNACE,2CAAA,CACA,yDAAA,CACA,gBAAA,CACA,+CAAA,CAEA,4PACE,eAAA,CACA,wCAAA,CACA,kDAAA,CAGF,yiBAEE,6DAAA,CACA,yCAAA,CAIJ,kNACE,2CAAA,CACA,gEAAA,CACA,gBAAA,CACA,+CAAA,CAEA,4PACE,eAAA,CACA,+CAAA,CACA,yDAAA,CACA,oEAAA,CAGF,yiBAEE,2CAAA,CACA,oEAAA,CACA,yCAAA,CAIJ,kNACE,2CAAA,CACA,2DAAA,CACA,gBAAA,CACA,+CAAA,CAEA,4PACE,eAAA,CACA,0CAAA,CACA,kDAAA,CACA,6DAAA,CAGF,yiBAEE,6DAAA,CACA,yCAAA,CAKJ,kNACE,2CAAA,CACA,gEAAA,CACA,yDAAA,CACA,iBAAA,CACA,gBAAA,CACA,gBAAA,CAEA,4PACE,eAAA,CACA,2CAAA,CACA,wDAAA,CACA,+DAAA,CAGF,oTAxNF,4DAAA,CACA,kBAAA,CA2NE,yiBAEE,8DAAA,CACA,WAAA,CAIJ,kNACE,0CAAA,CACA,wDAAA,CACA,sDAAA,CACA,iBAAA,CACA,gBAAA,CAEA,4PACE,6DAAA,CAGF,oTA9OF,4DAAA,CACA,kBAAA,CAiPE,iRACE,2CAAA,CACA,qDAAA,CACA,wDAAA,CACA,kBAAA,CAMF,0sBACE,iBAAA,CACA,kBAAA,CCtMJ,mCAAA,CACA,wCAAA,CACA,iBAAA,CDyME,sgBACE,gBAAA,CAKJ,kNACE,WAhRoB,CAiRpB,cAAA,CACA,gBAAA,CAGF,kNACE,WArRkB,CAsRlB,cAAA,CACA,gBAAA,CAGF,kNACE,WA1RmB,CA2RnB,cAAA,CACA,gBAAA,CAGF,kNACE,WA/RkB,CAgSlB,aAAA,CACA,gBAAA,CACA,iBAAA,CAEA,4WACE,cAAA,CACA,KAAA,CAKJ,kNACE,gBAAA,CAGF,kNACE,gBAAA,CAGF,kNCxPA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwPE,6CAAA,CACA,cAAA,CACA,sBAAA,CACA,eAAA,CACA,SAAA,CACA,QAAA,CAEA,4PACE,sBAAA,CAGF,iRACE,2CAAA,CAIJ,kNACE,+CAAA,CACA,cAAA,CACA,iBAAA,CAEA,4PACE,iDAAA,CAGF,oTA3UF,4DAAA,CACA,kBAAA,CA4UI,oBAAA",sourcesContent:["@import '@code-dot-org/component-library-styles/font';\n\n// Note: Keep these constants in sync with Button.jsx.\n$button-height-default: 34px;\n$button-height-large: 40px;\n$button-height-narrow: 40px;\n$button-height-small: 20px;\n\n@mixin focus-outline {\n  outline: var(--borders-brand-teal-primary, #0093a4) solid 2px;\n  outline-offset: 2px;\n}\n\n/* stylelint-disable selector-pseudo-class-no-unknown */\ndiv,\nbutton,\na,\na:link,\na:visited,\n// Global .header a styles override application.scss.\n:global(.header) a:link,\n:global(.header) a:visited {\n  /* stylelint-enable selector-pseudo-class-no-unknown */\n  &.main {\n    @include main-font-regular;\n    display: inline-block;\n    font-size: 12px;\n    border: 1px solid var(--borders-neutral-strong, #b7c1cb);\n    border-radius: 3px;\n    text-decoration: none;\n    box-sizing: border-box;\n    overflow: hidden;\n    white-space: nowrap;\n\n    &:hover {\n      background-color: var(--background-neutral-primary, #fff);\n      cursor: pointer;\n    }\n\n    &:disabled,\n    &[disabled] {\n      // Override the cursor:pointer on disabled elements.\n      cursor: auto;\n    }\n  }\n\n  // Note no \"&\" on these two, since they'll be on child elements.\n  .icon {\n    margin-right: 2.5px;\n    margin-left: 2.5px;\n  }\n\n  .textSpan {\n    margin-right: 2.5px;\n    margin-left: 2.5px;\n  }\n\n  // Button colors.\n  &.orange {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-accent-orange-primary, #ffb42e);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.63);\n\n    &:hover {\n      // accent-orange has no text/border semantic token; use the primitive.\n      color: var(--accent-orange-60, #ffa400);\n      border-color: var(--accent-orange-60, #ffa400);\n    }\n\n    &:disabled,\n    &[disabled] {\n      // Nearest DSCO orange tint to the legacy disabled color (#ffd27f).\n      background-color: var(--accent-orange-30, #ffd58a);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.gray {\n    color: var(--text-neutral-primary, #292f36);\n    background-color: var(--background-neutral-secondary, #f0f2f5);\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.73);\n\n    &:disabled,\n    &[disabled] {\n      background-color: var(--background-neutral-disabled, #d4dae1);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.blue {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-info-strong, #19bbb5);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.4);\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-info-secondary, #19bbb5);\n      border-color: var(--borders-info-strong, #19bbb5);\n      background-color: var(--background-info-extra-light, #ebfffe);\n    }\n\n    &:disabled,\n    &[disabled] {\n      color: var(--text-neutral-disabled, #d4dae1);\n      background-color: var(--background-info-extra-light, #ebfffe);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.teal {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-brand-teal-primary, #00818f);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.4);\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-brand-teal-primary, #0093a4);\n      border-color: var(--borders-brand-teal-primary, #0093a4);\n      background-color: var(--background-brand-teal-extra-light, #e0f8f9);\n    }\n\n    &:disabled,\n    &[disabled] {\n      color: var(--text-neutral-disabled, #d4dae1);\n      background-color: var(--background-info-extra-light, #ebfffe);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.white {\n    color: var(--text-neutral-primary, #292f36);\n    background-color: var(--background-neutral-primary, #fff);\n    box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.06);\n\n    &:hover {\n      box-shadow: none;\n      background-color: var(--background-neutral-secondary, #f0f2f5);\n    }\n\n    &:disabled,\n    &[disabled] {\n      background-color: var(--background-neutral-secondary, #f0f2f5);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.red {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-error-primary, #e02d16);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.4);\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-error-primary, #e02d16);\n      border-color: var(--borders-error-primary, #e02d16);\n    }\n\n    &:disabled,\n    &[disabled] {\n      background-color: var(--background-error-extra-light, #ffe1dd);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.purple {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-brand-purple-primary, #9657c7);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.4);\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-brand-purple-primary, #9657c7);\n      border-color: var(--borders-brand-purple-primary, #9657c7);\n      background-color: var(--background-brand-purple-extra-light, #f2e2ff);\n    }\n\n    &:disabled,\n    &[disabled] {\n      color: var(--text-neutral-disabled, #d4dae1);\n      background-color: var(--background-brand-purple-extra-light, #f2e2ff);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  &.green {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-success-primary, #3ea33e);\n    font-weight: bold;\n    box-shadow: inset 0 2px 0 0 rgba(255 255 255 / 0.4);\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-neutral-primary, #292f36);\n      border-color: var(--borders-neutral-light, #dfe3e9);\n      background-color: var(--background-neutral-secondary, #f0f2f5);\n    }\n\n    &:disabled,\n    &[disabled] {\n      background-color: var(--background-neutral-secondary, #f0f2f5);\n      box-shadow: inset 0 2px 0 0 rgba(0 0 0 / 0.1);\n    }\n  }\n\n  // Phase 1 of CodeAI Redesign - Colors\n  &.brandSecondaryDefault {\n    color: var(--text-neutral-white-fixed, #fff);\n    background-color: var(--background-brand-purple-primary, #9657c7);\n    border-color: var(--borders-brand-purple-primary, #9657c7);\n    border-radius: 4px;\n    border-width: 1px;\n    line-height: 30px;\n\n    &:hover {\n      box-shadow: none;\n      color: var(--text-neutral-white-fixed, #fff);\n      border-color: var(--borders-brand-purple-strong, #6c468a);\n      background-color: var(--background-brand-purple-strong, #6c468a);\n    }\n\n    &:focus-visible {\n      @include focus-outline;\n    }\n\n    &:disabled,\n    &[disabled] {\n      background-color: var(--background-brand-purple-light, #e8cbff);\n      border: none;\n    }\n  }\n\n  &.neutralDark {\n    color: var(--text-neutral-primary, #292f36);\n    background-color: var(--background-neutral-primary, #fff);\n    border: 1px solid var(--borders-neutral-solid, #292f36);\n    border-radius: 4px;\n    line-height: 30px;\n\n    &:hover {\n      background-color: var(--background-neutral-secondary, #f0f2f5);\n    }\n\n    &:focus-visible {\n      @include focus-outline;\n    }\n\n    &:disabled {\n      color: var(--text-neutral-disabled, #d4dae1);\n      border-color: var(--borders-neutral-disabled, #d4dae1);\n      background-color: var(--background-neutral-primary, #fff);\n      cursor: not-allowed;\n    }\n  }\n\n  &.neutralDark,\n  &.brandSecondaryDefault {\n    &.default {\n      padding-left: 16px;\n      padding-right: 16px;\n\n      @include main-font-semi-bold;\n    }\n\n    &:active {\n      border-width: 2px;\n    }\n  }\n\n  // Button sizes.\n  &.default {\n    height: $button-height-default;\n    padding: 0 24px;\n    line-height: 34px;\n  }\n\n  &.large {\n    height: $button-height-large;\n    padding: 0 30px;\n    line-height: 40px;\n  }\n\n  &.narrow {\n    height: $button-height-narrow;\n    padding: 0 10px;\n    line-height: 40px;\n  }\n\n  &.small {\n    height: $button-height-small;\n    padding: 0 5px;\n    line-height: 20px;\n    position: relative;\n\n    .icon {\n      font-size: 12px;\n      top: 0;\n    }\n  }\n\n  // Must be below sizes, since we want it to have precedence for line-height.\n  &.updated {\n    line-height: 12px;\n  }\n\n  &.phase1Updated {\n    line-height: 32px;\n  }\n\n  &.textButton {\n    @include main-font-semi-bold;\n    color: var(--text-brand-teal-primary, #0093a4);\n    border-width: 0;\n    background-color: unset;\n    box-shadow: none;\n    padding: 0;\n    margin: 0;\n\n    &:hover {\n      background-color: unset;\n    }\n\n    &:disabled {\n      color: var(--text-neutral-disabled, #d4dae1);\n    }\n  }\n\n  &.rebrandedTextButton {\n    color: var(--text-brand-purple-primary, #9657c7);\n    font-size: 16px;\n    padding: 12px 16px;\n\n    &:hover {\n      color: var(--text-brand-purple-secondary, #6c468a);\n    }\n\n    &:focus-visible {\n      @include focus-outline;\n      outline-offset: unset;\n    }\n  }\n}\n","// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pr