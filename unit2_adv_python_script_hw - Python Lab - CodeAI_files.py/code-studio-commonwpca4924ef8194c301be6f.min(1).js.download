line-height:20px;color:var(--text-neutral-primary)}.cR_Qpo3VjXRvwuxxJuhz{display:flex;flex-direction:column}.OaCcY9Kmape__Ug8gW02{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;font-size:12}.hi_G6y8V5ZKVfle1DrFP{margin:"0px 2px"}.KpsFJG61MoCTMjX20gLc{margin:"0px 2px";font-size:16;position:"relative";top:1}.Ufx3kQtZPLYChp1i8Xya select{width:320px}.naoAEM8CTDqfoZ_7a_3i{font-size:14px;line-height:22px;color:var(--text-brand-purple-primary)}.ps0VvlkB3C8HlbyZDith{padding:var(--spacing-p-xxs) 0}',"",{version:3,sources:["webpack://./src/code-studio/components/progress/unit-overview.module.scss","webpack://./../frontend/packages/component-library-styles/font.scss"],names:[],mappings:"AAEA,4EAEE,6BAAA,CAGF,sBACE,UAAA,CAIF,sBACE,iCAAA,CAGF,sBACE,YAAA,CACA,6BAAA,CACA,oBAAA,CAGF,sBACE,oBAAA,CAGF,sBACE,YAAA,CACA,oBAAA,CAGF,sBCkCE,mCAAA,CACA,wCAAA,CACA,iBAAA,CDlCA,YAAA,CACA,iCAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,WAAA,CACA,iCAAA,CACA,eAAA,CAOA,qFAGE,sCAAA,CACA,yBAAA,CAGF,6DAEE,wCAAA,CAIJ,sBACE,YAAA,CACA,6BAAA,CACA,kBAAA,CACA,kBAAA,CACA,UAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,oBAAA,CACA,UAAA,CACA,cAAA,CACA,YAAA,CAGF,sBACE,iBAAA,CACA,6BACE,QAAA,CAIJ,sBACE,gBAAA,CAGF,sBACE,iBAAA,CAGF,sBACE,iBAAA,CACA,6BACE,eAAA,CAIJ,sBCtCE,mCAAA,CACA,wCAAA,CACA,iBAAA,CDsCA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,iCAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CAGF,sBCzEE,mCAAA,CACA,sCAAA,CACA,iBAAA,CDyEA,YAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,gBAAA,CACA,YAAA,CAGA,mBAAA,CACA,KAAA,CAIA,6BACE,WAAA,CAIJ,sBACE,cAAA,CACA,gBAAA,CACA,sCAAA,CAEF,sBACE,8BAAA",sourcesContent:["@import '@code-dot-org/component-library-styles/font';\n\n.main:has(:global(.announcement-notification)) .titleWrapper {\n  // Wider than the gap between two banners, so the header reads as a new block.\n  margin-top: var(--spacing-p-m);\n}\n\n.heading {\n  width: 100%;\n}\n\n// Matches the banner spacing the course overview and Announcements already use.\n.notificationBanner {\n  margin-bottom: var(--spacing-p-xs);\n}\n\n.titleWrapper {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n}\n\n.title {\n  display: inline-block;\n}\n\n.versionWrapper {\n  display: flex;\n  align-items: baseline;\n}\n\n.versionLabel {\n  @include main-font-semi-bold;\n  font-size: 15;\n  color: var(--text-neutral-primary);\n}\n\n.versionDropdown {\n  margin-bottom: 13;\n}\n\n.description {\n  width: 700px;\n  color: var(--text-neutral-primary);\n  font-weight: 400;\n\n  // SafeMarkdown renders link markdown to raw <a> elements. Without this rule\n  // they pick up the browser default (blue) which doesn't match the rest of\n  // the page. Route them through the same brand-purple semantic token used\n  // elsewhere on .main anchors.\n  // TODO: remove these styles once SafeMarkdown uses DSCO typography and components\n  a,\n  a:link,\n  a:visited {\n    color: var(--text-brand-purple-primary);\n    text-decoration: underline;\n  }\n\n  a:hover,\n  a:active {\n    color: var(--text-brand-purple-secondary);\n  }\n}\n\n.actionRow {\n  display: flex;\n  justify-content: space-between;\n  flex-direction: row;\n  margin-bottom: 10px;\n  width: 100%;\n}\n\n.leftActions {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-end;\n  width: 100%;\n  flex-wrap: wrap;\n  row-gap: 12px;\n}\n\n.assignButton {\n  margin-right: 10px;\n  button {\n    margin: 0;\n  }\n}\n\n.teacherResources {\n  margin-right: 5px;\n}\n\n.printingOptions {\n  margin-right: 10px;\n}\n\n.versionSelector {\n  margin-right: 10px;\n  select {\n    margin-bottom: 0;\n  }\n}\n\n.viewAsLabel {\n  @include main-font-semi-bold;\n  font-size: 16px;\n  margin-bottom: 0;\n  line-height: 20px;\n  color: var(--text-neutral-primary);\n}\n\n.viewAs {\n  display: flex;\n  flex-direction: column;\n}\n\n.unitConfirmText {\n  @include main-font-regular;\n  font-size: 12;\n}\n\n.customText {\n  margin: '0px 2px';\n}\n\n.icon {\n  margin: '0px 2px';\n  font-size: 16;\n  // we want our icon text to be a different size than our button text, which\n  // requires we manually offset to get it centered properly\n  position: 'relative';\n  top: 1;\n}\n\n.studentSelector {\n  select {\n    width: 320px;\n  }\n}\n\n.navLink {\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--text-brand-purple-primary);\n}\n.navArea {\n  padding: var(--spacing-p-xxs) 0;\n}\n","// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https:/