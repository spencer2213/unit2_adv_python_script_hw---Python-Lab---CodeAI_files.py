r:pointer}.RVNszN4oTGS5tK1fCQlU{transition:.1s ease-in-out;width:100px}.RVNszN4oTGS5tK1fCQlU:hover{transform:scale(1.05, 1.05);transition:.1s ease-in-out}.FijYsYoqhACf8UfR3q4x{padding:2px;width:10px;height:13px;border-radius:2px;transition:.1s ease-in-out;animation:.5s kEwD_10qN67iCpoj2c6g}.FijYsYoqhACf8UfR3q4x:hover{transform:scale(1.4, 1.4);transition:.1s ease-in-out}.noq1DGrj8UlAklmoTq1k{transform:scale(1.8, 1.8);transition:.01s ease-in-out}.zRXwyWt7rYgxLK9DekNM{background-color:#05343c}.d1EtkNs2GhsZP1W6Fz92{background-color:#074a55}.ESkXh4aZ41Q7X8wfJ3Ur{background-color:#fca401}.FqR4mTlyp_mNHHxHVtG9{opacity:0;pointer-events:none}.ZDMvwN_lvdljGYxCfa4X{background-color:#222}.y6QH95FWrZWlpHJCqQtd{background-color:#363636}.GNMQKJXDKbxpDYKJ5TwI{background-color:var(--background-brand-aqua-primary)}.Ui4yEdWWDo4JbmmbVii3{display:contents}.tPIRTKMNC_OAkzP7uvDg{position:absolute;font-size:14px;background-color:#fff;color:#000;padding:14px;border-radius:4px;max-width:300px;white-space:pre-line;animation:s52Kj4fAFyE3Sm8jr7Bp .5s;z-index:1}.VFkAcFQDRPs3KD2GFxym{left:370px;top:80px}.T2Je17ByHviqzWQF4V56{top:170px;right:214px}.NZhfSW3dNV69KlPHtXPp,.jfhu7c5EzQlKDANyIs2P{top:195px;right:216px}.lCvc5DkZI8xXZsniM9Up,.reehfheeiUu7qGGWGP2G{top:205px;right:216px}.LUY7Js4Fs3men_oxCM_5{left:370px;top:80px}.siRL6qu737xuo1F0y_5m{left:370px;top:80px}.MUWZzGBa7436PFELXnhE{position:absolute}.a6kaSqYEmySYR1fFhUSg{left:310px;top:90px}.fRWQ7xhw9G1CMFy1Dmd7{right:192px;top:177px}.ZchbagnftluULZ5B_boZ,.wCHdi7Y9fSBGtkgYEkEY{right:189px;top:210px}.nXzqsqTjaL1SJQanZ523,.dr4IXYS2P6ztqG_khNu0{right:189px;top:221px}.NPZvSlD4jnjxAATo4TTA{position:absolute;width:32px}.C84NxBVQvDtiSmWgE85F{transform:rotate(270deg);animation:xwKD79qvJe1D_Mkb0lso .75s infinite}.VLoFM4iNCqilSAabwaBA{transform:rotate(90deg);animation:xwKD79qvJe1D_Mkb0lso .75s infinite}.zh2TxcqPK5f_aOAR3tKi{position:absolute;left:525px;top:190px;font-size:45px;animation:xy3UYuiiVaC_uSmGNlMP 7s}.QkAsGnAU1K0bvUKifCvJ{color:#e5311a}","",{version:3,sources:["webpack://./src/music/views/patternAiPanel.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAGA,gCACE,QAEE,SAAA,CAEF,IACE,MAAA,CAAA,CAIJ,gCACE,GACE,SAAA,CAEF,KACE,SAAA,CAAA,CAIJ,gCACE,OAEE,SAAA,CAEF,KACE,SAAA,CAAA,CAIJ,gCACE,KACE,SAAA,CACA,eAAA,CAEF,GACE,SAAA,CACA,YAAA,CAAA,CAIJ,sBACE,gBAAA,CAGF,sBACE,cAAA,CACA,gBAAA,CACA,WAAA,CAGF,sBACE,YAAA,CACA,4BAAA,CACA,WAAA,CACA,wBC4Ha,CD1Hb,sBACE,mBAAA,CAIJ,sBACE,WAAA,CACA,YAAA,CACA,qBAAA,CACA,4BAAA,CACA,WAAA,CAEA,4CACE,UAAA,CACA,YAAA,CACA,kBAAA,CAGF,4CACE,YAAA,CAGF,4CACE,eAAA,CAGF,4CACE,wBCuDS,CDtDT,YAAA,CACA,qBAAA,CACA,iBAAA,CACA,wBAAA,CAIJ,sBACE,eAAA,CACA,WAAA,CAGF,sBACE,WAAA,CACA,gBAAA,CAEA,0BACE,QAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,WAAA,CAEA,4BACE,sCAAA,CACA,iBAAA,CAIJ,sBACE,oBAAA,CACA,WAAA,CACA,gBAAA,CACA,iBAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CAEA,4CACE,cAAA,CACA,gBAAA,CAIJ,sBACE,oBAAA,CACA,eAAA,CACA,qBAAA,CACA,cAAA,CACA,8BAAA,CACA,iBAAA,CAEA,4CACE,WAAA,CAEA,4CACE,qBC3EO,CD8ET,4CACE,qDAAA,CAGF,4CACE,gCAAA,CAIJ,sBACE,gBAAA,CAIJ,sBACE,WAAA,CACA,WAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,kBAAA,CACA,SAAA,CACA,0BAAA,CACA,sBAAA,CACA,WAAA,CAEA,sBACE,QAAA,CAGF,sBACE,SAAA,CAIJ,sBACE,gEAAA,CAEA,wEAEE,+DAAA,CAIF,4CACE,8BAAA,CACA,cAAA,CAGF,2BACE,gBAAA,CAIJ,sBACE,WAAA,CAEA,6BACE,6BAAA,CAIJ,sBACE,iBAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CAGF,sBACE,YAAA,CACA,WAAA,CACA,cAAA,CAGF,sBACE,0BAAA,CACA,WAAA,CAEA,4BACE,2BAAA,CACA,0BAAA,CAIJ,sBACE,WAAA,CACA,UAAA,CACA,WAAA,CAEA,iBAAA,CACA,0BAAA,CACA,kCAAA,CAEA,4BACE,yBAAA,CACA,0BAAA,CAGF,sBACE,yBAAA,CACA,2BAAA,CAIA,sBACE,wBAAA,CAGF,sBACE,wBAAA,CAGF,sBACE,wBAAA,CAKF,sBACE,SAAA,CACA,mBAAA,CAGF,sBACE,qBAAA,CAGF,sBACE,wBAAA,CAGF,sBACE,qDAAA,CAKN,sBACE,gBAAA,CAGF,sBACE,iBAAA,CACA,cAAA,CACA,qBAAA,CACA,UAAA,CACA,YAAA,CACA,iBAAA,CACA,eAAA,CACA,oBAAA,CACA,kCAAA,CACA,SAAA,CAEA,sBACE,UAAA,CACA,QAAA,CAGF,sBACE,SAAA,CACA,WAAA,CAGF,4CAEE,SAAA,CACA,WAAA,CAGF,4CAEE,SAAA,CACA,WAAA,CAGF,sBACE,UAAA,CACA,QAAA,CAGF,sBACE,UAAA,CACA,QAAA,CAIJ,sBACE,iBAAA,CAEA,sBACE,UAAA,CACA,QAAA,CAGF,sBACE,WAAA,CACA,SAAA,CAGF,4CAEE,WAAA,CACA,SAAA,CAGF,4CAEE,WAAA,CACA,SAAA,CAIJ,sBACE,iBAAA,CACA,UAAA,CAEA,sBACE,wBAAA,CACA,4CAAA,CAGF,sBACE,uBAAA,CACA,4CAAA,CAIJ,sBACE,iBAAA,CACA,UAAA,CACA,SAAA,CACA,cAAA,CACA,iCAAA,CAGF,sBACE,aCtOyB",sourcesContent:["@import 'color.scss';\n\n// Move the arrow left and right.\n@keyframes left-right {\n  0%,\n  100% {\n    left: 10px;\n  }\n  50% {\n    left: 0;\n  }\n}\n\n@keyframes fade-in {\n  0% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n@keyframes delay-fade-in {\n  0%,\n  80% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n@keyframes slidein {\n  from {\n    opacity: 0;\n    margin-top: 20px;\n  }\n  to {\n    opacity: 1;\n    margin-top: 0;\n  }\n}\n\n.focusContainer {\n  display: contents;\n}\n\n.patternPanel {\n  font-size: 13px;\n  user-select: none;\n  height: 100%;\n}\n\n.body {\n  display: flex;\n  justify-content: space-around;\n  height: 100%;\n  background-color: $neutral_dark;\n\n  &Generating {\n    pointer-events: none;\n  }\n}\n\n.leftArea {\n  width: 744px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-evenly;\n  height: 100%;\n\n  .topRow {\n    width: 100%;\n    display: flex;\n    align-items: center;\n  }\n\n  .editArea {\n    display: flex;\n  }\n\n  .drumArea {\n    margin-top: 11px;\n  }\n\n  .patternArea {\n    background-color: $dark_black;\n    padding: 10px;\n    box-sizing: border-box;\n    border-radius: 5px;\n    border: solid 1px $neutral_dark40;\n  }\n}\n\n.select {\n  margin-bottom: 0;\n  width: 110px;\n}\n\n.previewControls {\n  width: 110px;\n  margin-left: 17px;\n\n  div {\n    margin: 0;\n  }\n}\n\n.row {\n  display: flex;\n  align-items: center;\n  height: 23px;\n\n  &:hover {\n    background-color: rgba($white, 0.02);\n    border-radius: 4px;\n  }\n}\n\n.nameContainer {\n  display: inline-block;\n  width: 105px;\n  padding-left: 3px;\n  padding-right: 5px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n\n  .name {\n    cursor: pointer;\n    user-select: none;\n  }\n}\n\n.outerCell {\n  display: inline-block;\n  padding: 2px 1px;\n  box-sizing: border-box;\n  cursor: pointer;\n  transition: background-color 0s;\n  border-radius: 2px;\n\n  .innerCell {\n    padding: 1px;\n\n    &Playing {\n      background-color: $realyellow;\n    }\n\n    &Scanning {\n      background-color: var(--background-brand-aqua-primary);\n    }\n\n    &SlowFade {\n      transition: background-color 0.25s;\n    }\n  }\n\n  &Fourth {\n    margin-right: 5px;\n  }\n}\n\n.rightArea {\n  width: 120px;\n  height: 100%;\n}\n\n.botArea {\n  display: flex;\n  flex-direction: column;\n  gap: 15px;\n  align-items: center;\n  opacity: 0;\n  transition: 0.1s ease-in-out;\n  justify-content: center;\n  height: 100%;\n\n  &Gap {\n    gap: 30px;\n  }\n\n  &Visible {\n    opacity: 1;\n  }\n}\n\n.button {\n  background-color: var(--background-brand-aqua-primary) !important;\n\n  &:hover,\n  &[data-generating='true'] {\n    background-color: var(--background-brand-aqua-strong) !important;\n  }\n\n  // Stand-in for :disabled — see the button in PatternAiPanel.tsx.\n  &[data-generating='true'] {\n    border: 1px solid rgba(0 0 0 / 0);\n    cursor: default;\n  }\n\n  span {\n    user-select: none;\n  }\n}\n\n.temperatureInput {\n  width: 140px;\n\n  button {\n    padding-bottom: 1px !important;\n  }\n}\n\n.temperatureText {\n  text-align: center;\n}\n\n.temperatureRow {\n  display: flex;\n  align-items: center;\n}\n\n.temperatureButton {\n  display: flex;\n  padding: 4px;\n  cursor: pointer;\n}\n\n.aiBot {\n  transition: 0.1s ease-in-out;\n  width: 100px;\n\n  &:hover {\n    transform: scale(1.05, 1.05);\n    transition: 0.1s ease-in-out;\n  }\n}\n\n.cell {\n  padding: 2px;\n  width: 10px;\n  height: 13px;\n\n  border-radius: 2px;\n  transition: 0.1s ease-in-out;\n  animation: 0.5s fade-in;\n\n  &:hover {\n    transform: scale(1.4, 1.4);\n    transition: 0.1s ease-in-out;\n  }\n\n  &Playing {\n    transform: scale(1.8, 1.8);\n    transition: 0.01s ease-in-out;\n  }\n\n  &Seed {\n    &Default {\n      background-color: #05343c;\n    }\n\n    &Highlighted {\n      background-color: #074a55;\n    }\n\n    &Active {\n      background-color: #fca401;\n    }\n  }\n\n  &Generated {\n    &Invisible {\n      opacity: 0;\n      pointer-events: none;\n    }\n\n    &Default {\n      background-color: #222;\n    }\n\n    &Highlighted {\n      background-color: #363636;\n    }\n\n    &Active {\n      background-color: var(--background-brand-aqua-primary);\n    }\n  }\n}\n\n.helpContainer {\n  display: contents;\n}\n\n.help {\n  position: absolute;\n  font-size: 14px;\n  background-color: white;\n  color: black;\n  padding: 14px;\n  border-radius: 4px;\n  max-width: 300px;\n  white-space: pre-line;\n  animation: slidein 0.5s;\n  z-index: 1;\n\n  &DrawDrums {\n    left: 370px;\n    top: 80px;\n  }\n\n  &Temperature {\n    top: 170px;\n    right: 214px;\n  }\n\n  &GenerateNoTemperature,\n  &GenerateAgainNoTemperature {\n    top: 195px;\n    right: 216px;\n  }\n\n  &Generate,\n  &GenerateAgain {\n    top: 205px;\n    right: 216px;\n  }\n\n  &Generating {\n    left: 370px;\n    top: 80px;\n  }\n\n  &Error {\n    left: 370px;\n    top: 80px;\n  }\n}\n\n.arrowContainer {\n  position: absolute;\n\n  &DrawDrums {\n    left: 310px;\n    top: 90px;\n  }\n\n  &Temperature {\n    right: 192px;\n    top: 177px;\n  }\n\n  &GenerateNoTemperature,\n  &GenerateAgainNoTemperature {\n    right: 189px;\n    top: 210px;\n  }\n\n  &Generate,\n  &GenerateAgain {\n    right: 189px;\n    top: 221px;\n  }\n}\n\n.arrow {\n  position: absolute;\n  width: 32px;\n\n  &Left {\n    transform: rotate(270deg);\n    animation: left-right 0.75s infinite;\n  }\n\n  &Right {\n    transform: rotate(90deg);\n    animation: left-right 0.75s infinite;\n  }\n}\n\n.generatingSpinner {\n  position: absolute;\n  left: 525px;\n  top: 190px;\n  font-size: 45px;\n  animation: delay-fade-in 7s;\n}\n\n.errorMessage {\n  color: $product_negative_default;\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),i.locals={focusContainer:"SOxzyuazcfeGJrpiC4e3",patternPanel:"Sw3_HXxe4QuZMJh2EY48",body:"h7RXC9g2guiIh1dUvC2B",bodyGenerating:"ODTRlpH5qVjOTYDc6qJu",leftArea:"Ib4XM22qBgRI5sXYFXTu",topRow:"QkCI9cnToS4q7P51MxKd",editArea:"ZL7514aIQSGAyJIl3srO",drumArea:"ZDclstiHzlDtCtYIQAmd",patternArea:"AgEymY6QGxh3Brd90lHS",select:"n74CFtmhjGkg8cNL7IUB",previewControls:"PHhGwTrE_8jSZ2s3IDSa",row:"nMEVcMCCx6Sq3itd9C1C",nameContainer:"i5tssAQHu6yc0ZKcy_Z6",name:"MpjNSrZs5xFAAK5MODrp",outerCell:"wDPwAQ1rWciGAqeelYPi",innerCell:"tXWJTM41sAsUHJ9P0rJF",innerCellPlaying:"AWSzFX5bKNoMSHW0ULLM",innerCellScanning:"M4R4jByEbXfBTWduQpWK",innerCellSlowFade:"ZUsXvWewn7BVbTcPq1sk",outerCellFourth:"UQxgHgvnplg3iECpZ6w_",rightArea:"T4NOaSBduSBw1Vj4u9dL",botArea:"_roV3fLDvZ5FhEhUA3CD",botAreaGap:"RL7EFfJMUCFV6iSer7Sl",botAreaVisible:"wAc2O2sbLNaSwUQVKFso",button:"sygD5SmuurXJJ07pIIre",temperatureInput:"emJ1o8SyZdd_hi5MBfAd",temperatureText:"uyc2V7e0gM4XIcNYI77O",temperatureRow:"bDB5yJWhw55cbpHsMrMg",temperatureButton:"KwoKVw2xyDEjdOxGlx7F",aiBot:"RVNszN4oTGS5tK1fCQlU",cell:"FijYsYoqhACf8UfR3q4x","fade-in":"kEwD_10qN67iCpoj2c6g",cellPlaying:"noq1DGrj8UlAklmoTq1k",cellSeedDefault:"zRXwyWt7rYgxLK9DekNM",cellSeedHighlighted:"d1EtkNs2GhsZP1W6Fz92",cellSeedActive:"ESkXh4aZ41Q7X8wfJ3Ur",cellGeneratedInvisible:"FqR4mTlyp_mNHHxHVtG9",cellGeneratedDefault:"ZDMvwN_lvdljGYxCfa4X",cellGeneratedHighlighted:"y6QH95FWrZWlpHJCqQtd",cellGeneratedActive:"GNMQKJXDKbxpDYKJ5TwI",helpContainer:"Ui4yEdWWDo4JbmmbVii3",help:"tPIRTKMNC_OAkzP7uvDg",slidein:"s52Kj4fAFyE3Sm8jr7Bp",helpDrawDrums:"VFkAcFQDRPs3KD2GFxym",helpTemperature:"T2Je17ByHviqzWQF4V56",helpGenerateNoTemperature:"NZhfSW3dNV69KlPHtXPp",helpGenerateAgainNoTemperature:"jfhu7c5EzQlKDANyIs2P",helpGenerate:"lCvc5DkZI8xXZsniM9Up",helpGenerateAgain:"reehfheeiUu7qGGWGP2G",helpGenerating:"LUY7Js4Fs3men_oxCM_5",helpError:"siRL6qu737xuo1F0y_5m",arrowContainer:"MUWZzGBa7436PFELXnhE",arrowContainerDrawDrums:"a6kaSqYEmySYR1fFhUSg",arrowContainerTemperature:"fRWQ7xhw9G1CMFy1Dmd7",arrowContainerGenerateNoTemperature:"ZchbagnftluULZ5B_boZ",arrowContainerGenerateAgainNoTemperature:"wCHdi7Y9fSBGtkgYEkEY",arrowContainerGenerate:"nXzqsqTjaL1SJQanZ523",arrowContainerGenerateAgain:"dr4IXYS2P6ztqG_khNu0",arrow:"NPZvSlD4jnjxAATo4TTA",arrowLeft:"C84NxBVQvDtiSmWgE85F","left-right":"xwKD79qvJe1D_Mkb0lso",arrowRight:"VLoFM4iNCqilSAabwaBA",generatingSpinner:"zh2TxcqPK5f_aOAR3tKi","delay-fade-in":"xy3UYuiiVaC_uSmGNlMP",errorMessage:"QkAsGnAU1K0bvUKifCvJ"};const l=i},5035:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".IqAJbC0BUwOy6u6Lzxkw{display:flex;flex-direction:row;align-items:center;width:100%;margin:10px 0;justify-content:space-around}.IqAJbC0BUwOy6u6Lzxkw.Rd1rS1RIpSK1umOnD4JR{margin:0;gap:16px}.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn{color:#f2f2f2;margin:0;padding:0;border:none;border-radius:0;background-color:rgba(0,0,0,0)}.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:hover{box-shadow:none}.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:active{border:none !important}.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:hover>.o50FsnaHJuxr5kbgtxNP,.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:focus>.o50FsnaHJuxr5kbgtxNP{color:#59cad3}.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:hover>.oy44Jn_sOT4R_3LwmHsw,.IqAJbC0BUwOy6u6Lzxkw .FjAZPA4CjUCt4lE82uJn:focus>.oy44Jn_sOT4R_3LwmHsw{color:#abb0b6}.IqAJbC0BUwOy6u6Lzxkw .o50FsnaHJuxr5kbgtxNP{font-size:20px;cursor:pointer;transition:color .1s ease}.IqAJbC0BUwOy6u6Lzxkw .oy44Jn_sOT4R_3LwmHsw{color:#abb0b6;cursor:default}.IqAJbC0BUwOy6u6Lzxkw .unwKTXKSbCtug2fNsRkr{font-size:12px;padding:5px;width:100%}","",{version:3,sources:["webpack://./src/music/views/preview-controls.module.scss","webpack://./src/mixins.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAGA,sBACE,YAAA,CACA,kBAAA,CACA,kBAAA,CACA,UAAA,CACA,aAAA,CACA,4BAAA,CAEA,2CACE,QAAA,CACA,QAAA,CAGF,4CCRE,aCSc,CDEhB,QAAA,CACA,SAAA,CACA,WAAA,CACA,eAAA,CACA,8BAAA,CAEA,kDACE,eAAA,CAGF,mDACE,sBAAA,CDTE,gJACE,aEGK,CFDL,gJACE,aEsJO,CFhJf,4CACE,cAAA,CACA,cAAA,CACA,yBAAA,CAEA,4CACE,aE0IW,CFzIX,cAAA,CAIJ,4CACE,cAAA,CACA,WAAA,CACA,UAAA",sourcesContent:['@import "color.scss";\n@import "../../mixins.scss";\n\n.controlsRow {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  width: 100%;\n  margin: 10px 0;\n  justify-content: space-around;\n\n  &.v2 {\n    margin: 0;\n    gap: 16px;\n  }\n\n  .buttonContainer {\n    @include remove-button-styles($color: $background_gray);\n\n    &:hover,\n    &:focus {\n      > .previewButton {\n        color: $light_teal;\n\n        &Disabled {\n          color: $neutral_dark40;\n        }\n      }\n    }\n  }\n\n  .previewButton {\n    font-size: 20px;\n    cursor: pointer;\n    transition: color 0.1s ease;\n\n    &Disabled {\n      color: $neutral_dark40;\n      cursor: default;\n    }\n  }\n\n  .clearButton {\n    font-size: 12px;\n    padding: 5px;\n    width: 100%;\n  }\n}\n',"// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),i.locals={controlsRow:"IqAJbC0BUwOy6u6Lzxkw",v2:"Rd1rS1RIpSK1umOnD4JR",buttonContainer:"FjAZPA4CjUCt4lE82uJn",previewButton:"o50FsnaHJuxr5kbgtxNP",previewButtonDisabled:"oy44Jn_sOT4R_3LwmHsw",clearButton:"unwKTXKSbCtug2fNsRkr"};const l=i},5040:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".StZ3bmihsURgH8iernDW{user-select:none;width:600px;height:290px