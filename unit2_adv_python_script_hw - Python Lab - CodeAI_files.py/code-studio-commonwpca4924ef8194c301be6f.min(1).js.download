'@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","@import 'font.scss';\n@import '@code-dot-org/component-library-styles/mixins';\n\n.withBorderTop {\n  border-top: 1px solid var(--borders-neutral-primary);\n}\n\n.withBorderBottom {\n  border-bottom: 1px solid var(--borders-neutral-primary);\n}\n\n.sectionHeader {\n  margin-bottom: 16px;\n  display: flex;\n  align-items: center;\n}\n\n.whyCreateSectionLink {\n  margin-bottom: 1rem;\n}\n\np.noMarginBottomParagraph {\n  margin-bottom: 0;\n}\n\n.skeletonTextField {\n  width: 100%;\n  box-sizing: border-box;\n  height: 31px;\n  border-radius: 4px;\n  margin-bottom: 4px;\n}\n\n.typographyLabelTwo {\n  @include label-two;\n  display: block;\n}\n\n.sectionNameTextField {\n  width: 100%;\n  margin-bottom: 1rem;\n\n  input {\n    width: 100%;\n  }\n}\n\n.buttonsContainer {\n  display: flex;\n  justify-content: flex-end;\n\n  button {\n    font-size: 16px;\n  }\n}\n\n.splitButtonsContainer {\n  justify-content: flex-end;\n  padding: 5px;\n\n  button {\n    font-size: 16px;\n  }\n}\n\n.buttonLeft {\n  float: left;\n}\n\n.buttonRight {\n  float: right;\n}\n\n.buttonRow {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n}\n\n.buttonsInRow {\n  display: flex;\n  align-items: center;\n}\n\n.buttonsInRow .buttonStyle {\n  background-color: var(--background-neutral-primary);\n  padding: 10px;\n  color: var(--text-neutral-primary);\n  border: none;\n  font-size: 14px;\n  margin: 2px;\n\n  &:active {\n    // !important to overwrite button:active styles in app/assets/stylesheets/application.scss\n    border: none !important;\n  }\n\n  &:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    color: var(--text-brand-teal-primary);\n    outline-offset: 2px;\n    border-radius: 2px;\n  }\n}\n\n.buttonsInRow .buttonStyle.activeMarketingAudienceButton {\n  color: var(--text-brand-teal-primary);\n  border-bottom: 2px solid var(--borders-brand-teal-primary);\n  border-radius: 0;\n\n  &:focus-visible {\n    border-radius: 2px;\n  }\n}\n\n.buttonsInRow .buttonStyle:hover {\n  background-color: var(--background-neutral-primary);\n  color: var(--text-brand-teal-primary);\n}\n\n.flexDisplay {\n  display: flex;\n}\n\n.decideLaterCheckbox {\n  float: right;\n  margin: 10px 5px 0 5px;\n}\n\n.table {\n  background-color: var(--background-neutral-secondary);\n  margin: 4px;\n  flex: 1 1 0px;\n}\n\n.headerRow {\n  background-color: var(--background-brand-teal-primary);\n  color: var(--text-neutral-inverse);\n  height: 47px;\n}\n\n.headerCell {\n  padding: 12px;\n\n  h4 {\n    color: var(--text-neutral-inverse);\n    margin-bottom: 0;\n    margin-left: 10px;\n  }\n}\n\n.tableBody {\n  padding: 10px;\n  display: grid;\n}\n\n.courseTableRow {\n  &:not(:first-child) {\n    margin-top: 40px;\n  }\n}\n\n.courseHeaders {\n  position: relative;\n  left: 10px;\n}\n\n.courseOption {\n  margin-top: 20px;\n  align-items: center;\n}\n\n.unavailableLanguageTag {\n  display: block;\n  margin: 4px 0 8px 10px;\n}\n\n.unitDropdown {\n  @include main-font-semi-bold;\n  font-size: 16px;\n  margin: 4px 0 0 10px;\n  padding: 0.3em;\n}\n\n.unitDropdownLabel {\n  margin-bottom: 7px;\n}\n\nbutton.advancedSettingsButton {\n  margin: 5px;\n  font-size: unset;\n\n  i {\n    color: var(--text-neutral-primary);\n    margin-right: 10px;\n  }\n\n  h3 {\n    display: inline-block;\n    margin-top: 0.5em;\n  }\n\n  &:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: 2px;\n    border-radius: 2px;\n  }\n}\n\n.celebrationDialogBody {\n  flex-direction: column;\n  text-align: center;\n  padding: 36px;\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n}\n\n.celebrationDialogBody .celebrationGif {\n  margin: 14px;\n}\n\n.celebrationDialogFooter {\n  padding-bottom: 36px;\n  padding-left: 0;\n  padding-top: 0;\n  display: flex;\n  justify-content: center;\n}\n\n.toolTipContainer {\n  display: flex;\n  align-items: center;\n  margin-bottom: 8px;\n\n  button {\n    .toggle-display {\n      margin-left: 5px;\n    }\n  }\n}\n\n.taImage {\n  margin-left: 5px;\n  margin-top: -5px;\n}\n\n.loadingSpinner {\n  margin-bottom: 16px;\n}\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n","// Common site-wide fonts, put here for easy access from all scss files\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n// Please note (!): use only single quotes (' ') for strings (!) to allow our custom converter to work properly.\n// This file is being transpiled to js object.\n// (So it can be used in jsx/tsx files for inline styles. This is made mostly for legacy.\n// Try to avoid use of inline styles if you're creating new component).\n// Keeping that in mind -\n\n$geist-font: 'Geist';\n$space-grotesk-font: 'Space Grotesk';\n$noto-sans-fonts: 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Armenian', 'Noto Sans Bengali',\n'Noto Sans SC', 'Noto Sans TC', 'Noto Sans Devanagari', 'Noto Sans Georgian', 'Noto Sans Hebrew', 'Noto Sans JP',\n'Noto Sans Kannada', 'Noto Sans Khmer', 'Noto Sans KR', 'Noto Sans Myanmar', 'Noto Sans Sinhala',\n'Noto Sans Tamil', 'Noto Sans Telugu', 'Noto Sans Thai', 'Noto Sans Thaana', 'Noto Sans Math';\n\n$main-font: $geist-font, $noto-sans-fonts, sans-serif;\n$heading-font: $space-grotesk-font, $main-font;\n\n$thin-font-weight: 100;\n$extra-light-font-weight: 200;\n$light-font-weight: 300;\n$regular-font-weight: 400;\n$medium-font-weight: 500;\n$semi-bold-font-weight: 600;\n$bold-font-weight: 700;\n$extra-bold-font-weight: 800;\n$black-font-weight: 900;\n\n@mixin main-font-thin {\n  font-family: $main-font;\n  font-weight: $thin-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: $main-font;\n  font-weight: $extra-light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: $main-font;\n  font-weight: $light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: $main-font;\n  font-weight: $regular-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: $main-font;\n  font-weight: $medium-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: $main-font;\n  font-weight: $semi-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: $main-font;\n  font-weight: $bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: $main-font;\n  font-weight: $extra-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: $main-font;\n  font-weight: $black-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n$barlowSemiCondensed-semibold: 'Barlow Semi Condensed Semibold', $noto-sans-fonts, sans-serif;\n$barlowSemiCondensed-medium: 'Barlow Semi Condensed Medium', $noto-sans-fonts, sans-serif;\n\n$code-font: 'Source Code Pro', Monaco, 'Bitstream Vera Sans Mono', 'Lucida Console', Terminal, monospace;\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n"],sourceRoot:""}]),i.locals={"heading-xxl":"b3ZfTbkJZq28qrgRf0ZP",wrapper:"zIwpbdqRJUejoFly5NlU","heading-xl":"eKTJWZgJLGGuQmFLqPmp","heading-lg":"KlLxm529xgDg14ehh8b_","heading-md":"nU0BMGawWdVVCUgCcoER","heading-sm":"HGIV6ao0lSB9pKbfPG9y","heading-xs":"vu9xg6OlX7UUDoX37AaI","body-one":"Y6pz0y0rn25FWuQoTIEh","body-two":"WTVF7J1iEWkT08tJC_TO","body-three":"uEsZ7k1MvQfDP3cdipze","body-four":"uOaoGCw85cXoaqon8aEM","overline-one":"ApqAQsjQGbZJ7JzlJG9P","overline-two":"KzIrWMD381ca7YzHQVwg","overline-three":"rnFwuPnkqHwkevDcN4VM",strong:"UguGaxcysuehdDtG_U1Q",em:"jo6paQu3ED9Q650aiEB_",figcaption:"TVZtoAhhIQUf8SYJ4tfB","no-margin":"zK7bYHptr68weAmvWjOA",withBorderTop:"kB6SaTjtr_HUQZuudhZu",withBorderBottom:"pUJixPppoP50_V8JwfHD",sectionHeader:"sf4ScEWOh8l4CmTAMFi9",whyCreateSectionLink:"FCohXvuWrmubw0GTSxAl",noMarginBottomParagraph:"PfLFAbr7lD1SKIDtdiVj",skeletonTextField:"vOo891zlQ6fOOyTAm2ts",typographyLabelTwo:"NAcnQQ5KOEKT40Q9Nts8",sectionNameTextField:"ze8d8SGYV8e1l3VYbEXA",buttonsContainer:"eoTAnz9IRWiDTH3MBcnQ",splitBu