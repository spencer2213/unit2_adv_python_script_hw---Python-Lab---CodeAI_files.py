purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-disabled-orange: var(--brand-orange-5);\n  --border-disabled-pink: var(--brand-pink-5);\n  --border-disabled-success: var(--sentiment-success-5);\n  --border-disabled-warning: var(--sentiment-warning-5);\n  --border-focused-inverse: var(--sentiment-success-5);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-10);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-10);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-brand-primary-fixed: var(--brand-purple-50);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-warning-primary: var(--sentiment-warning-50);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-warning-primary-fixed: var(--sentiment-warning-50);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-success-primary-fixed: var(--sentiment-success-70);\n  --text-info-primary: var(--sentiment-information-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-info-primary-fixed: var(--sentiment-information-70);\n\n  /* Selected state text pairs with background and border-state-selected — always use the two together. */\n  --text-selected-primary: var(--sentiment-success-5);\n  --text-selected-primary-inverse: var(--brand-purple-95);\n  --text-disabled-brand: var(--brand-purple-5);\n  --text-disabled-error: var(--sentiment-error-5);\n  --text-disabled-info: var(--sentiment-information-5);\n  --text-disabled-neutral: var(--neutral-gray-20);\n\n  /* Single inverse for the whole disabled family: label color for solid-fill disabled elements of any color; pair with the matching background/disabled/<color>. Outline disabled elements use text/disabled/<color> instead. */\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-disabled-orange: var(--brand-orange-5);\n  --text-disabled-pink: var(--brand-pink-5);\n  --text-disabled-success: var(--sentiment-success-5);\n  --text-disabled-warning: var(--sentiment-warning-5);\n\n  /* Orange text intentionally keeps the true brand-guideline level-50 value instead of bumping for contrast */\n  --text-accent-orange-primary: var(--brand-orange-50);\n  --text-accent-orange-secondary: var(--brand-orange-70);\n  --text-accent-orange-primary-fixed: var(--brand-orange-50);\n  --text-accent-pink-primary: var(--brand-pink-50);\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-accent-pink-primary-fixed: var(--brand-pink-50);\n}\n\n/* Dark Theme Semantic Colors */\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Dark'] {\n  --background-neutral-primary: var(--neutral-base-black);\n  --background-neutral-secondary: var(--neutral-gray-95);\n  --background-neutral-tertiary: var(--neutral-gray-90);\n  --background-neutral-quaternary: var(--neutral-gray-80);\n  --background-neutral-quinary: var(--neutral-gray-70);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-30);\n  --background-neutral-octonary: var(--neutral-gray-20);\n  --background-neutral-primary-inverse: var(--neutral-base-white);\n  --background-neutral-true-base: var(--neutral-base-true-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-95);\n  --background-brand-mid: var(--brand-purple-80);\n\n  /* Strong variables are mostly used for hover states, in dark mode they invert and become lighter. They fail 4.5:1 contrast with labels, but we only need the default state to pass. */\n  --background-brand-strong: var(--brand-purple-40);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-95);\n  --background-error-mid: var(--sentiment-error-80);\n  --background-error-strong: var(--sentiment-error-40);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-95);\n  --background-warning-mid: var(--sentiment-warning-80);\n  --background-warning-strong: var(--sentiment-warning-40);\n\n  /* Level 70 is preserved for success even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-95);\n  --background-success-mid: var(--sentiment-success-80);\n\n  /* Bc success is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-success-strong: var(--sentiment-success-60);\n\n  /* Level 70 is preserved for info even in dark mode to continue to pass 4.5:1 contrast with white labels, we intentionally don't invert to avoid black labels. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-95);\n  --background-info-mid: var(--sentiment-information-80);\n\n  /* Bc info is at level 70, we maintain the relative hover rule by setting the strong to 60. */\n  --background-info-strong: var(--sentiment-information-60);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--sentiment-success-5);\n  --background-selected-strong: var(--sentiment-success-20);\n  --background-selected-primary-inverse: var(--brand-purple-80);\n  --background-disabled-brand: var(--neutral-gray-80);\n  --background-disabled-error: var(--neutral-gray-80);\n  --background-disabled-info: var(--neutral-gray-80);\n  --background-disabled-neutral: var(--neutral-gray-80);\n  --background-disabled-orange: var(--neutral-gray-80);\n  --background-disabled-pink: var(--neutral-gray-80);\n  --background-disabled-success: var(--neutral-gray-80);\n  --background-disabled-warning: var(--neutral-gray-80);\n  --background-accent-orange-primary: