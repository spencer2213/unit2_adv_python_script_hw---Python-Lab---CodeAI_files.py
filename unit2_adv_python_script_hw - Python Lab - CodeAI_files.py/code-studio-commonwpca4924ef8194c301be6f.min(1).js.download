alic;\n  display: block;\n  margin-top: 10px;\n}\n\n.hiddenError {\n  color: var(--text-error-primary);\n  font-style: italic;\n  margin-bottom: 10px;\n}\n\n.stepButton {\n  white-space: nowrap;\n  width: 100%;\n}\n\n.instructionsTable {\n  td {\n    padding-block: 0.375rem;\n    vertical-align: middle;\n  }\n\n  td:last-child {\n    padding-inline-start: 1rem;\n  }\n}\n"],sourceRoot:""}]),i.locals={modal:"oCCEqYgXniY5Kxtcs3TQ",main:"KimAqLqjW4q6DLbRFfIz",sectionSelectorRow:"Q6yHzSYPvpNP1m9oBN64",headerRow:"bYgu1sIXJg9T7OOrUM7N",descriptionText:"s2mQlu5D3F73wMT01T2O",studentTable:"SgRBpGl8pfTbFbZZ_lyO",hidden:"PFk7stEXdwZPGUOi_fvS",saveError:"nY5EEVr5u0CYdF6l2aWW",hiddenError:"jCz3iWgCIIPTyzdPevvk",stepButton:"Nm3ycr5in9HgtRAEE09C",instructionsTable:"eExuXM8en_F9UgvXRUqo"};const l=i},2834:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".uBks4m5iTFzZ6zwwtuFF{border:1px solid var(--borders-neutral-primary);padding:10px}.ovPv0FVqTGDh_Z_HRTZz{text-align:center}.Cwjba1O1ZL9U1zgQyyBI{background-color:var(--background-brand-teal-extra-light)}.QHTL4pMXzQ7C44p0GB2q{justify-content:center}","",{version:3,sources:["webpack://./src/code-studio/components/progress/lessonLockDialog/student-row.module.scss"],names:[],mappings:"AAAA,sBACE,+CAAA,CACA,YAAA,CAGF,sBACE,iBAAA,CAGF,sBACE,yDAAA,CAIF,sBACE,sBAAA",sourcesContent:[".tableCell {\n  border: 1px solid var(--borders-neutral-primary);\n  padding: 10px;\n}\n\n.radioCell {\n  text-align: center;\n}\n\n.selectedCell {\n  background-color: var(--background-brand-teal-extra-light);\n}\n\n// RadioButton renders a flex-row label; center the icon within the cell.\n.radio {\n  justify-content: center;\n}\n"],sourceRoot:""}]),i.locals={tableCell:"uBks4m5iTFzZ6zwwtuFF",radioCell:"ovPv0FVqTGDh_Z_HRTZz",selectedCell:"Cwjba1O1ZL9U1zgQyyBI",radio:"QHTL4pMXzQ7C44p0GB2q"};const l=i},7785:(e,t,n)=>{"use strict";n.d(t,{A:()=>l});var r=n(12),o=n.n(r),a=n(13),i=n.n(a)()(o());i.push([e.id,".ZsYCPZyr3k