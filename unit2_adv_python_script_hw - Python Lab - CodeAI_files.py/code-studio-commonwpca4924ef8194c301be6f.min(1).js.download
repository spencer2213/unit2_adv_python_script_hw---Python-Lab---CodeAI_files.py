s:["webpack://./../shared/css/2022-rebrand-update.scss","webpack://./../shared/css/font.scss","webpack://./../shared/css/color.scss","webpack://./src/templates/curriculumCatalog/curriculum_catalog_card.module.scss"],names:[],mappings:"AAOA,KACE,cAAA,CAGF,KACE,cAAA,CAGF,SACE,yYCEU,CDDV,eCSsB,CDRtB,iBAAA,CAGF,GACE,aAAA,CACA,eAAA,CACA,aE6Ja,CF1Jf,GACE,aEyJa,CFxJb,iBAAA,CACA,eAAA,CAGF,GACE,yYChBU,CDiBV,eCVmB,CDWnB,eAAA,CACA,eAAA,CACA,iBAAA,CAGF,GACE,aE2Ia,CF1Ib,aAAA,CACA,eAAA,CC2CA,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDzCF,kBACE,YAAA,CAGF,EACE,+BAAA,CACA,yBAAA,CAEA,QACE,iCAAA,CACA,yBAAA,CAKF,wBACE,oBAAA,CAKF,wBACE,oBAAA,CAIJ,6CACE,wBE+Fc,CF5FhB,EACE,aEsGa,CFnGf,sBACE,eAAA,CAIA,wBACE,cAAA,CAEF,wBCHA,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDGE,aAAA,CAIA,kDACE,wBEyEU,CFrEV,wEACE,aE+EO,CD9Fb,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDeM,aAAA,CAIJ,kECrBF,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDqBI,iBAAA,CACA,WAAA,CACA,cAAA,CACA,wBEqCoB,CFpCpB,wBAAA,CACA,UEsDU,CFpDV,wEACE,wBEiCe,CFhCf,oBEgCe,CF/Bf,eAAA,CAGF,wEACE,oBEsBgB,CFnBlB,2EACE,UEyCQ,CFxCR,oBE4CS,CF3CT,wBE2CS,CF1CT,kBAAA,CAQJ,gDACE,mCAAA,CAEA,sDACE,+BAAA,CAIJ,gDACE,wBAAA,CAEA,wDACE,oBAAA,CAQJ,+BACE,qBAAA,CACA,mCAAA,CAEA,iCACE,qBAAA,CAIJ,+BACE,aEYS,CFXT,wBAAA,CAEA,iCACE,aEQO,CFDb,4CACE,wBAAA,CAEA,+CACE,UEfU,CFmBd,4CACE,mCAAA,CAEA,iEACE,aEXS,CFeb,4CACE,wBEnBa,CFsBf,4CACE,qBEhCY,CFkCZ,kEACE,aEvBS,CFyBT,wFACE,cAAA,CAEA,qLACE,cAAA,CAIJ,4JACE,aElCO,CFoCP,gKCvHN,yYAhFU,CAiFV,eAxEiB,CAyEjB,iBAAA,CDuHQ,yBAAA,CACA,aEtEgB,CFuEhB,4KACE,aEvEW,CF4EjB,wFC5IJ,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CD4IM,wBAAA,CACA,iBAAA,CACA,WAAA,CACA,cAAA,CACA,wBEnFkB,CFoFlB,wBAAA,CACA,UElEQ,CFmER,iBAAA,CAEA,8FACE,wBExFa,CFyFb,oBEzFa,CF0Fb,eAAA,CAGF,8FACE,oBEnGc,CFsGhB,iGACE,UEhFM,CFiFN,oBE7EO,CF8EP,wBE9EO,CF+EP,kBAAA,CAIJ,wFCzKJ,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDyKM,wBAAA,CACA,aE9EO,CF+EP,qBE3FQ,CF4FR,wBAAA,CACA,iBAAA,CACA,iBAAA,CAEA,8FACE,wBE9FO,CF+FP,eAAA,CAGF,8FACE,oBE7Hc,CFgIhB,iGACE,aEtGO,CFuGP,oBEvGO,CFwGP,qBE5GM,CF6GN,kBAAA,CAMR,4CACE,wBE3IoB,CF4IpB,UErHY,CFuHZ,kECzMF,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDyMI,yBAAA,CACA,wBEjJkB,CFkJlB,qBAAA,CACA,iBAAA,CACA,UE7HU,CF8HV,eAAA,CACA,gBAAA,CAEA,wEACE,wBExJa,CFyJb,eAAA,CAGF,wEACE,wBAAA,CAGF,2EACE,UE3IQ,CF4IR,oBExIS,CFyIT,wBEzIS,CF0IT,kBAAA,CAMR,sBACE,aEzIa,CF0Ib,cAAA,CAEA,yBACE,aE7IW,CFiJX,8CACE,UEpTE,CFwTN,wBACE,aEtLsB,CFyLxB,4CACE,wBEtKY,CFuKZ,wBAAA,CAEA,oEACE,aE9LoB,CFkMxB,4CACE,wBAAA,CAGE,kDACE,sBAAA,CAIJ,kEACE,6BAAA,CACA,wBEzLU,CF0LV,aE/KS,CFiLT,qEACE,aElLO,CFuLb,4CCrRA,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CDqRE,wBAAA,CACA,iBAAA,CACA,WAAA,CACA,cAAA,CACA,wBE5NsB,CF6NtB,wBAAA,CACA,UE3MY,CF6MZ,kDACE,wBEhOiB,CFiOjB,oBEjOiB,CFoOnB,kDACE,oBE1OkB,CF6OpB,qDACE,UEvNU,CFwNV,oBEpNW,CFqNX,wBErNW,CFsNX,kBAAA,CAKF,oEACE,aEnPoB,CF4PlB,8FACE,yBAAA,CAQR,4BACE,+BAAA,CAKF,iEACE,UEzPY,CF6PhB,4CAEE,wBAAA,CAKE,4BACE,wBEpQU,CCnKhB,sBACE,YAAA,CACA,gBAAA,CACA,kDAAA,CACA,iBAPc,CAQd,WAPgB,CAShB,0BACE,YAAA,CACA,gBAAA,CACA,yBAAA,CAGF,4CACE,iBAAA,CAIJ,sBACE,WAAA,CAGF,sBACE,WAAA,CAGF,sBACE,YAAA,CACA,gBAAA,CACA,WAAA,CACA,+CAAA,CACA,YAAA,CACA,yBAAA,CACA,kBAAA,CAEA,wBACE,mCAAA,CAGF,yBACE,mBAAA,CACA,iCAAA,CAIA,mBAAA,CACA,eAAA,CACA,oBAAA,CACA,2BAAA,CAIJ,sBACE,YAAA,CACA,gBAAA,CACA,6BAAA,CACA,kBAAA,CACA,YAAA,CAEA,wBACE,eAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,eAAA,CAEA,wBACE,gBAAA,CACA,QAAA,CACA,iCAAA,CAGF,wBACE,gBAAA,CAIJ,sBACE,YAAA,CACA,cAAA,CACA,eAAA,CAEA,kHAIE,QAAA,CACA,WAAA,CACA,aAAA,CACA,gBAAA,CAIJ,sBACE,6BAAA,CACA,WAAA,CAEA,kHAIE,UAAA,CACA,YAAA,CACA,sBAAA,CAIJ,sBACE,6BAAA,CACA,eAAA,CAEA,kHAME,aAAA,CAIJ,sBACE,YAAA,CAGF,4DACE,0BAAA,CAGF,4DACE,sBAAA,CAIA,4DACE,wBAAA,CAGF,mEACE,8CAAA,CAKF,4CACE,oDAAA,CAIJ,4BACE,MAAA,CAGF,2FAEE,YAAA,CACA,iBAAA,CACA,aAAA,CACA,gBAAA,CAGF,sBACE,iBAAA,CAGF,qCACE,sBACE,uBAAA,CAGF,sBACE,uBAAA,CAGF,6CACE,wBAAA,CAGF,4BACE,uBAAA,CAIA,4CACE,sDAAA,CAIJ,8CACE,aAAA,CAAA,CAIJ,qCACE,sBACE,YAAA,CAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,WAAA,CACA,sBAAA,CACA,QAAA,CACA,UAAA,CACA,UAAA,CACA,iBAAA,CACA,6CAAA,CACA,4CAAA,CAEA,0BACE,gBAAA,CACA,WAAA,CACA,SAAA,CACA,gBAAA,CACA,yBAAA,CAGF,4CACE,YAAA,CACA,2BAAA,CACA,qBAAA,CACA,QAAA,CACA,UAAA,CACA,gBAAA,CACA,6BAAA,CACA,WAAA,CAEA,+CACE,eAAA,CAKN,sBACE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,kBAAA,CAGF,4CACE,sBAAA,CACA,kBAAA,CACA,QAAA,CACA,kBAAA,CAGF,uBACE,kBAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,sBAAA,CACA,OAAA,CACA,kBAAA",sourcesContent:["@import 'color';\n@import 'font';\n\n// This file is used only for 2022 Rebrand style updates (was implemented in late 2022/early 2023) across the pages of dashboard and pegasus/code.org\n// It should be imported to the pages that are listed in 2022 Rebrand updates.\n// Therefore never mind if you meet !important anywhere in this file. It will be used only if there is no other option than to overwrite styles\n// in a way that updating styles of shared elements would only affect 2022 Rebrand update pages.\nhtml {\n  font-size: 100%;\n}\n\nbody {\n  font-size: 100%;\n}\n\nh1, h2, h3 {\n  font-family: $main-font;\n  font-weight: $semi-bold-font-weight;\n  margin-bottom: 1em;\n}\n\nh1 {\n  font-size: 3em;\n  line-height: 1.2;\n  color: $neutral-dark;\n}\n\nh2 {\n  color: $neutral-dark;\n  font-size: 2.125em;\n  line-height: 1.2;\n}\n\nh4 {\n  font-family: $main-font;\n  font-weight: $medium-font-weight;\n  font-size: 1.5em;\n  line-height: 1.2;\n  margin-bottom: 1em;\n}\n\nh6 {\n  color: $neutral_dark;\n  font-size: 1em;\n  line-height: 1.2;\n  @include main-font-semi-bold;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  margin-top: 0;\n}\n\na {\n  color: var(--text-brand-primary);\n  text-decoration: underline;\n\n  &:hover {\n    color: var(--text-brand-secondary);\n    text-decoration: underline;\n  }\n}\n\n.professional-learning-banner {\n  a {\n    text-decoration: none;\n  }\n}\n\n.header_right {\n  a {\n    text-decoration: none;\n  }\n}\n\n.tutorial-block, .courseblock-tall {\n  background-color: $neutral_light;\n}\n\np {\n  color: $neutral_dark;\n}\n\n#signin {\n  flex-grow: unset;\n}\n\n#signup {\n  p {\n    font-size: 14px;\n  }\n  a {\n    @include main-font-semi-bold;\n    font-size:  1em;\n  }\n\n  .signup {\n    input {\n      background-color: $neutral_light;\n    }\n\n    .signup-field-label {\n      label {\n        color: $neutral_dark;\n        @include main-font-semi-bold;\n        font-size: 1em;\n      }\n    }\n\n    .submit {\n      @include main-font-semi-bold;\n      padding: 10px 20px;\n      height: auto;\n      margin-right: 0;\n      background-color: $brand_secondary_default;\n      border: 2px solid $brand_secondary_default;\n      color: $neutral_white;\n\n      &:hover {\n        background-color: $brand_secondary_dark;\n        border-color: $brand_secondary_dark;\n        box-shadow: none;\n      }\n\n      &:focus {\n        border-color: $brand_primary_default;\n      }\n\n      &:disabled {\n        color: $neutral_white;\n        border-color: $neutral_dark20;\n        background-color: $neutral_dark20;\n        cursor: not-allowed;\n      }\n    }\n  }\n}\n\n#homepage-container {\n  .project_card {\n    > div {\n      background-color: $neutral_light !important;\n\n      &:hover {\n        border-color: $neutral_dark70 !important;\n      }\n    }\n\n    div {\n      color: $neutral_dark !important;\n\n      a:hover {\n        text-decoration: none;\n      }\n    }\n  }\n}\n\n#classroom-sections {\n  table {\n    th {\n      color: $neutral_white !important;\n      background-color: $neutral_dark !important;\n\n      i {\n        color: $neutral_white !important;\n      }\n    }\n\n    td {\n      color: $neutral_dark;\n      background-color: $neutral_light;\n\n      i {\n        color: $neutral_dark;\n      }\n    }\n  }\n}\n\n.courseexplorer {\n  .grouprow {\n    background-color: $neutral_dark;\n\n    h6 {\n      color: $neutral_white;\n    }\n  }\n\n  .graderow {\n    background-color: $neutral_dark10 !important;\n\n    &.numbered {\n      color: $neutral_dark;\n    }\n  }\n\n  .courserow {\n    background-color: $neutral_dark70;\n  }\n\n  .arrow_box {\n    background-color: $neutral_white;\n\n    .arrow_box_content {\n      color: $neutral_dark;\n\n      .description {\n        font-size: 14px;\n\n        li, a {\n          font-size: 14px;\n        }\n      }\n\n      .description, a {\n        color: $neutral_dark;\n\n        a {\n          @include main-font-bold;\n          text-decoration: underline;\n          color: $brand_secondary_default;\n          &:hover {\n            color: $brand_secondary_dark;\n          }\n        }\n      }\n\n      .launch {\n        @include main-font-semi-bold;\n        font-size: 1em !important;\n        padding: 10px 20px;\n        height: auto;\n        margin-right: 0;\n        background-color: $brand_secondary_default;\n        border: 2px solid $brand_secondary_default;\n        color: $neutral_white;\n        line-height: unset;\n\n        &:hover {\n          background-color: $brand_secondary_dark;\n          border-color: $brand_secondary_dark;\n          box-shadow: none;\n        }\n\n        &:focus {\n          border-color: $brand_primary_default;\n        }\n\n        &:disabled {\n          color: $neutral_white;\n          border-color: $neutral_dark20;\n          background-color: $neutral_dark20;\n          cursor: not-allowed;\n        }\n      }\n\n      .course-explorer-gray-button {\n        @include main-font-semi-bold;\n        font-size: 1em !important;\n        color: $neutral_dark;\n        background-color: $neutral_white;\n        border: 2px solid $neutral_dark;\n        border-radius: 4px;\n        line-height: unset;\n\n        &:hover {\n          background-color: $neutral_dark10;\n          box-shadow: none;\n        }\n\n        &:focus {\n          border-color: $brand_primary_default;\n        }\n\n        &:disabled {\n          color: $neutral_dark20;\n          border-color: $neutral_dark20;\n          background-color: $neutral_white;\n          cursor: not-allowed;\n        }\n      }\n    }\n  }\n\n  .professional-learning {\n    background-color: $brand_primary_default;\n    color: $neutral_white;\n\n    .course-explorer-gray-button {\n      @include main-font-semi-bold;\n      font-size: .8em !important;\n      background-color: $brand_primary_default;\n      border: 2px solid $neutral_white;\n      border-radius: 4px;\n      color: $neutral_white;\n      box-shadow: none;\n      line-height: 30px;\n\n      &:hover {\n        background-color: $brand_primary_dark;\n        box-shadow: none;\n      }\n\n      &:focus {\n        border: 2px solid $brand_primary_default;\n      }\n\n      &:disabled {\n        color: $neutral_white;\n        border-color: $neutral_dark20;\n        background-color: $neutral_dark20;\n        cursor: not-allowed;\n      }\n    }\n  }\n}\n\n.hoc-overview-page {\n  color: $neutral_dark;\n  font-size: 14px;\n\n  h3 {\n    color: $neutral_dark;\n  }\n\n  .hoc-skinny-banner {\n    p {\n      color: $white;\n    }\n  }\n\n  > a {\n    color: $brand_secondary_default;\n  }\n\n  .tutorial-info {\n    background-color: $neutral_light;\n    border: 1px solid $neutral_dark20;\n\n    .tutorial-info-guide a {\n      color: $brand_secondary_default;\n    }\n  }\n\n  .full-resource-block {\n    border: 1px solid $neutral_dark20;\n\n    > a {\n      > img {\n        border: none !important;\n      }\n    }\n\n    .activities-info {\n      border-left: 1px solid $neutral_dark20;\n      background-color: $neutral_light;\n      color: $neutral_dark;\n\n      h2 {\n        color: $neutral_dark;\n      }\n    }\n  }\n\n  .tutorial-gray {\n    @include main-font-semi-bold;\n    font-size: 1em !important;\n    padding: 10px 16px;\n    height: auto;\n    margin-right: 0;\n    background-color: $brand_secondary_default;\n    border: 2px solid $brand_secondary_default;\n    color: $neutral_white;\n\n    &:hover {\n      background-color: $brand_secondary_dark;\n      border-color: $brand_secondary_dark;\n    }\n\n    &:focus {\n      border-color: $brand_primary_default;\n    }\n\n    &:disabled {\n      color: $neutral_white;\n      border-color: $neutral_dark20;\n      background-color: $neutral_dark20;\n      cursor: not-allowed;\n    }\n  }\n\n  .course-container {\n    .teacher-guide a {\n      color: $brand_secondary_default;\n    }\n  }\n}\n\n#projects-page {\n  .container {\n    #uitest-public-projects {\n      .viewMoreLink {\n        &:hover {\n          text-decoration: underline;\n        }\n      }\n    }\n  }\n}\n\n.newProject-button-tile {\n  &:hover {\n    border-color: $neutral_dark70 !important;\n  }\n}\n\n.tutorial-promo-container.dance-party-container {\n  .tutorial-description {\n    color: $neutral_white;\n  }\n}\n\n.full-resource-block .resource-title {\n  // Overwrite global full-resource-block styling for phase1 styles\n  color: $neutral_dark !important;\n}\n\n.featured-project {\n  > a {\n    > div {\n      background-color: $neutral_light;\n    }\n  }\n}\n","// Common site-wide fonts, put here for easy access from all scss files\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n// Please note (!): use only single quotes (' ') for strings (!) to allow our custom converter to work properly.\n// This file is being transpiled to js object.\n// (So it can be used in jsx/tsx files for inline styles. This is made mostly for legacy.\n// Try to avoid use of inline styles if you're creating new component).\n// Keeping that in mind -\n\n$geist-font: 'Geist';\n$space-grotesk-font: 'Space Grotesk';\n$noto-sans-fonts: 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Armenian', 'Noto Sans Bengali',\n'Noto Sans SC', 'Noto Sans TC', 'Noto Sans Devanagari', 'Noto Sans Georgian', 'Noto Sans Hebrew', 'Noto Sans JP',\n'Noto Sans Kannada', 'Noto Sans Khmer', 'Noto Sans KR', 'Noto Sans Myanmar', 'Noto Sans Sinhala',\n'Noto Sans Tamil', 'Noto Sans Telugu', 'Noto Sans Thai', 'Noto Sans Thaana', 'Noto Sans Math';\n\n$main-font: $geist-font, $noto-sans-fonts, sans-serif;\n$heading-font: $space-grotesk-font, $main-font;\n\n$thin-font-weight: 100;\n$extra-light-font-weight: 200;\n$light-font-weight: 300;\n$regular-font-weight: 400;\n$medium-font-weight: 500;\n$semi-bold-font-weight: 600;\n$bold-font-weight: 700;\n$extra-bold-font-weight: 800;\n$black-font-weight: 900;\n\n@mixin main-font-thin {\n  font-family: $main-font;\n  font-weight: $thin-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: $main-font;\n  font-weight: $extra-light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: $main-font;\n  font-weight: $light-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: $main-font;\n  font-weight: $regular-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: $main-font;\n  font-weight: $medium-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: $main-font;\n  font-weight: $semi-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: $main-font;\n  font-weight: $bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: $main-font;\n  font-weight: $extra-bold-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: $main-font;\n  font-weight: $black-font-weight;\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n$barlowSemiCondensed-semibold: 'Barlow Semi Condensed Semibold', $noto-sans-fonts, sans-serif;\n$barlowSemiCondensed-medium: 'Barlow Semi Condensed Medium', $noto-sans-fonts, sans-serif;\n\n$code-font: 'Source Code Pro', Monaco, 'Bitstream Vera Sans Mono', 'Lucida Console', Terminal, monospace;\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","@use 'sass:math';\n@import '2022-rebrand-update';\n@import 'breakpoints';\n\n$border-radius: 4px;\n$container-width: 309px;\n\n.curriculumCatalogCardContainer {\n  display: flex;\n  flex-flow: column;\n  background-color: var(--background-neutral-primary);\n  border-radius: $border-radius;\n  width: $container-width;\n\n  img {\n    height: 140px;\n    object-fit: cover;\n    border-radius: $border-radius $border-radius 0 0;\n  }\n\n  .iconWithDescription {\n    margin: 0 0 0.5em 0;\n  }\n}\n\n.curriculumCatalogCardContainer_english {\n  height: 25em;\n}\n\n.curriculumCatalogCardContainer_notEnglish {\n  height: 28em;\n}\n\n.curriculumInfoContainer {\n  display: flex;\n  flex-flow: column;\n  height: 100%;\n  border: 1px solid var(--borders-neutral-primary);\n  border-top: 0;\n  border-radius: 0 0 $border-radius $border-radius;\n  padding: 1.25em 1em;\n\n  i {\n    color: var(--text-neutral-secondary);\n  }\n\n  h4 {\n    margin-bottom: 0.75em;\n    color: var(--text-neutral-primary);\n\n    // Shows max two lines before truncating with ellipsis\n    // See https://css-tricks.com/line-clampin/\n    display: -webkit-box;\n    overflow: hidden;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n  }\n}\n\n.labelsAndTranslatabilityContainer {\n  display: flex;\n  column-gap: 0.25em;\n  justify-content: space-between;\n  margin-bottom: 0.5em;\n  height: 1.5em;\n\n  i {\n    font-size: 1.5em;\n  }\n}\n\n.iconWithDescription {\n  display: flex;\n  align-items: center;\n  column-gap: 0.5em;\n\n  > p {\n    font-size: 0.875em;\n    margin: 0;\n    color: var(--text-neutral-primary);\n  }\n\n  i {\n    font-size: 0.875em;\n  }\n}\n\n.buttonsContainer {\n  display: flex;\n  flex-wrap: wrap;\n  margin-top: auto;\n\n  button,\n  a,\n  a:link,\n  a:visited {\n    margin: 0;\n    height: 40px;\n    font-size: 1em;\n    line-height: 38px;\n  }\n}\n\n.buttonsContainer_notEnglish {\n  flex-direction: column-reverse;\n  row-gap: 1em;\n\n  button,\n  a,\n  a:link,\n  a:visited {\n    width: 100%;\n    display: flex;\n    justify-content: center;\n  }\n}\n\n.buttonsContainer_english {\n  justify-content: space-between;\n  column-gap: 12px;\n\n  button,\n  a,\n  a:link,\n  a:visited {\n    // width calculated to ensure space between buttons is 12px\n    // (totalContainerWidth - 2*padding - minimumSpaceBetweenButtons) / 2\n    width: math.div($container-width - (2 * 16) - 12, 2);\n  }\n}\n\n.centerExpandedCard {\n  display: flex;\n}\n\n.cardsContainer:nth-child(3n + 1) .centerExpandedCard {\n  justify-content: flex-start;\n}\n\n.cardsContainer:nth-child(3n + 2) .centerExpandedCard {\n  justify-content: center;\n}\n\n.cardsContainer:nth-child(3n + 3) {\n  .centerExpandedCard {\n    justify-content: flex-end;\n  }\n\n  .arrowContainer:before {\n    background: var(--background-neutral-secondary);\n  }\n}\n\n.expandedCard {\n  .curriculumInfoContainer {\n    border-color: var(--borders-neutral-solid) !important;\n  }\n}\n\nbutton.buttonFlex {\n  flex: 1;\n}\n\n.buttonsContainer a.teacherAndSignedOutLearnMoreButton,\n.wideCardButtonsContainer a.teacherAndSignedOutLearnMoreButton {\n  display: none;\n  text-align: center;\n  padding-top: 0;\n  padding-bottom: 0;\n}\n\n.studentLearnMoreButton {\n  text-align: center;\n}\n\n@media screen and (max-width: $width-md) {\n  .arrowContainer {\n    display: none !important;\n  }\n\n  .centerExpandedCard {\n    display: none !important;\n  }\n\n  .buttonsContainer a.teacherAndSignedOutLearnMoreButton {\n    display: block !important;\n  }\n\n  button.quickViewButton {\n    display: none !important;\n  }\n\n  .expandedCard {\n    .curriculumInfoContainer {\n      border-color: var(--borders-neutral-primary) !important;\n    }\n  }\n\n  .wideCardButtonsContainer a.teacherAndSignedOutLearnMoreButton {\n    display: block;\n  }\n}\n\n@media screen and (max-width: $width-sm) {\n  .wideCardImg {\n    display: none;\n  }\n}\n\n.wideCard {\n  display: flex;\n  flex-direction: row;\n  height: auto;\n  align-items: flex-start;\n  gap: 10px;\n  flex: 1 0 0;\n  width: 100%;\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-solid);\n  background: var(--background-neutral-primary);\n\n  img {\n    min-height: 320px;\n    height: 100%;\n    width: 50%;\n    object-fit: cover;\n    border-radius: $border-radius $border-radius 0 0;\n  }\n\n  .curriculumInfoContainer {\n    display: flex;\n    padding: 16px 24px 20px 14px;\n    flex-direction: column;\n    gap: 16px;\n    flex: 1 0 0;\n    min-height: 269px;\n    justify-content: space-between;\n    border: none;\n\n    h4 {\n      margin-bottom: 0;\n    }\n  }\n}\n\n.wideCardContent {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  align-self: stretch;\n}\n\n.wideCard .buttonsContainer {\n  align-items: flex-start;\n  flex-direction: row;\n  gap: 12px;\n  align-self: stretch;\n}\n\np.wideCardDescription {\n  margin-bottom: 0.5em;\n}\n\n.wideCardAspects {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: flex-start;\n  gap: 8px;\n  align-self: stretch;\n}\n"],sourceRoot:""}]),i.locals={"professional-learning-banner":"ogMbZrT9SsHk1l4idSBF",header_right:"kX4UpK34dShaCLgzjCOu","tutorial-block":"_5rjU1tuZV9Ww2soi9CiY","courseblock-tall":"hLY8Tib8NpX0Dw6bYbur",signin:"yLYXNcKGwaw8PwUTVf1P",signup:"uP4XsBDE04au2HXhURGn","signup-field-label":"fv5kWtvMwA_whg53UwGD",submit:"NG64Z7q6iqagTISTFsLQ","homepage-container":"_8ydax4ydTAHn2usDA3p",project_card:"HirL4fAB_FiW19WG0gBt","classroom-sections":"K2WO4z_2T4EBEuBcMVQG",courseexplorer:"QkEcwpf1rGvYdbGxG8r1",grouprow:"ytmb70shSWD4DGSEVTJl",graderow:"I5VSD8D4Z1AfI6Jzw2fU",numbered:"LfpGbd_2Z9LqPw7rNnaw",courserow:"dFpBA8F_D6gSvBGXKcq8",arrow_box:"czCEXLHF9Q74muE6GfDQ",arrow_box_content:"O1PiirwcvGea63W6zkHq",description:"RA6R5Srnhe6VbmJTB