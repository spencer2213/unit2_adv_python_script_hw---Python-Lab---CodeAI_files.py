}\n\n  .fileName {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .previewButtonWrapper {\n    margin-left: auto;\n    flex-shrink: 0;\n  }\n}\n\n.newFile {\n  .statusIndicator {\n    background-color: var(--background-success-primary);\n    border-color: var(--background-success-primary);\n  }\n}\n\n.updatedFile {\n  .statusIndicator {\n    background-color: var(--background-neutral-senary);\n    border-color: var(--background-neutral-senary);\n  }\n}\n\n.acceptedIcon {\n  margin-left: auto;\n  margin-right: 0.25rem;\n  color: var(--text-success-primary);\n}\n\n.rejectedIcon {\n  margin-left: auto;\n  margin-right: 0.25rem;\n  color: var(--text-error-primary);\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={chip:"C9mV1fKwnOXsNJ2ZY310",fileInfo:"YzNTV6d7BUq4teZ80Yry",statusIndicator:"rpNv2GECJLyZA3tLc80x",fileName:"DZOcH6FOBFXn4MBAUpF_",previewButtonWrapper:"JfL3s8gbFrLoAZvlmMCN",newFile:"LraXbOZ5o6PlHujFoCiA",updatedFile:"ht7czXOA4HuTt3913kgt",acceptedIcon:"wWijR929iwHI23ByBTE3",rejectedIcon:"e20Lzu0Ehj2bGgXX26zg"};const s=a},4418:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,'.o7NCbnieVkZrIMCe96mN{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-heading);font-weight:var(--font-weight-semi-bold);font-size:3rem;line-height:1.08;letter-spacing:-0.01em}.o7NCbnieVkZrIMCe96mN.ZG