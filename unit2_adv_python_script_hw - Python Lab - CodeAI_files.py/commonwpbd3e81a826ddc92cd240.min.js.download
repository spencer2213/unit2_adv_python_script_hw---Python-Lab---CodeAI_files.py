icon type\n@mixin generate-chat-button-hover-states($icon-color-map) {\n  @each $icon, $color in $icon-color-map {\n    &:hover:has(.icon-#{$icon}),\n    &:active:has(.icon-#{$icon}) {\n      background: var(--background-#{$color}-extra-light);\n      border-color: var(--borders-#{$color}-primary) !important;\n    }\n  }\n}\n\n@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.container {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  .userMessageContainer {\n    margin-top: auto;\n  }\n}\n\n.loading {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  background-color: var(--background-neutral-primary);\n  animation: fade-in 2s ease-in forwards;\n}\n\n/* Multiple classes used to increase specifity to override default DSCO styles */\n.chatButton.chatButton.chatButton {\n  padding: 0.25rem 0.625rem;\n  border: variables.$strong-border;\n  border-radius: 50rem;\n  gap: 0.375rem;\n\n  span {\n    font-weight: 400;\n  }\n\n  .icon {\n    width: auto;\n  }\n\n  .icon-code {\n    color: var(--text-success-primary-fixed);\n  }\n\n  .icon-lightbulb {\n    color: var(--text-warning-primary-fixed);\n  }\n\n  .icon-book {\n    color: var(--text-info-primary-fixed);\n  }\n\n  .icon-brain {\n    color: var(--text-brand-purple-primary-fixed);\n  }\n\n  .icon-bug {\n    color: var(--text-error-primary-fixed);\n  }\n\n  .icon-star {\n    color: var(--text-warning-primary-fixed);\n  }\n\n  // Hover and active states\n  @include generate-chat-button-hover-states(\n    (\n      'code': 'success',\n      'lightbulb': 'warning',\n      'book': 'info',\n      'brain': 'brand-purple',\n      'bug': 'error',\n      'star': 'warning',\n    )\n  );\n\n  // Disabled state\n  &:disabled {\n    i {\n      color: var(--text-neutral-disabled);\n    }\n  }\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={container:"yBFjYHzxLa6ucbLY4CLA",userMessageContainer:"BEFYEezxNPzXRgoCzeAr",loading:"Ln4HrX5ev50i6Bu9xy6G","fade-in":"CbCdU6ZHQC8EH30iJAMN",chatButton:"kzpDZT7uR1XcwKpzL8Vj",icon:"y9VgXe3w_vKbfIB8gegA","icon-code":"F5dnAOQSt6KV4pLzi1dd","icon-lightbulb":"cfAgw_5f_cWNETwBQEu9","icon-book":"UKBMRFJ26oRYRFXgctoW","icon-brain":"SEz_Jel2KTQVKlMPecCr","icon-bug":"soyAWap157g95XtwbtY1","icon-star":"kvr2o44HE2L7MFTUZUiJ"};const s=a},4089:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".abT3BzPkfuMwBgC_VLlk{width:100%;display:flex;padding:75px 0}.abT3BzPkfuMwBgC_VLlk i{margin:auto;font-size:50px;color:var(--text-neutral-placeholder)}.RmpGqvYuTXdzlfHzF9Io{width:85vw;min-width:200px;max-width:688px}.oJiRv8Xg3ZG45r12_Oa5{display:grid;grid-template-columns:repeat(auto-fill, 160px);gap:16px;width:100%}.rNDuvTpqnvHaGHrSkdan{border:1px solid var(--borders-neutral-primary);border-radius:4px;overflow:hidden}.Zo4To7HYMWc2YInj6JqX{position:relative;height:80px;background-color:var(--background-neutral-subtle);display:flex;align-items:center;justify-content:center;overflow:hidden}.o99f9JXCdI__9SBLGBsP{width:100%;height:100%;object-fit:cover;border-radius:0 !important}.XBlnYUtBuGh1L8HO1BqC{position:absolute;top:0;left:0;background-color:#fff;border-radius:0 0 4px 0;padding:5px}.jRwOuotH6nRGtLYl_iUy{font-size:13px}.ZFLCcogk17uvPxCVfV2A{display:flex;flex-direction:column;padding:4px 8px 6px 8px;gap:2px}.ZFLCcogk17uvP