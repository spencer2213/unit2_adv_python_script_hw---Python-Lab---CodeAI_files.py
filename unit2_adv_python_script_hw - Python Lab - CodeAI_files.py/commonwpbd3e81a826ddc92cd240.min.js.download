 display: flex;\n  align-items: baseline;\n  justify-content: flex-start;\n  gap: 7px;\n}\n\n.linkBox {\n  width: 400px;\n\n  input {\n    width: 100%;\n    box-sizing: border-box;\n  }\n}\n\n.error {\n  text-align: left;\n  margin: 7px 0;\n  min-height: 18px;\n  white-space: pre-wrap;\n}\n\n.updateButtons {\n  display: flex;\n  justify-content: space-between;\n}\n"],sourceRoot:""}]),a.locals={dialog:"BDNciBnGxYExNY1vnvjM",hidden:"W8W6yPJdDUB5tn4KrX4k",header:"AUzGT2rBEe_OAZHC0K1A",subHeader:"Nkjq49XPjMgY4aKkHDl1",libraryList:"QpWLItf7H2IQQlHxoJTZ",message:"nLnjoPMcks7vBzsCPbbI",messageInline:"r7PgvHRsGm8kkK5Y2GPc",inputParent:"ruq1QxIctYl4d6zKmu3b",linkBox:"WzKZrqU5jVobQvIXuuQe",error:"Tts9RTFwfnQeoiwBI47T",updateButtons:"kZM1naM1ebyhhMKpRTfg"};const s=a},4420:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,'.x0szwhou8fo0ff479Ukl{height:100%;overflow:hidden}.L78pLFN4z4PE8MAh58EA{overflow-y:auto;scrollbar-color:var(--background-neutral-senary) var(--background-neutral-secondary);height:100%;background-color:var(--background-neutral-secondary);border-inline-end:1px solid var(--borders-neutral-primary)}.L78pLFN4z4PE8MAh58EA>div{background-color:var(--background-neutral-secondary)}.LYdfkNHEr9200aBMihSI{display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-size:12px;box-sizing:border-box;height:24px;min-height:24px;margin-inline:.375rem;margin-bottom:2px;padding-block:.125rem}.LYdfkNHEr9200aBMihSI.VxwJ5ZWZ6Jv0mfHSLSrR{border-radius:.25rem;outline:1px solid var(--borders-brand-aqua-primary);outline-offset:-1px;background:var(--background-brand-aqua-extra-light)}.LYdfkNHEr9200aBMihSI.VxwJ5ZWZ6Jv0mfHSLSrR i{color:var(--text-neutral-primary)}.LYdfkNHEr9200aBMihSI.VxwJ5ZWZ6Jv0mfHSLSrR:hover:not(._5IaF64qxtnUs_4NjQXb){background-color:var(--background-brand-aqua-light)}.LYdfkNHEr9200aBMihSI:hover:not(._5IaF64qxtnUs_4NjQXb){background-color:var(--background-neutral-tertiary);border-radius:4px}.LYdfkN