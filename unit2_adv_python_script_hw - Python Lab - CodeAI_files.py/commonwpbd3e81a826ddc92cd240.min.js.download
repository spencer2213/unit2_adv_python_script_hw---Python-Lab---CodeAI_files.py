AA,CA6IF,sBAvKE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAyIE,oRA1KF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAmJF,sBApLE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CA+IE,oRAvLF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CAyJF,sBAjME,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAqJE,oRApMF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAkKF,sBC5OE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAwJE,2FC/OF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAgKF,sBCvPE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CA6JE,2FC1PF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CAsKF,sBCnQE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CAmKE,2FCtQF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CA2KF,sBC9QE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAwKE,2FCjRF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAkLF,sBC3RE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CAuKE,2FC9RF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CA+KF,sBCtSE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CA4KE,2FCzSF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CAoLF,sBCjTE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAiLE,2FCpTF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAyLF,6BApLE,wCAAA,CAuLA,qFAvLA,wCAAA,CA8LF,yBA1LE,iBAAA,CA6LA,yEA7LA,iBAAA,CAoMF,iCC1TE,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CA8LA,iGC7TA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CAoMF,sBACE,QAAA,CAEE,+WAQE,QAAA,CAGF,4FAEE,eAAA,CEjZN,sBACE,YAAA,CACA,kBAAA,CACA,oBAAA,CACA,oCAAA,CAEA,4CACE,YAAA,CACA,qBAAA,CACA,UAAA,CACA,sBAAA,CACA,SAAA,CAEA,kED2BF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CE5HI,MAAA,CACA,cAAA,CACA,iBAAA,CACA,iCAAA,CACA,2CAAA,CAKN,sBACE,YAAA,CACA,qBAAA,CACA,WAAA,CACA,UAAA,CAGF,sBACE,iBAAA,CACA,uBAAA,CACA,UAAA,CAGF,sBACE,sDAAA,CAGF,sBACE,oDAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","@use '@code-dot-org/component-library-styles/typography.module.scss' as\n  typography;\n\n.notification {\n  display: flex;\n  align-items: center;\n  border-radius: 0.25rem;\n  padding: 0.625rem 0.75rem 0.75rem 0.75rem;\n\n  .notificationContent {\n    display: flex;\n    flex-direction: column;\n    flex: 1 0 0;\n    align-items: flex-start;\n    gap: 0.5rem;\n\n    .notificationText {\n      @include typography.body-three;\n      flex: 1;\n      margin-top: 2px;\n      margin-bottom: 4px;\n      color: var(--text-neutral-primary);\n      font-feature-settings: 'liga' off, 'clig' off;\n    }\n  }\n}\n\n.fileList {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  width: 100%;\n}\n\n.commitDescriptionContainer {\n  margin-top: 0.25rem;\n  margin-bottom: -0.375rem;\n  width: 100%;\n}\n\n.notification-accept {\n  background-color: var(--background-success-extra-light);\n}\n\n.notification-reject {\n  background-color: var(--background-error-extra-light);\n}\n\n"],sourceRoot:""}]),a.locals={"heading-xxl":"py9Q71hjzLRddqIqG4Vx",wrapper:"QiZnQN82AhzjsvGUUFEw","heading-xl":"ttu0hW23O5rTb9ToaMQz","heading-lg":"f3Qopkpz9EsoWW2SrPJA","heading-md":"yse8CQCkJsuxiwLWBFoG","heading-sm":"ChUJS2D7lwsdJQxY1Peg","heading-xs":"meVMjc8yp8reU443EUAd","body-one":"OG02a_sPJDABK5NnrVFD","body-two":"FPA8UAxtX2hxoPRkYlf9","body-three":"KWj4cwg6nfQpkhtL6DUg","body-four":"sBJPDAMz5VezhtAdTyUs","overline-one":"MxBVI56HC6HxeHXfU6Cw","overline-two":"t803Ac5jl5VfhdR9auZu","overline-three":"ggAcB7tAOFNX9GWVPR3O",strong:"pIHKkc5NlgNlgeAF70XD",em:"yQiytHGDnc4gayIx4loo",figcaption:"PBPzruzpBFTOP4enYLug","no-margin":"AKq2oXGAPzVL8ZJ3xqjj",notification:"fAUeq2o_qso99yjibovK",notificationContent:"c_V8VgEVbMfjYzfItmzn",notificationText:"PKqZokcCgRetWEEzZ9yt",fileList:"RHUWzaXUGxaIFvUDGyGV",commitDescriptionContainer:"tmFemug4PLx21ASZW0Wl","notification-accept":"ItiMwz9GMbpAgEauZcZy","notification-reject":"Ulie1JDPURVUkowE_lCB"};const s=a},4431:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".uQ3zVfgNgMVGczsIPVj_{display:inline-flex;flex-direction:column;gap:.5rem}.skaAjbJHM8Zczqdq3EDg{padding-top:.625rem;display:flex;flex-direction:column;gap:.375rem}._H3AXQ7Hixton3SKK4ZQ{display:flex;flex-wrap:wrap;gap:8px}.aABRtZtvDOSgvtlB8ofm{flex:1;min-width:107px}.NrPPiav8iHca5lLprA4h{padding-top:.5rem;padding-bottom:.5rem;border-radius:0 0 4px 4px}.aH0DiZoADPhDJXCXbkQA{padding-bottom:.5rem;width:100%;box-sizing:border-box}.TpXmBD5XFjlHSdUsTRxA{width:100%;height:75px;resize:none;box-sizing:border-box;background-color:var(--background-neutral-primary);border:1px solid var(--borders-neutral-strong);border-radius:4px;box-shadow:none;color:var(--text-neutral-secondary);margin-bottom:.375rem;padding:.625rem}.TpXmBD5XFjlHSdUsTRxA::placeholder{color:var(--text-neutral-placeholder)}.TpXmBD5XFjlHSdUsTRxA:focus{outline:none;border:1px solid var(--borders-neutral-strong);box-shadow:none}.TpXmBD5XFjlHSdUsTRxA:focus-visible{outline:2px solid var(--borders-brand-teal-primary);outline-offset:2px}.DV8sbW65nGlI6DEgODXh{flex:1}.rv5_Xn6deSZUpP1Jx1Wg{display:flex;align-items:center;gap:8px}","",{version:3,sources:["webpack://./src/aiComponentLibrary/aiTutorVersionActions/ai-tutor-version-actions.module.scss","webpack://./src/lab2/views/components/layout/variables.scss","webpack://./src/mixins.scss"],names:[],mappings:"AAGA,sBACE,mBAAA,CACA,qBAAA,CACA,SAAA,CAGF,sBACE,mBAAA,CACA,YAAA,CACA,qBAAA,CACA,WAAA,CAGF,sBACE,YAAA,CACA,cAAA,CACA,OAAA,CAGF,sBACE,MAAA,CACA,eAAA,CAGF,sBACE,iBAAA,CACA,oBAAA,CACA,yBAAA,CAIF,sBACE,oBAAA,CACA,UAAA,CACA,qBAAA,CAGF,sBACE,UAAA,CACA,WAAA,CACA,WAAA,CACA,qBAAA,CACA,kDAAA,CACA,8CCxCc,CDyCd,iBCtCsB,CDuCtB,eAAA,CACA,mCAAA,CACA,qBAAA,CACA,eAAA,CAEA,mCACE,qCAAA,CAGF,4BACE,YAAA,CACA,8CCrDY,CDsDZ,eAAA,CEsBF,oCACE,mDAAA,CACA,kBAJe,CFdnB,sBACE,MAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,OAAA",sourcesContent:["@use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n@use '@cdo/apps/mixins.scss' as mixins;\n\n.container {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.fileList {\n  padding-top: 0.625rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n}\n\n.buttonContainer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.actionButton {\n  flex: 1;\n  min-width: 107px; // Triggers wrapping when container is narrow.\n}\n\n.saveAiTutorVersionDescription {\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n  border-radius: 0 0 variables.$default-border-radius\n    variables.$default-border-radius;\n}\n\n.saveAiTutorVersionDescriptionInput {\n  padding-bottom: 0.5rem;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.textArea {\n  width: 100%;\n  height: 75px;\n  resize: none;\n  box-sizing: border-box;\n  background-color: var(--background-neutral-primary);\n  border: variables.$strong-border;\n  border-radius: variables.$default-border-radius;\n  box-shadow: none;\n  color: var(--text-neutral-secondary);\n  margin-bottom: 0.375rem;\n  padding: 0.625rem;\n\n  &::placeholder {\n    color: var(--text-neutral-placeholder);\n  }\n\n  &:focus {\n    outline: none;\n    border: variables.$strong-border;\n    box-shadow: none;\n  }\n\n  @include mixins.focus-styles;\n}\n\n.saveAiTutorVersionButton {\n  flex: 1;\n}\n\n.saveAiTutorVersionActions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n","// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n"],sourceRoot:""}]),a.locals={container:"uQ3zVfgNgMVGczsIPVj_",fileList:"skaAjbJHM8Zczqdq3EDg",buttonContainer:"_H3AXQ7Hixton3SKK4ZQ",actionButton:"aABRtZtvDOSgvtlB8ofm",saveAiTutorVersionDescription:"NrPPiav8iHca5lLprA4h",saveAiTutorVersionDescriptionInput:"aH0DiZoADPhDJXCXbkQA",textArea:"TpXmBD5XFjlHSdUsTRxA",saveAiTutorVersionButton:"DV8sbW65nGlI6DEgODXh",saveAiTutorVersionActions:"rv5_Xn6deSZUpP1Jx1Wg"};const s=a},4415:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".C9mV1fKwnOXsNJ2ZY310{height:30px;display:flex;align-items:center;gap:.5rem;padding:.25rem .25rem .25rem 40px;border-radius:.25rem;background-color:var(--background-neutral-primary);border:1px solid var(--borders-neutral-strong);position:relative;box-sizing:border-box}.C9mV1fKwnOXsNJ2ZY310 .YzNTV6d7BUq4teZ80Yry{display:flex;align-items:center;gap:.5rem;flex:1;min-width:0}.C9mV1fKwnOXsNJ2ZY310 .rpNv2GECJLyZA3tLc80x{position:absolute;top:-1px;left:-1px;bottom:-1px;width:32px;border-radius:.25rem 0 0 .25rem;display:flex;align-items:center;justify-content:center;border:1px solid rgba(0,0,0,0);border-right:none;box-sizing:border-box}.C9mV1fKwnOXsNJ2ZY310 .rpNv2GECJLyZA3tLc80x i{font-size:14px;color:var(--text-neutral-white-fixed)}.C9mV1fKwnOXsNJ2ZY310 .DZOcH6FOBFXn4MBAUpF_{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.C9mV1fKwnOXsNJ2ZY310 .JfL3s8gbFrLoAZvlmMCN{margin-left:auto;flex-shrink:0}.LraXbOZ5o6PlHujFoCiA .rpNv2GECJLyZA3tLc80x{background-color:var(--background-success-primary);border-color:var(--background-success-primary)}.ht7czXOA4HuTt3913kgt 