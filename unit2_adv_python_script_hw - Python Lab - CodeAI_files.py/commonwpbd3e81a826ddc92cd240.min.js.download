.qVTyHuVmtThG2DR8vax9.ps4MuIBMbW9RdnxndlQr p,.qVTyHuVmtThG2DR8vax9.ps4MuIBMbW9RdnxndlQr li{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;color:var(--text-neutral-primary);margin-bottom:1em;font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;text-transform:uppercase;letter-spacing:.06em;font-size:var(--font-size-body-xs);line-height:1.5}.SqNVc7cj3ZAccg2lXhMi{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;color:var(--text-neutral-primary);margin-bottom:1em;font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;text-transform:uppercase;letter-spacing:.06em;font-size:var(--font-size-body-xxs);line-height:1.6}.SqNVc7cj3ZAccg2lXhMi.ps4MuIBMbW9RdnxndlQr p,.SqNVc7cj3ZAccg2lXhMi.ps4MuIBMbW9RdnxndlQr li{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;color:var(--text-neutral-primary);margin-bottom:1em;font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;text-transform:uppercase;letter-spacing:.06em;font-size:var(--font-size-body-xxs);line-height:1.6}strong,.YHtXq5y6Qj75NbFK4d3t{font-weight:var(--font-weight-semi-bold)}strong.ps4MuIBMbW9RdnxndlQr strong,.YHtXq5y6Qj75NbFK4d3t.ps4MuIBMbW9RdnxndlQr strong{font-weight:var(--font-weight-semi-bold)}em,.eOcsNzQJjrSBqx32c9X1{font-style:italic}em.ps4MuIBMbW9RdnxndlQr em,.eOcsNzQJjrSBqx32c9X1.ps4MuIBMbW9RdnxndlQr em{font-style:italic}figcaption,.aIa2G2rMbOi4AOdWq2kB{font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;color:var(--text-neutral-primary);font-size:.875rem;line-height:1.54;margin:.5em 0 1em}figcaption.ps4MuIBMbW9RdnxndlQr figcaption,.aIa2G2rMbOi4AOdWq2kB.ps4MuIBMbW9RdnxndlQr figcaption{font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);font-style:normal;color:var(--text-neutral-primary);font-size:.875rem;line-height:1.54;margin:.5em 0 1em}.SF6IsMwasmXSThFMWzcK{margin:0}.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h1,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h2,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h3,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h4,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h5,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr h6,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr p,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr li{margin:0}.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr ol,.SF6IsMwasmXSThFMWzcK.ps4MuIBMbW9RdnxndlQr ul{margin-bottom:0}.jftsyPiUQREVnKCwm6Qt{background:var(--background-neutral-primary);padding:.625rem;width:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:.5rem;transition:outline .2s ease-in;cursor:text;border:1px solid var(--borders-neutral-strong);border-radius:.25rem}.jftsyPiUQREVnKCwm6Qt.O_HuWERDooMDpb3ng4AY{outline:var(--borders-brand-teal-primary) solid 2px;outline-offset:.125rem}.jftsyPiUQREVnKCwm6Qt .yvC73oiAWGb5wpUyufaZ{min-height:22px;max-height:250px;box-sizing:border-box;resize:none;margin:0;padding:0;width:100%;border:none;outline:none;box-shadow:none;background:var(--background-neutral-primary);color:var(--text-neutral-primary)}.jftsyPiUQREVnKCwm6Qt .yvC73oiAWGb5wpUyufaZ::placeholder{color:var(--text-neutral-placeholder)}.jftsyPiUQREVnKCwm6Qt .yvC73oiAWGb5wpUyufaZ:disabled{opacity:.5;background:none}.jftsyPiUQREVnKCwm6Qt .CEU9ODdd66WDX4GEoJYw{display:flex;justify-content:space-between;position:sticky;bottom:0;background:var(--background-neutral-primary);margin:-10px;padding:10px;border-radius:.25rem}.jftsyPiUQREVnKCwm6Qt .CEU9ODdd66WDX4GEoJYw>*:only-child{margin-left:auto}._CU5SpxJM1eam8Yb9u6N{display:flex;gap:.5rem}","",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/typography.module.scss","webpack://./../frontend/packages/component-library-styles/font.scss","webpack://./src/aiComponentLibrary/userMessageEditor/user-message-editor.module.scss","webpack://./../frontend/packages/component-library-styles/mixins.scss","webpack://./../frontend/packages/component-library-styles/variables.scss"],names:[],mappings:"AAsMA,sBAhIE,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,sBAAA,CAyHE,oRAnIF,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,sBAAA,CAmIF,sBA7IE,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA,CACA,sBAAA,CA6HE,oRAhJF,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA,CACA,sBAAA,CAuIF,sBA1JE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD4BA,iBAAA,CACA,gBAAA,CAmIE,oRA7JF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD4BA,iBAAA,CACA,gBAAA,CA6IF,sBAvKE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAyIE,oRA1KF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDmCA,gBAAA,CACA,gBAAA,CAmJF,sBApLE,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CA+IE,oRAvLF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0CA,kBAAA,CACA,gBAAA,CAyJF,sBAjME,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAqJE,oRApMF,iCAAA,CACA,iBAAA,CCNA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDiDA,iBAAA,CACA,eAAA,CAkKF,sBC5OE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAwJE,2FC/OF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAKA,kCAAA,CACA,gBAAA,CAgKF,sBCvPE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CA6JE,2FC1PF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAWA,kCAAA,CACA,eAAA,CAsKF,sBCnQE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CAmKE,2FCtQF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAiBA,kCAAA,CACA,gBAAA,CA2KF,sBC9QE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAwKE,2FCjRF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CAuBA,kCAAA,CACA,eAAA,CAkLF,sBC3RE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CAuKE,2FC9RF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAKA,kCAAA,CACA,gBAAA,CA+KF,sBCtSE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CA4KE,2FCzSF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAWA,kCAAA,CACA,eAAA,CAoLF,sBCjTE,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAiLE,2FCpTF,mCAAA,CACA,sCAAA,CACA,iBAAA,CD8EA,iCAAA,CACA,iBAAA,CC3DA,mCAAA,CACA,wCAAA,CACA,iBAAA,CDwFA,wBAAA,CACA,oBAAA,CAiBA,mCAAA,CACA,eAAA,CAyLF,6BApLE,wCAAA,CAuLA,qFAvLA,wCAAA,CA8LF,yBA1LE,iBAAA,CA6LA,yEA7LA,iBAAA,CAoMF,iCC1TE,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CA8LA,iGC7TA,mCAAA,CACA,wCAAA,CACA,iBAAA,CD0HA,iCAAA,CACA,iBAAA,CACA,gBAAA,CACA,iBAAA,CAoMF,sBACE,QAAA,CAEE,+WAQE,QAAA,CAGF,4FAEE,eAAA,CElZN,sBACE,4CAAA,CACA,eAAA,CACA,UAAA,CACA,qBAAA,CACA,YAAA,CACA,qBAAA,CACA,SAAA,CACA,8BAAA,CACA,WAAA,CCyKA,8CAAA,CACA,oBChLsB,CFWtB,2CC6IA,mDAAA,CACA,sBAAA,CDzIA,4CACE,eAAA,CACA,gBAAA,CACA,qBAAA,CACA,WAAA,CACA,QAAA,CACA,SAAA,CACA,UAAA,CACA,WAAA,CACA,YAAA,CACA,eAAA,CACA,4CAAA,CACA,iCAAA,CAEA,yDACE,qCAAA,CAGF,qDACE,UAAA,CACA,eAAA,CAKJ,4CACE,YAAA,CACA,6BAAA,CACA,eAAA,CACA,QAAA,CAEA,4CAAA,CACA,YAAA,CACA,YAAA,CACA,oBAAA,CAGA,yDACE,gBAAA,CAKN,sBACE,YAAA,CACA,SAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.01em;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n","@use '@code-dot-org/component-library-styles/mixins.scss' as mixins;\n\n.editorContainer {\n  background: var(--background-neutral-primary);\n  padding: 0.625rem;\n  width: 100%;\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  transition: outline 0.2s ease-in;\n  cursor: text;\n\n  @include mixins.border-styles($border-color: var(--borders-neutral-strong));\n\n  // Add focus styles to the container when the textarea is focused\n  &.focused {\n    @include mixins.focus-styles;\n  }\n\n  // Textarea styles\n  .textArea {\n    min-height: 22px;\n    max-height: 250px;\n    box-sizing: border-box;\n    resize: none;\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    border: none;\n    outline: none;\n    box-shadow: none;\n    background: var(--background-neutral-primary);\n    color: var(--text-neutral-primary);\n\n    &::placeholder {\n      color: var(--text-neutral-placeholder);\n    }\n\n    &:disabled {\n      opacity: 0.5;\n      background: none;\n    }\n  }\n\n  // Chat Actions container styles\n  .chatActionsContainer {\n    display: flex;\n    justify-content: space-between;\n    position: sticky;\n    bottom: 0;\n    // Ensure chat actions container background hides chat content when pinned\n    background: var(--background-neutral-primary);\n    margin: -10px;\n    padding: 10px;\n    border-radius: 0.25rem;\n\n    // If there's only one child element, align it to the right\n    & > *:only-child {\n      margin-left: auto;\n    }\n  }\n}\n\n.actionButtons {\n  display: flex;\n  gap: 0.5rem;\n}\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: var(--font-size-body-xxs);\n  line-height: 1.6;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.44;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.57;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.5;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n","// Design System wide common variables\n\n$form-field-width: 18.75rem;\n\n// Border radius\n$regular-border-radius: 0.25rem;\n\n// z-index values\n// These values match Bootstrap's z-index values\n// See: https://getbootstrap.com/docs/5.0/layout/z-index/\n$zindex-dropdown: 1000;\n$zindex-sticky: 1020;\n$zindex-fixed: 1030;\n$zindex-modal-backdrop: 1040;\n$zindex-offcanvas: 1050;\n$zindex-modal: 1060;\n$zindex-popover: 1070;\n$zindex-tooltip: 1080;\n"],sourceRoot:""}]),a.locals={"heading-xxl":"AmiHdTieK3BvspUQWVtv",wrapper:"ps4MuIBMbW9RdnxndlQr","heading-xl":"JzFQ_bkqsTD_RNybMwza","heading-lg":"vsajsebWibxbM97IwAHN","heading-md":"VLLbzg9ctUIsVMV0OCQ7","heading-sm":"VUNa7RcfvCDzcyHaFEFj","heading-xs":"MIPnwjf5GYGdhhdbaHMd","body-one":"q1RUXvPDqsjHZDBLn5ub","body-two":"X341gNaIUqTu1ec89ROc","body-three":"ohBqhCe6hDfcVCoQfUHt","body-four":"u0FCO0jnH_ZFlsbDVPLv","overline-one":"KljjFwxa03eZ4gg1rp3G","overline-two":"qVTyHuVmtThG2DR8vax9","overline-three":"SqNVc7cj3ZAccg2lXhMi",strong:"YHtXq5y6Qj75NbFK4d