ral-primary);\n      }\n    }\n\n    > .codeContentOverlay {\n      position: absolute;\n      transition: opacity 1s ease;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      color: var(--neutral-base-white);\n      font-size: 1.1rem;\n      display: inline-block;\n      white-space: nowrap;\n      opacity: 0;\n      pointer-events: none;\n\n      &.showOverlay {\n        opacity: 1;\n        transition: none;\n        pointer-events: unset;\n      }\n\n      > .codeContentOverlayBackground {\n        width: 100%;\n        height: 100%;\n        background-color: var(--neutral-base-black);\n        opacity: 0.9;\n      }\n\n      > .codeContentAriaMessage {\n        opacity: 0;\n      }\n\n      > .codeContentOverlayMessage {\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n\n        > .checkMarkIcon {\n          color: var(--sentiment-success-50);\n          margin-right: 0.2rem;\n        }\n      }\n    }\n  }\n}\n"],sourceRoot:""}]),a.locals={codeBlock:"d33s6ADvrQF1kx5uUZRT",header:"r80cAcd5tnpLH2vaVQ40",copyButton:"U7TN_Sce2jxQlRk5tqrd",codeContentBody:"pVheWKhz79PNXSwd9ViI",codeContent:"R3t_gy31GBPugBikMDNK",codeContentOverlay:"XU8qG9AHyZPXahjTJtzN",showOverlay:"COVq53SnCAC9lad2ntow",codeContentOverlayBackground:"vVntNhas68eIzBMBP2BA",codeContentAriaMessage:"fUK9T_Y8C5bSjDgLXph9",codeContentOverlayMessage:"rXrJXcHRaIQkEVxDeiNg",checkMarkIcon:"FLNhdeX7naCSatUbXxPA"};const s=a},4427:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".Mp05GPz5egEOVp1RZSkh{display:flex;gap:.5rem}.Mp05GPz5egEOVp1RZSkh .zTfBuEFLtRENTkfJ6egS i{font-size:16px}.Mp05GPz5egEOVp1RZSkh .zTfBuEFLtRENTkfJ6egS i.jm2zPNAPAJx4JR_Fy8y5{color:var(--text-error-primary)}.Mp05GPz5egEOVp1RZSkh .zTfBuEFLtRENTkfJ6egS i._A3KHzjWVWgwodUN3y0b{color:var(--text-info-primary)}.QL67LWYSIUZVd1QM_hy3{position:relative;display:flex}@keyframes _SA6jDZyrSTe5_5sT2ZQ{0%{opacity:10