oading {\n  width: 100%;\n  display: flex;\n  padding: 75px 0;\n  i {\n    margin: auto;\n    font-size: 50px;\n    color: var(--text-neutral-placeholder);\n  }\n}\n\n.starterAssetsModal {\n  width: 85vw;\n  min-width: 200px;\n  max-width: calc($card-width * 4 + $card-gap * 3);\n}\n\n.modalBody {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, $card-width);\n  gap: $card-gap;\n  width: 100%;\n}\n\n.fileIconCard {\n  border: 1px solid var(--borders-neutral-primary);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.fileIconImageArea {\n  position: relative;\n  height: calc($card-width / 2);\n  background-color: var(--background-neutral-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n\n.fileIconImage {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border-radius: 0 !important;\n}\n\n.checkboxOverlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  background-color: white;\n  border-radius: 0 0 4px 0;\n  padding: 5px;\n}\n\n.loadingIcon {\n  font-size: 13px;\n}\n\n.fileInfo {\n  display: flex;\n  flex-direction: column;\n  padding: 4px 8px 6px 8px;\n  gap: 2px;\n\n  .filenameRow {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 4px;\n  }\n\n  .fileInfoRow {\n    display: flex;\n    align-items: baseline;\n    gap: 4px;\n  }\n\n  .filename {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    font-size: 13px;\n  }\n\n  .fileDetail {\n    color: var(--text-neutral-quaternary);\n    font-size: 11px;\n  }\n}\n\n.previewButton {\n  flex-shrink: 0;\n}\n\n.warningIcon {\n  font-size: 13px;\n  color: var(--text-warning-primary);\n  &:hover {\n    color: var(--text-warning-secondary);\n  }\n}\n\n.pdfIcon {\n  display: flex;\n  border-radius: 4px;\n  height: 50px;\n  width: 50px;\n  background-color: var(--background-brand-teal-primary);\n\n  i {\n    margin: auto;\n    color: white;\n    font-size: 1.5rem;\n  }\n}\n\n.alertContainer {\n  width: 100%;\n  display: flex;\n\n  .alert {\n    flex: 1;\n  }\n}\n\n.modalActionsRow {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 8px 0 4px;\n  width: 100%;\n}\n"],sourceRoot:""}]),a.locals={loading:"abT3BzPkfuMwBgC_VLlk",starterAssetsModal:"RmpGqvYuTXdzlfHzF9Io",modalBody:"oJiRv8Xg3ZG45r12_Oa5",fileIconCard:"rNDuvTpqnvHaGHrSkdan",fileIconImageArea:"Zo4To7HYMWc2YInj6JqX",fileIconImage:"o99f9JXCdI__9SBLGBsP",checkboxOverlay:"XBlnYUtBuGh1L8HO1BqC",loadingIcon:"jRwOuotH6nRGtLYl_iUy",fileInfo:"ZFLCcogk17uvPxCVfV2A",filenameRow:"xvVcmHVQtZq3rv0z3joM",fileInfoRow:"HRy6bAd_2ckcASo4w491",filename:"SOnBqaxAcSPS8vdbk882",fileDetail:"iQK2Yukl5NNxVvF3Wovg",previewButton:"xULB1Erk3oQ1xLHoAoqD",warningIcon:"Gwlu1Z9OCL19cKMk9LsA",pdfIcon:"oewxpK5tohRxkGFa5zJT",alertContainer:"BYkA5hQjdigpSgDEOrtn",alert:"nNi9D3QEs03qbqdtwaUj",modalActionsRow:"oPOfsjAGN4CAAI3BH4yQ"};const s=a},5008:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".z31X5DGQWV78Qz7qT1sw{display:flex;flex-wrap:wrap;justify-content:center;gap:3px}._Pr1lfwvWkZh7OxuS2gi{min-width:120px;margin:4px}","",{version:3,sources:["webpack://./src/lib/tools/jsdebugger/DebugButtons.module.scss"],names:[],mappings:"AAAA,sBACE,YAAA,CACA,cAAA,CACA,sBAAA,CACA,OAAA,CAGF,sBACE,eAAA,CACA,UAAA",sourcesContent:[".debugButtonsContainer {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 3px;\n}\n\n.debuggerButton {\n  min-width: 120px;\n  margin: 4px;\n}\n"],sourceRoot:""}]),a.locals={debugButtonsContainer:"z31X5DGQWV78Qz7qT1sw",debuggerButton:"_Pr1lfwvWkZh7OxuS2gi"};const s=a},5009:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".yOY4PtEkCQldUjhaWBuF{width:100%;min-width:163px;height:initial;background:var(--background-neutral-primary);color:var(--text-neutral-tertiary);border:1px var(--border-neutral-primary) solid;padding:0;margin-top:-2px;margin-left:-1px;border-radius:6px}.FWQy6vu1qA8d5akA