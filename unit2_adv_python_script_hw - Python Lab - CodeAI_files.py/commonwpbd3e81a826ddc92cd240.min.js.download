ACA,kBAAA,CACA,eAAA,CACA,MAAA,CAEA,eAAA,CACA,uBAAA,CACA,eAAA,CACA,WAAA,CACA,SAAA,CACA,QAAA,CACA,cAAA,CACA,aAAA,CACA,YAAA,CACA,mBAAA,CACA,gBAAA,CACA,WAAA,CACA,qBAAA,CAEA,wBACE,kCAAA,CAIJ,sBACE,mDAAA,CAGF,sBACE,0BAAA,CAGF,sBACE,UAAA,CACA,eAAA,CAGF,sBACE,qCAAA,CACA,cAAA,CAGF,sBACE,YAAA,CACA,iBAAA,CACA,OAAA,CAGF,sBACE,+BAAA,CACA,cAAA,CAIF,sBACE,kDAAA,CACA,iBClNsB,CDmNtB,oCAAA,CACA,eAAA,CAGF,oCACE,mDAAA,CACA,mBAAA,CACA,qBAAA",sourcesContent:["@use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n\n.fileBrowser {\n  height: 100%;\n  overflow: hidden;\n}\n\n.fileBrowserContents {\n  overflow-y: auto;\n  scrollbar-color: var(--background-neutral-senary)\n    var(--background-neutral-secondary);\n  height: 100%;\n  background-color: var(--background-neutral-secondary);\n  border-inline-end: variables.$default-border;\n\n  // Override the background color of any child divs\n  & > div {\n    background-color: var(--background-neutral-secondary);\n  }\n}\n\n.row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  cursor: pointer;\n  font-size: 12px;\n  box-sizing: border-box;\n  height: 24px;\n  min-height: 24px;\n  margin-inline: 0.375rem;\n  margin-bottom: 2px;\n  padding-block: 0.125rem;\n\n  &.aiTutorVersion {\n    border-radius: 0.25rem;\n    outline: 1px solid var(--borders-brand-aqua-primary);\n    outline-offset: -1px;\n    background: var(--background-brand-aqua-extra-light);\n\n    i {\n      color: var(--text-neutral-primary);\n    }\n\n    &:hover:not(.dragging) {\n      background-color: var(--background-brand-aqua-light);\n    }\n  }\n\n  &:hover:not(.dragging) {\n    background-color: var(--background-neutral-tertiary);\n    border-radius: variables.$default-border-radius;\n  }\n\n  .rowIcon {\n    margin: 0.125rem 0.375rem 0.125rem 0.5rem;\n    font-size: inherit;\n    line-height: 125%;\n    width: 0.75rem;\n    text-align: center;\n\n    &::before {\n      vertical-align: middle;\n    }\n  }\n}\n\n// list-style:none removes default markers; role=\"list\" on every <ol> using this\n// class restores the VoiceOver/Safari semantics that list-style:none strips.\n.folder {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n// Child icon lines up with the parent label (icon + its end margin).\n// Guide line is the parent icon center.\n.fileBrowser .folder .folder {\n  position: relative;\n  padding-inline-start: 1.125rem;\n\n  &::before {\n    content: '';\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 1.15rem;\n    width: 1px;\n    background-color: var(--borders-neutral-primary);\n    pointer-events: none;\n  }\n}\n\n.fileBrowser .folder div span.button-bar {\n  display: flex;\n  justify-content: flex-start;\n  flex-direction: column;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.fileBrowser .folder div span.button-bar span:hover {\n  background-color: var(--background-neutral-quaternary);\n}\n\n.fileBrowser .folder div span.button-bar span {\n  display: grid;\n  grid-template-columns: 15px auto;\n}\n\n// !important: MUI's XS IconButton size is more specific.\nbutton.button-kebab {\n  opacity: 0;\n  box-sizing: border-box;\n  flex-shrink: 0;\n  height: 20px !important;\n  width: 20px !important;\n  min-height: 20px !important;\n  min-width: 20px !important;\n  padding: 0 !important;\n  margin-block: 0;\n  margin-inline: 0.125rem;\n  transition: none;\n\n  // We use important here because the hover, and active styles used by Button\n  // are more specific than a single class.\n  // We need a different hover color for the kebab button because it is on top of another\n  // element with the standard hover color.\n  &:hover,\n  &:active {\n    opacity: 1;\n    background-color: var(--background-neutral-quinary) !important;\n  }\n}\n\n// This allows the ellipsis to display when the row is hovered or contains focus\n.row:hover > .button-kebab,\n.row:focus-within > .button-kebab,\nbutton.button-kebab:focus {\n  opacity: 1;\n}\n\n.nameContainer {\n  overflow: hidden;\n  flex: 1;\n  min-width: 0;\n  width: auto;\n\n  p {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    // Override body4 (13px) to match the 12px row.\n    font-size: inherit;\n\n    .activeFile & {\n      font-weight: 600;\n    }\n  }\n}\n\n.label {\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  align-self: stretch;\n  overflow: hidden;\n  flex: 1;\n  // Button reset — ensures <button> renders identically to the old <div>\n  appearance: none;\n  -webkit-appearance: none;\n  background: none;\n  border: none;\n  padding: 0;\n  margin: 0;\n  cursor: pointer;\n  color: inherit;\n  font: inherit;\n  line-height: inherit;\n  text-align: start;\n  min-width: 0;\n  box-sizing: border-box;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n}\n\n.acceptingDrop {\n  background-color: var(--background-neutral-tertiary);\n}\n\n.expandedDroppableArea {\n  padding-block: 0.25rem 0.5rem;\n}\n\n.dropdownItem {\n  width: auto;\n  min-width: 100px;\n}\n\n.alertIcon {\n  color: var(--text-error-primary-fixed);\n  font-size: 1rem;\n}\n\n.backpackErrorContainer {\n  display: flex;\n  align-items: start;\n  gap: 8px;\n}\n\n.backpackErrorMessage {\n  color: var(--text-error-primary);\n  font-size: 1rem;\n}\n\n// Style applied when a file or folder is being dragged\n.dragging {\n  background-color: var(--background-neutral-primary);\n  border-radius: variables.$default-border-radius;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);\n  cursor: grabbing;\n}\n\n.label:focus-visible {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: -2px;\n  border-radius: 0.375rem;\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={fileBrowser:"x0szwhou8fo0ff479Ukl",fileBrowserContents:"L78pLFN4z4PE8MAh58EA",row:"LYdfkNHEr9200aBMihSI",aiTutorVersion:"VxwJ5ZWZ6Jv0mfHSLSrR",dragging:"_5IaF64qxtnUs_4NjQXb",rowIcon:"zH9d0DZwBPrVrLHe4edD",folder:"jbECaddsrNwfAcu0I7iz","button-bar":"hRZs3yrXz53qu5GpEzx1","button-kebab":"oDP8_PKlgv7PhUYTMGZs",nameContainer:"ZX7N2kUlGtlw8lvIkX5A",activeFile:"Si7WEy1gUpB2SFRqDsCs",label:"LkoFO0mY31NWfZ2Jucas",acceptingDrop:"s831YbTN03x3s7kpJ8e4",expandedDroppableArea:"zn3614E2wS8QLCYsipDr",dropdownItem:"gkPzn9L33zY01o8NeuTa",alertIcon:"ixhP7EKoYXwTtheOiAFt",backpackErrorContainer:"aAGhT8TmKH3kcrlar5r9",backpackErrorMessage:"oTF_yL5X2EEWwO_bwwyl"};const s=a},4419:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".euvcKOL3uJNqK1dEIfH9{position:absolute;cursor:pointer;border:1px solid var(--borders-neutral-primary);border-radius:4px;padding:.25rem 0;background-color:var(--background-neutral-primary);box-shadow:rgba(0,0,0,.1) 0 10px 15px -3px,rgba(0,0,0,.05) 0 4px 6px -2px;color:var(--text-neutral-primary);min-width:100px;text-align:left;vertical-align:top;z-index:1000}.euvcKOL3uJNqK1dEIfH9:focus-visible{outline:var(--borders-brand-teal-primary) solid 2px;outline-offset:2px;border-radius:.25rem}.euvcKOL3uJNqK1dEIfH9 *:focus-visible{outline:var(--borders-brand-teal-primary) solid 2px;outline-offset:-1px;border-radius:0}button.Iy7IV8iSoHL1V5eqmj6T{opacity:1 !important}","",{version:3,sources:["webpack://./src/codebridge/PopUpButton/pop-up-button.module.scss"],names:[],mappings:"AAMA,sBACE,iBAAA,CACA,cAAA,CACA,+CAAA,CACA,iBAAA,CACA,gBAAA,CACA,kDAAA,CACA,yEAAA,CAEA,iCAAA,CACA,eAAA,CACA,eAAA,CACA,kBAAA,CACA,YAAA,CAEA,oCApBA,mDAAA,CACA,kBAoBwB,CAnBxB,oBAmB6B,CAG7B,sCAxBA,mDAAA,CACA,mBAwBwB,CAvBxB,eAuB8B,CAMhC,4BACE,oBAAA",sourcesContent:["@mixin focus-styles($outline-offset, $border-radius) {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: $outline-offset;\n  border-radius: $border-radius;\n}\n\n.popup-button-menu {\n  position: absolute;\n  cursor: pointer;\n  border: 1px solid var(--borders-neutral-primary);\n  border-radius: 4px;\n  padding: 0.25rem 0;\n  background-color: var(--background-neutral-primary);\n  box-shadow: rgba(0 0 0 / 0.1) 0 10px 15px -3px,\n    rgba(0 0 0 / 0.05) 0 4px 6px -2px;\n  color: var(--text-neutral-primary);\n  min-width: 100px;\n  text-align: left;\n  vertical-align: top;\n  z-index: 1000;\n\n  &:focus-visible {\n    @include focus-styles(2px, 0.25rem);\n  }\n  // Apply focus-visible styles to all child elements\n  *:focus-visible {\n    @include focus-styles(-1px, 0);\n  }\n}\n\n// We need !important because of css specificity- this would be overriden\n// by display: none otherwise.\nbutton.active {\n  opacity: 1 !important;\n}\n"],sourceRoot:""}]),a.locals={"popup-button-menu":"euvcKOL3uJNqK1dEIfH9",active:"Iy7IV8iSoHL1V5eqmj6T"};const s=a},4421:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".SRwHGax2saTpkOW6vx71{display:flex;padding-block:.25rem;padding-inline:.5rem .625rem;align-items:center;gap:.375rem;align-self:stretch;transition:background-color .2s ease-in-out}.SRwHGax2saTpkOW6vx71:hover{background-color:var(--background-neutral-tertiary)}.SRwHGax2saTpkOW6vx71 i{color:var(--text-neutral-primary);text-align:center;width:1rem}","",{version:3,sources:["webpack://./src/codebridge/styles/dropdown.module.scss"],names:[],mappings:"AAAA,sBACE,YAAA,CACA,oBAAA,CACA,4BAAA,CACA,kBAAA,CACA,WAAA,CACA,kBAAA,CACA,2CAAA,CAEA,4BACE,mDAAA,CAGF,wBACE,iCAAA,CACA,iBAAA,CACA,UAAA",sourcesContent:[".dropdownItem {\n  display: flex;\n  padding-block: 0.25rem;\n  padding-inline: 0.5rem 0.625rem;\n  align-items: center;\n  gap: 0.375rem;\n  align-self: stretch;\n  transition: background-color 0.2s ease-in-out;\n\n  &:hover {\n    background-color: var(--background-neutral-tertiary);\n  }\n\n  i {\n    color: var(--text-neutral-primary);\n    text-align: center;\n    width: 1rem;\n  }\n}\n"],sourceRoot:""}]),a.locals={dropdownItem:"SRwHGax2saTpkOW6vx71"};const s=a},5012:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".w50SAzm7PI8sC3Giy7ix{display:none}.WtJqpXnab8KOtUiNpztm{height:30px;background-color:var(--background-neutral-primary-inverse);color:var(--text-neutral-inverse);overflow-y:hidden;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.Bh4xVupPaKk0o4O3si7a{background-color:var(--background-neutral-primary-inverse);color:var(--text-neutral-white-fixed)}.Bh4xVupPaKk0o4O3si7a button span{color:var(--text-neutral-primary)}.f31XfAP_xkeHPJNAhV_J{height:30px;background-color:#7665a0;color:#fff;overflow-y:hidden;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.xAZuQT7dhqVzvMzgkSSW{background-color:#cfc9de;color:#4d575f}.xAZuQT7dhqVzvMzgkSSW button span{color:#4d575f}.mPRhwueMvvFeSmojyl_9{background-color:#0094ca;color:#d9eff7}.TXoozqDEcTSrcfV6Ke5p{color:#4d575f}.icTzlAYsC35csRpfL7zc{background-color:#3b3b3b;color:#fff}.V33k3Ni01_bB2eyDSCKk{padding-top:5px;padding-bottom:5px;font-size:14px}.ZljiNLc0on1YgtuzgE7V{color:#000;margin-bottom:10px;position:relative;cursor:pointer}","",{version:3,sources:["webpack://./src/common-styles.module.scss","webpack://./../shared/css/style-constants.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAKA,sBACE,YAAA,CAGF,sBACE,WCNyB,CDOzB,0DAAA,CACA,iCAAA,CACA,iBAAA,CACA,wBAAA,CACA,qBAAA,CACA,oBAAA,CACA,gBAAA,CAEA,sBACE,0DAAA,CACA,qCAAA,CAGE,kCACE,iCAAA,CASR,sBACE,WC/ByB,CDiCzB,wBAAA,CACA,UEnBM,CFoBN,iBAAA,CACA,wBAAA,CACA,qBAAA,CACA,oBAAA,CACA,gBAAA,CAEA,sBACE,wBEda,CFeb,aEnCY,CFsCV,kCACE,aEvCQ,CF6ChB,sBACE,wBEvBK,CFwBL,aErBc,CFwBhB,sBACE,aEnDc,CFsDhB,sBACE,wBAAA,CACA,UEjDM,CFoDR,sBACE,eAAA,CACA,kBAAA,CACA,cAAA,CAKF,sBACE,UE1EM,CF2EN,kBAAA,CACA,iBAAA,CACA,cAAA",sourcesContent:['// As we move from inline css to css modules we are temporarily duplicating commonStyles.js into this css module.\n// Any changes in one should be made in the other to apply to all components.\n@use "color.scss";\n@use "style-constants.scss";\n\n.hidden {\n  display: none;\n}\n\n.darkHeader {\n  height: style-constants.$workspace-headers-height;\n  background-color: var(--background-neutral-primary-inverse);\n  color: var(--text-neutral-inverse);\n  overflow-y: hidden;\n  -webkit-user-select: none;\n  -moz-user-select: none;\n  -ms-user-select: none;\n  user-select: none;\n\n  &Unfocused {\n    background-color: var(--background-neutral-primary-inverse);\n    color: var(--text-neutral-white-fixed);\n\n    button {\n      span {\n        color: var(--text-neutral-primary);\n      }\n    }\n  }\n}\n\n// TODO: [Phase 2] This now is legacy style that we use for Javalab. Remove .purpleHeader styles and it\'s usages\n//  once we move all the headers to updated styles.\n//  More info here: https://github.com/code-dot-org/code-dot-org/pull/50895\n.purpleHeader {\n  height: style-constants.$workspace-headers-height;\n  // THIS IS AN OLD PURPLE COLOR. DO NOT USE THIS COLOR FOR NEW STYLES. ONLY USE IT FOR JAVALAB HEADER.\n  background-color: #7665A0;\n  color: color.$white;\n  overflow-y: hidden;\n  -webkit-user-select: none;\n  -moz-user-select: none;\n  -ms-user-select: none;\n  user-select: none;\n\n  &Unfocused {\n    background-color: color.$lighter_purple;\n    color: color.$dark_charcoal;\n\n    button {\n      span {\n        color: color.$dark_charcoal;\n      }\n    }\n  }\n}\n\n.teacherBlueHeader {\n  background-color: color.$cyan;\n  color: color.$lightest_cyan;\n}\n\n.teacherHeaderUnfocused {\n  color: color.$dark_charcoal;\n}\n\n.minecraftHeader {\n  background-color: #3b3b3b;\n  color: color.$white;\n}\n\n.button {\n  padding-top: 5px;\n  padding-bottom: 5px;\n  font-size: 14px;\n}\n\n// Div contain instructions; either below visualization or in top instructions\n// May not need a common location once everything is in top instructions\n.bubble {\n  color: color.$black;\n  margin-bottom: 10px;\n  position: relative;\n  cursor: pointer;\n}\n',"// Common styles and measures accessible from all stylesheets\n\n// Height of workspace headers (above actual blockly/droplet space, beneath\n// site header)\n$workspace-headers-height: 30px;\n\n// Width of horizontal and vertical resize bars\n$resize-bar-width: 13px;\n\n// Opacity of elements that are dragged out to be deleted\n$delete-opacity: 0.5;\n\n// Width of pegasus content as of 2017 redesign\n$content-width: 970px;\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),a.locals={hidden:"w50SAzm7PI8sC3Giy7ix",darkHeader:"WtJqpXnab8KOtUiNpztm",darkHeaderUnfocused:"Bh4xVupPaKk0o4O3si7a",purpleHeader:"f31XfAP_xkeHPJNAhV_J",purpleHeaderUnfocused:"xAZuQT7dhqVzvMzgkSSW",teacherBlueHeader:"mPRhwueMvvFeSmojyl_9",teacherHeaderUnfocused:"TXoozqDEcTSrcfV6Ke5p",minecraftHeader:"icTzlAYsC35csRpfL7zc",button:"V33k3Ni01_bB2eyDSCKk",bubble:"ZljiNLc0on1YgtuzgE7V"};const s=a},5006:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".Vz8H_N5muHGjHUl__P_M{padding:5px 0;position:absolute;z-index:1000;background-color:#fff;border:1px solid #5b6770;border-radius:4px;display:flex;flex-direction:column}.yTNOun7hU5UUUvgGDmGA{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;padding:5px 12px;color:#4d575f;font-size:14px;display:block;background-color:#fff;text-decoration:none;line-height:20px;transition:background-color .2s ease-out;border:0;border-radius:0;margin:0;text-align:center;white-space:nowrap}.yTNOun7hU5UUUvgGDmGA:hover{background-color:#e7e8ea;cursor:pointer;box-shadow:none}","",{version:3,sources:["webpack://./src/javalab/components/javalab-dropdown.module.scss","webpack://./../shared/css/color.scss","webpack://./../frontend/packages/component-library-styles/font.scss"],names:[],mappings:"AAIA,sBAEE,aAAA,CACA,iBAAA,CAEA,YAAA,CACA,qBCSM,CDRN,wBAAA,CACA,iBAAA,CACA,YAAA,CACA,qBAAA,CAGF,sBE0BE,mCAAA,CACA,sCAAA,CACA,iBAAA,CFzBA,gBAAA,CACA,aCTc,CDUd,cAAA,CACA,aAAA,CACA,qBCLM,CDMN,oBAAA,CACA,gBAAA,CACA,wCAAA,CACA,QAAA,CACA,eAAA,CACA,QAAA,CACA,iBAAA,CACA,kBAAA,CAEA,4BACE,wBCnBY,CDoBZ,cAAA,CACA,eAAA",sourcesContent:["@import 'color';\n@import '@code-dot-org/component-library-styles/font';\n\n// The placeholder classes (%) allow these to be extended in other modules\n.dropdown,\n%dropdown {\n  padding: 5px 0;\n  position: absolute;\n  // without this, this will be below some content\n  z-index: 1000;\n  background-color: $white;\n  border: 1px solid $charcoal;\n  border-radius: 4px;\n  display: flex;\n  flex-direction: column;\n}\n\n.anchor,\n%anchor {\n  @include main-font-regular;\n  padding: 5px 12px;\n  color: $dark_charcoal;\n  font-size: 14px;\n  display: block;\n  background-color: $white;\n  text-decoration: none;\n  line-height: 20px;\n  transition: background-color 0.2s ease-out;\n  border: 0;\n  border-radius: 0;\n  margin: 0;\n  text-align: center;\n  white-space: nowrap;\n\n  &:hover {\n    background-color: $lightest_gray;\n    cursor: pointer;\n    box-shadow: none;\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1791385446/css/custom-icons.min.css';\n"],sourceRoot:""}]),a.locals={dropdown:"Vz8H_N5muHGjHUl__P_M",anchor:"yTNOun7hU5UUUvgGDmGA"};const s=a},7672:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,".nFb2HQa2CxDKbh4STcNX .qIiWIVFvRcK3Hvs2X0F_{background-color:rgba(0,0,0,.5);color:#292f36;position:absolute;width:100%;height:100%;display:flex;align-items:center;justify-content:center;top:0;left:0;z-index:80}.nFb2HQa2CxDKbh4STcNX{position:absolute;top:50px;bottom:0;left:0;right:0;display:flex;font-size:13px}.rieIRr0xPgf36X2v1qIK{pointer-events:none}.VKACUbkcKhZnlvpCoM4S{top:0;bottom:0}.nFb2HQa2CxDKbh4STcNX .L8dV_SdgdRZIUJvDDHMm{position:relative;flex:1;min-width:0;height:100%}.nFb2HQa2CxDKbh4STcNX .qIiWIVFvRcK3Hvs2X0F_{animation:iltXAMdRsqdrPvVC8Mry .5s}.nFb2HQa2CxDKbh4STcNX .qIiWIVFvRcK3Hvs2X0F_ .ckM698UxC6RLRksLRznc{display:flex;background-color:#f7f8fa;flex-direction:column;align-items:center;border-radius:5px;padding:20px;gap:20px}.nFb2HQa2CxDKbh4STcNX .qIiWIVFvRcK3Hvs2X0F_ .yfcNWyQbzovVnw3gFAaF{width:120px}.nFb2HQa2CxDKbh4STcNX .qIiWIVFvRcK3Hvs2X0F_ .BNhiKk03yTlY69ybAMsc{color:#727a83}.nFb2HQa2CxDKbh4STcNX ._NysjbuvhqdqO0xC6_wt{background-color:#fff;position:absolute;width:100%;height:100%;top:0;left:0;z-index:80}.nFb2HQa2CxDKbh4STcNX>.ql49Lq8VhepJepCSU7Ie{position:absolute;top:8px;pointer-events:none}.nFb2HQa2CxDKbh4STcNX>.ql49Lq8VhepJepCSU7Ie>*{pointer-events:auto}.nFb2HQa2CxDKbh4STcNX .hlnRS5h7mD863dEH2JX1{position:absolute;display:flex;justify-content:center;width:100%;z-index:80}","",{version:3,sources:["webpack://./src/lab2/views/common.scss","webpack://./../shared/css/color.scss","webpack://./src/lab2/views/Lab2Wrapper.module.scss"],names:[],mappings:"AAGA,4CACE,+BAAA,CACA,aCgLa,CD/Kb,iBAAA,CACA,UAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,KAAA,CACA,MAAA,CACA,UAAA,CERF,sBACE,iBAAA,CACA,QFSY,CERZ,QAAA,CACA,MAAA,CACA,OAAA,CACA,YAAA,CACA,cAAA,CAEA,sBACE,mBAAA,CAGF,sBACE,KAAA,CACA,QAAA,CAGF,4CACE,iBAAA,CACA,MAAA,CAGA,WAAA,CACA,WAAA,CAGF,4CAEE,kCAAA,CAEA,kEACE,YAAA,CACA,wBDmIU,CClIV,qBAAA,CACA,kBAAA,CACA,iBAAA,CACA,YAAA,CACA,QAAA,CAEA,kEACE,WAAA,CAGF,kEACE,aD+HS,CC1Hf,4CACE,qBDtCI,CCuCJ,iBAAA,CACA,UAAA,CACA,WAAA,CACA,KAAA,CACA,MAAA,CACA,UAAA,CAIF,4CACE,iBAAA,CACA,OAAA,CACA,mBAAA,CAEA,8CACE,mBAAA,CAIJ,4CACE,iBAAA,CACA,YAAA,CACA,sBAAA,CACA,UAAA,CACA,UAAA",sourcesContent:["@import 'color.scss';\n\n// A translucent overlay that covers the entire container.\n%full-container-overlay {\n  background-color: rgba(0 0 0 / 0.5);\n  color: $neutral_dark;\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  top: 0;\n  left: 0;\n  z-index: 80;\n}\n\n$top-spacing: 50px;\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","@import 'color.scss';\n@import './common.scss';\n\n// The lab and the TA drawer are laid out side by side: the lab gets whatever\n// the drawer is not using, so it can measure its own box rather than being\n// told how much of the window to leave alone.\n.labContainer {\n  position: absolute;\n  top: $top-spacing;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  display: flex;\n  font-size: 13px;\n\n  &Loading {\n    pointer-events: none;\n  }\n\n  &ShareView {\n    top: 0;\n    bottom: 0;\n  }\n\n  .labContent {\n    position: relative;\n    flex: 1;\n    // Without this a wide lab refuses to shrink below its content when the\n    // drawer opens, and pushes the drawer off the edge instead.\n    min-width: 0;\n    height: 100%;\n  }\n\n  .pageErrorContainer {\n    @extend %full-container-overlay;\n    animation: fadein 0.5s;\n\n    .pageError {\n      display: flex;\n      background-color: $neutral_light;\n      flex-direction: column;\n      align-items: center;\n      border-radius: 5px;\n      padding: 20px;\n      gap: 20px;\n\n      &Image {\n        width: 120px;\n      }\n\n      &Message {\n        color: $neutral_dark70;\n      }\n    }\n  }\n\n  .blockedProjectUIContainer {\n    background-color: $white;\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    top: 0;\n    left: 0;\n    z-index: 80;\n  }\n\n  // Position the toast container at the top of the lab container.\n  > .labToast {\n    position: absolute;\n    top: 8px;\n    pointer-events: none;\n\n    > * {\n      pointer-events: auto;\n    }\n  }\n\n  .blockedProjectUIContainerProjectValidator {\n    position: absolute;\n    display: flex;\n    justify-content: center;\n    width: 100%;\n    z-index: 80;\n  }\n}\n"],sourceRoot:""}]),a.locals={labContainer:"nFb2HQa2CxDKbh4STcNX",pageErrorContainer:"qIiWIVFvRcK3Hvs2X0F_",labContainerLoading:"rieIRr0xPgf36X2v1qIK",labContainerShareView:"VKACUbkcKhZnlvpCoM4S",labContent:"L8dV_SdgdRZIUJvDDHMm",fadein:"iltXAMdRsqdrPvVC8Mry",pageError:"ckM698UxC6RLRksLRznc",pageErrorImage:"yfcNWyQbzovVnw3gFAaF",pageErrorMessage:"BNhiKk03yTlY69ybAMsc",blockedProjectUIContainer:"_NysjbuvhqdqO0xC6_wt",labToast:"ql49Lq8VhepJepCSU7Ie",blockedProjectUIContainerProjectValidator:"hlnRS5h7mD863dEH2JX1"};const s=a},4432:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(12),o=n.n(r),i=n(13),a=n.n(i)()(o());a.push([e.id,"@keyframes CbCdU6ZHQC8EH30iJAMN{from{opacity:0}to{opacity:1}}.yBFjYHzxLa6ucbLY4CLA{display:flex;flex-direction:column;width:100%;height:100%;overflow:hidden}.yBFjYHzxLa6ucbLY4CLA .BEFYEezxNPzXRgoCzeAr{margin-top:auto}.Ln4HrX5ev50i6Bu9xy6G{display:flex;justify-content:center;align-items:center;width:100%;height:100%;back